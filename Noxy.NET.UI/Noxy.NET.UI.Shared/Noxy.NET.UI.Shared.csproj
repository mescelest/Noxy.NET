        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementColor.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementDate.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementDecimal.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementInteger.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementPassword.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementRadio.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementRadioSet.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementRange.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementSelect.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementText.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputElements\InputElementTextArea.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputGroups\InputGroupCheckbox.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputGroups\InputGroupCheckboxSet.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputGroups\InputGroupDate.razor"/>
        <UpToDateCheckInput Remove="Components\Forms\InputGroups\InputGroupDecimal.razor"/>
