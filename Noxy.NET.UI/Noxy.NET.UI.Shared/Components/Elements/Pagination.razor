@inherits BaseInput<int?>

<div @attributes="AdditionalAttributes" class="@CssClass">

    <Button class="first" disabled="@FirstDisabled" @onclick="FirstButtonClickHandler">
        @(First ?? DefaultFirst)
    </Button>

    <Button class="previous" disabled="@PreviousDisabled" @onclick="PreviousButtonClickHandler">
        @(Previous ?? DefaultPrevious)
    </Button>

    <input @key="_inputVersion" id="@IDCurrent" class="page" type="number" min="@(MinPageValue + 1)" max="@(MaxPageValue + 1)" list="@ListID" aria-label="@PageLabelCurrent"
           value="@(ValueCurrent + 1)" disabled="@DisabledCurrent" @onchange="PageInputChangeHandler"/>

    <datalist id="@ListID">
        @for (int number = MinPageValue + 1; number <= MaxPageValue + 1; number++)
        {
            <option value="@number"></option>
        }
    </datalist>

    <Button class="next" disabled="@NextDisabled" @onclick="NextButtonClickHandler">
        @(Next ?? DefaultNext)
    </Button>

    <Button class="last" disabled="@LastDisabled" @onclick="LastButtonClickHandler">
        @(Last ?? DefaultLast)
    </Button>

</div>

@code {

    [Parameter, EditorRequired]
    public int PageSize { get; set; }
    private int PageSizeCurrent => Math.Max(PageSize, MinPageSize);

    [Parameter, EditorRequired]
    public int Count { get; set; }
    private int CountCurrent => Math.Max(Count, MinCount);

    [Parameter]
    public RenderFragment? First { get; set; }

    [Parameter]
    public RenderFragment? Previous { get; set; }

    [Parameter]
    public RenderFragment? Next { get; set; }

    [Parameter]
    public RenderFragment? Last { get; set; }

    [Parameter]
    public bool? Disabled { get; set; }
    private bool DisabledCurrent => Disabled ?? false;

    // The name of the page box for assistive technology.
    [Parameter]
    public string? PageLabel { get; set; }
    private string PageLabelCurrent => PageLabel ?? "Page";

    private static readonly RenderFragment DefaultFirst = builder => builder.AddContent(0, "\u00AB");
    private static readonly RenderFragment DefaultPrevious = builder => builder.AddContent(0, "\u2039");
    private static readonly RenderFragment DefaultNext = builder => builder.AddContent(0, "\u203A");
    private static readonly RenderFragment DefaultLast = builder => builder.AddContent(0, "\u00BB");

    private const int MinCount = 0;
    private const int MinPageValue = 0;
    private const int MinPageSize = 1;

    private const string ListSuffix = "-pages";

    private string ListID => $"{IDCurrent}{ListSuffix}";
    private int _inputVersion;

    private int ValueCurrent => Value ?? MinPageValue;
    private int MaxPageValue => Math.Max(MinPageValue, (CountCurrent + PageSizeCurrent - 1) / PageSizeCurrent - 1);

    private bool FirstDisabled => DisabledCurrent || ValueCurrent == MinPageValue;
    private bool PreviousDisabled => DisabledCurrent || ValueCurrent == MinPageValue;
    private bool NextDisabled => DisabledCurrent || ValueCurrent == MaxPageValue;
    private bool LastDisabled => DisabledCurrent || ValueCurrent == MaxPageValue;

    private void Commit(int? value)
    {
        int page = ClampPage(value);
        NotifyChange(page);
    }

    private int ClampPage(int? value)
    {
        return Math.Clamp(value ?? MinPageValue, MinPageValue, MaxPageValue);
    }

    private void PageInputChangeHandler(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int page))
        {
            _inputVersion++;
            return;
        }

        int target = ClampPage(page - 1);

        // The browser keeps what was typed when it is out of range, and Blazor only redraws what changed, so a new key makes the box show the real page again.
        if (target != page - 1) _inputVersion++;

        Commit(target);
    }

    private void FirstButtonClickHandler()
    {
        Commit(MinPageValue);
    }

    private void PreviousButtonClickHandler()
    {
        Commit(ValueCurrent - 1);
    }

    private void NextButtonClickHandler()
    {
        Commit(ValueCurrent + 1);
    }

    private void LastButtonClickHandler()
    {
        Commit(MaxPageValue);
    }

}