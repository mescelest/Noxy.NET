@implements IAsyncDisposable
@inject IJSRuntime JS
@inherits BaseComponentElement

<Popover @ref="_popover" @attributes="AdditionalAttributes" ID="@IDCurrent" Open="_open" OpenChanged="OpenChangedHandler" OnOpened="OpenedHandler"
         Anchor="Anchor" Point="_point" Side="Side" Align="Align" class="@CssClass">
    <div class="root" @onkeydown="KeyDownHandler" @onkeydown:preventDefault>
        @RenderMenu(RootDepth)
    </div>
</Popover>

@code {
    [Parameter]
    public List<ContextMenuItem> ItemList { get; set; } = [];

    [Parameter]
    public ElementReference? Anchor { get; set; }

    [Parameter]
    public PlacementSideEnum Side { get; set; } = PlacementSideEnum.Bottom;

    [Parameter]
    public PlacementAlignEnum Align { get; set; } = PlacementAlignEnum.Start;

    [Parameter]
    public string? ID { get; set; }

    // Raised when the menu has closed, however it came about, so the owner can reset what it changed while the menu was open.
    [Parameter]
    public EventCallback OnClose { get; set; }

    private const string IDPrefix = "context-menu-";
    private const string FunctionIsDrillIn = "IsDrillIn";
    private const string FunctionFocusItem = "FocusItem";
    private const string FunctionFocusTrigger = "FocusTrigger";

    private const string KeyArrowDown = "ArrowDown";
    private const string KeyArrowUp = "ArrowUp";
    private const string KeyArrowLeft = "ArrowLeft";
    private const string KeyArrowRight = "ArrowRight";
    private const string KeyHome = "Home";
    private const string KeyEnd = "End";
    private const string KeyEnter = "Enter";
    private const string KeySpace = " ";
    private const string KeyEscape = "Escape";
    private const string KeyTab = "Tab";

    private readonly string _generatedID = IDPrefix + Guid.NewGuid().ToString("N");

    // Blazor captures a reference once, when its element is created, and the elements stay from one open to the next: the maps are never emptied, or a sub-menu opened later would have nothing to sit next to.
    private readonly Dictionary<int, ElementReference> _menuRefMap = [];
    private readonly Dictionary<(int Depth, int Index), ElementReference> _itemRefMap = [];

    private Popover? _popover;
    private IJSObjectReference? _module;
    private ContextMenuNavigator? _navigator;
    private List<ContextMenuItem>? _navigatorSource;
    private PopoverPoint? _point;
    private bool _drillIn;
    private bool _open;
    private bool _focusPending;
    private bool _replacePending;
    private bool _disposed;

    // The item that was activated once and waits for its second activation: only an item with a ConfirmText can be armed.
    private (int Depth, int Index)? _armed;

    private string IDCurrent => ID ?? _generatedID;

    // Built when first needed from the items as they are then, and rebuilt in place while the owner changes them.
    private ContextMenuNavigator Navigator
    {
        get
        {
            if (_navigator is null)
            {
                _navigator = new(ItemList, _drillIn);
                _navigatorSource = ItemList;
            }

            return _navigator;
        }
    }

    // With drill-in the one list on screen is the deepest open level; in a fly-out the first level is always on screen.
    private int RootDepth => _drillIn ? Navigator.OpenPath.Count : 0;
    private int ActiveDepth => Navigator.OpenPath.Count;

    protected override async Task OnAfterFirstRenderAsync()
    {
        await base.OnAfterFirstRenderAsync();

        if (_disposed) return;

        IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(ContextMenu)));
        if (_disposed)
        {
            await DisposeModuleAsync(module);
            return;
        }

        _module = module;
        _drillIn = await _module.InvokeAsync<bool>(FunctionIsDrillIn);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_replacePending && _popover is not null && !_disposed)
        {
            _replacePending = false;
            await _popover.ReplaceAsync();
        }

        if (!_focusPending || _module is null || !_open || _disposed) return;

        _focusPending = false;
        ElementReference? menu = _menuRefMap.TryGetValue(ActiveDepth, out ElementReference element) ? element : null;
        await _module.InvokeVoidAsync(FunctionFocusItem, menu, Navigator.FocusIndex);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (_navigator is null || ReferenceEquals(_navigatorSource, ItemList)) return;

        _navigator.Replace(ItemList);
        _navigatorSource = ItemList;
    }

    public Task OpenAtAsync(MouseEventArgs args)
    {
        return OpenAtAsync(args.ClientX, args.ClientY);
    }

    public Task OpenAtAsync(double x, double y)
    {
        _point = new(x, y);

        // Already open: the browser raises no event for that, so the menu starts over from the first level, and is placed at the new point once it has rendered.
        if (_open)
        {
            _armed = null;
            _navigator = null;
            _navigatorSource = null;
            _replacePending = true;
            _focusPending = true;
        }

        _open = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async Task CloseAsync()
    {
        if (_popover is null) return;

        await _popover.HideAsync();
    }

    private Task OpenChangedHandler(bool open)
    {
        _open = open;
        return open ? Task.CompletedTask : ClosedAsync();
    }

    private void OpenedHandler()
    {
        _focusPending = true;
    }

    private async Task ClosedAsync()
    {
        ElementReference? trigger = Anchor;
        _armed = null;
        _navigator = null;
        _navigatorSource = null;
        _point = null;

        if (_module is not null && !_disposed)
        {
            // The window may have been resized since, which is what closed it, so the next open reads the layout again.
            _drillIn = await _module.InvokeAsync<bool>(FunctionIsDrillIn);
            if (trigger is { } element)
            {
                await _module.InvokeVoidAsync(FunctionFocusTrigger, element);
            }
        }

        await OnClose.InvokeAsync();
    }

    private void RequestFocus()
    {
        _focusPending = true;
    }

    private List<ContextMenuItem> ListAt(int depth)
    {
        return Navigator.LevelList[depth];
    }

    private async Task ChooseAsync(ContextMenuItem item, int depth, int index)
    {
        // The first activation of an item that asks twice only arms it, and the menu stays open; the second one does it.
        if (item.ConfirmText is not null && _armed != (depth, index))
        {
            _armed = (depth, index);
            return;
        }

        _armed = null;
        if (item.ClosesMenu)
        {
            await CloseAsync();
        }

        if (item.Run is { } run)
        {
            await run();
        }
    }

    private async Task ClickItemHandler(int depth, int index)
    {
        ContextMenuItem item = ListAt(depth)[index];
        if (!item.IsEnabled) return;

        if (item.Kind == ContextMenuItemKindEnum.Submenu)
        {
            Navigator.FocusAt(depth, index);
            Navigator.OpenSubmenu();
            RequestFocus();
            return;
        }

        await ChooseAsync(item, depth, index);
    }

    // The mouse over an item focuses it and closes what was open below it; over a sub-menu item it opens that too, unless the
    // sub-menu would replace the list, which only a click should do.
    private void HoverItemHandler(int depth, int index)
    {
        ContextMenuItem item = ListAt(depth)[index];
        if (!item.IsEnabled) return;

        if (_armed != (depth, index)) _armed = null;
        Navigator.FocusAt(depth, index);
        if (item.Kind == ContextMenuItemKindEnum.Submenu && !_drillIn)
        {
            Navigator.OpenSubmenu();
        }

        RequestFocus();
    }

    private void ClickBackHandler()
    {
        Navigator.Close();
        RequestFocus();
    }

    private Task SubmenuClosedHandler(int depth)
    {
        Navigator.CloseTo(depth);
        return Task.CompletedTask;
    }

    private async Task KeyDownHandler(KeyboardEventArgs args)
    {
        if (args.Key is not (KeyEnter or KeySpace))
        {
            _armed = null;
        }

        switch (args.Key)
        {
            case KeyArrowDown:
                Navigator.MoveNext();
                break;
            case KeyArrowUp:
                Navigator.MovePrevious();
                break;
            case KeyHome:
                Navigator.MoveFirst();
                break;
            case KeyEnd:
                Navigator.MoveLast();
                break;
            case KeyArrowRight:
                Navigator.OpenSubmenu();
                break;
            case KeyArrowLeft:
                Navigator.Close();
                break;
            case KeyEscape:
                if (!Navigator.Close())
                {
                    await CloseAsync();
                    return;
                }

                break;
            case KeyTab:
                await CloseAsync();
                return;
            case KeyEnter:
            case KeySpace:
                await ActivateFocusedAsync();
                break;
            default:
                if (IsLetter(args))
                {
                    Navigator.MoveToLetter(args.Key[0]);
                }

                break;
        }

        RequestFocus();
    }

    private async Task ActivateFocusedAsync()
    {
        if (Navigator.FocusIndex is not { } index) return;

        if (ListAt(ActiveDepth)[index].Kind == ContextMenuItemKindEnum.Submenu)
        {
            Navigator.OpenSubmenu();
            return;
        }

        if (Navigator.Choose() is { } item)
        {
            await ChooseAsync(item, ActiveDepth, index);
        }
    }

    private static bool IsLetter(KeyboardEventArgs args)
    {
        return args.Key.Length == 1 && char.IsLetterOrDigit(args.Key[0]) && !args.CtrlKey && !args.AltKey && !args.MetaKey;
    }

    private bool IsArmed(int depth, int index)
    {
        return _armed == (depth, index);
    }

    private void LeaveItemHandler(int depth, int index)
    {
        if (_armed == (depth, index)) _armed = null;
    }

    private bool IsOpenSubmenu(int depth, int index)
    {
        return !_drillIn && Navigator.OpenPath.Count > depth && Navigator.OpenPath[depth] == index;
    }

    private string SubmenuID(int depth)
    {
        return $"{IDCurrent}-{depth + 1}";
    }

    private static string? AriaDisabled(ContextMenuItem item)
    {
        return item.IsEnabled ? null : AriaValue(true);
    }

    private static string? DisabledTitle(ContextMenuItem item)
    {
        return item.IsEnabled ? null : item.DisabledReason;
    }

    private static string AriaValue(bool value)
    {
        return value.ToString().ToLowerInvariant();
    }

    private ElementReference ItemAnchor(int depth, int index)
    {
        return _itemRefMap.TryGetValue((depth, index), out ElementReference element) ? element : default;
    }

    private RenderFragment RenderMenu(int depth) => @<div class="menu" role="menu" tabindex="-1" data-depth="@depth" @ref="_menuRefMap[depth]">
                                                        @if (_drillIn && Navigator.CanGoBack)
                                                        {
                                                            <button type="button" class="item back" role="menuitem" @onclick="ClickBackHandler">Back</button>
                                                        }

                                                        @foreach ((int index, ContextMenuItem item) in ListAt(depth).Index())
                                                        {
                                                            @RenderItem(depth, index, item)
                                                        }
                                                    </div>;

    private RenderFragment RenderItem(int depth, int index, ContextMenuItem item) => @<text>
                                                                                          @if (item.Kind == ContextMenuItemKindEnum.Separator)
                                                                                          {
                                                                                              <div class="separator" role="separator" data-index="@index"></div>
                                                                                          }
                                                                                          else if (item.Kind == ContextMenuItemKindEnum.Submenu)
                                                                                          {
                                                                                              <button type="button" class="item" role="menuitem" data-index="@index" aria-haspopup="menu" aria-expanded="@AriaValue(IsOpenSubmenu(depth, index))"
                                                                                                      aria-disabled="@AriaDisabled(item)" title="@DisabledTitle(item)"
                                                                                                      @ref="_itemRefMap[(depth, index)]" @onclick="() => ClickItemHandler(depth, index)" @onmouseenter="() => HoverItemHandler(depth, index)"
                                                                                                      @onmouseleave="() => LeaveItemHandler(depth, index)">
                                                                                                  @RenderContent(depth, index, item)
                                                                                              </button>

                                                                                              @if (IsOpenSubmenu(depth, index))
                                                                                              {
                                                                                                  <Popover ID="@SubmenuID(depth)" Open="true" OpenChanged="() => SubmenuClosedHandler(depth)" Anchor="ItemAnchor(depth, index)" Side="PlacementSideEnum.Right"
                                                                                                           Align="PlacementAlignEnum.Start" class="submenu">
                                                                                                      @RenderMenu(depth + 1)
                                                                                                  </Popover>
                                                                                              }
                                                                                          }
                                                                                          else
                                                                                          {
                                                                                              <button type="button" class="item" role="menuitem" data-index="@index" data-destructive="@item.IsDestructive" data-armed="@IsArmed(depth, index)"
                                                                                                      aria-disabled="@AriaDisabled(item)"
                                                                                                      title="@DisabledTitle(item)"
                                                                                                      @onclick="() => ClickItemHandler(depth, index)" @onmouseenter="() => HoverItemHandler(depth, index)" @onmouseleave="() => LeaveItemHandler(depth, index)">
                                                                                                  @RenderContent(depth, index, item)
                                                                                              </button>
                                                                                          }
                                                                                      </text>;

    private const string IconArmed = "check";

    // An item that waits for its second activation shows a check mark in place of its own icon.
    private string? IconOf(int depth, int index, ContextMenuItem item)
    {
        return item.ConfirmText is not null && IsArmed(depth, index) ? IconArmed : item.Icon;
    }

    private RenderFragment RenderContent(int depth, int index, ContextMenuItem item) => @<text>
                                                                                             @if (IconOf(depth, index, item) is { } icon)
                                                                                             {
                                                                                                 <MaterialIcon Icon="@icon" Size="var(--size-icon-md)"/>
                                                                                             }

                                                                                             @if (item.ConfirmText is null)
                                                                                             {
                                                                                                 <span>@item.Text</span>
                                                                                             }
                                                                                             else
                                                                                             {
                                                                                                 <span class="faces">
                                                                               <span class="face" data-active="@(!IsArmed(depth, index))">@item.Text</span>
                                                                               <span class="face" data-active="@IsArmed(depth, index)">@item.ConfirmText</span>
                                                                           </span>
                                                                                             }
                                                                   </text>;

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;
        if (_module is not null)
        {
            await DisposeModuleAsync(_module);
        }
    }

    private static async Task DisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

}
