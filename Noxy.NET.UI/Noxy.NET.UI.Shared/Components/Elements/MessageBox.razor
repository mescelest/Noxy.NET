@inherits BaseComponentElement

@if (MessageListCurrent.Any())
{
    <div @attributes="AdditionalAttributes" class="@CssClass" role="@RoleString" data-status="@StatusString">
        @foreach (string message in MessageListCurrent)
        {
            <div class="message">@message</div>
        }
    </div>
}

@code {

    [Parameter]
    public IEnumerable<string>? MessageList { get; set; }
    private IEnumerable<string> MessageListCurrent => MessageList ?? [];

    [Parameter]
    public StatusEnum? Status { get; set; }
    private StatusEnum StatusCurrent => Status ?? StatusEnum.None;
    private string StatusString => StatusCurrent.ToText();

    private const string RoleAlert = "alert";
    private const string RoleStatus = "status";

    private string RoleString => StatusCurrent == StatusEnum.Error ? RoleAlert : RoleStatus;

}
