@implements IAsyncDisposable
@inject IJSRuntime JS
@inherits BaseComponentElement

<dialog @ref="_element" @attributes="AdditionalAttributes" class="@CssClass" data-size="@SizeString">
    @if (!IsRequiredCurrent)
    {
        <Button Type="@HTMLButtonTypeEnum.Button" class="close" data-dialog-close IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" aria-label="@CloseLabelCurrent" @onclick="CloseHandler">
            @if (CloseContentCurrent is null)
            {
                <span aria-hidden="true">&times;</span>
            }
            else
            {
                @CloseContentCurrent
            }
        </Button>
    }
    <div class="content" data-height="@HeightString">
        @ChildContent
    </div>
</dialog>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    // How much room the dialog may take: the default is up to a column and a half, medium is always a column and a half (never wider than the window) so a long line is cut with an ellipsis, wide is for forms and lists, and full is for a document, the whole window with the content scrolling inside it.
    [Parameter]
    public DialogSizeEnum? Size { get; set; }
    private DialogSizeEnum SizeCurrent => Size ?? DialogSizeEnum.Default;
    private string SizeString => SizeCurrent.ToText();

    // Auto: as tall as what is in it. Fixed: the same height whatever is in it, for a dialog that holds a list that is searched, so it does not move while the list gets shorter and longer; never taller than the window leaves room for, and what is in it has to scroll inside. The height is --size-dialog-fixed-height.
    [Parameter]
    public DialogHeightEnum? Height { get; set; }
    private DialogHeightEnum HeightCurrent => Height ?? DialogHeightEnum.Auto;
    private string HeightString => HeightCurrent.ToText();


    private const string FunctionShow = "Show";
    private const string FunctionClose = "Close";
    private const string FunctionWatch = "Watch";
    private const string FunctionSetBackdropClose = "SetBackdropClose";

    // A required dialog asks for something the user has to give: it has no close button and a click on the backdrop does nothing, so it closes only through its own buttons (or Escape). Otherwise it can be dismissed: a close button sits in the corner and a click on the backdrop closes it.
    [Parameter]
    public bool? IsRequired { get; set; }
    private bool IsRequiredCurrent => IsRequired ?? false;

    // The name an app gives a cascading RenderFragment to set what every close button holds, once, at its root.
    public const string CloseContentName = "DialogCloseContent";

    // What this dialog's close button holds. Before the app's own (the cascading one), and a plain cross when neither is given.
    [Parameter]
    public RenderFragment? CloseContent { get; set; }

    [CascadingParameter(Name = CloseContentName)]
    public RenderFragment? CloseContentApp { get; set; }
    private RenderFragment? CloseContentCurrent => CloseContent ?? CloseContentApp;

    // What the close button is called for a screen reader.
    [Parameter]
    public string? CloseLabel { get; set; }
    private string CloseLabelCurrent => CloseLabel ?? "Close";

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Dialog>? _reference;
    private bool _shown;
    private bool _disposed;

    protected override async Task OnAfterFirstRenderAsync()
    {
        await base.OnAfterFirstRenderAsync();

        if (_disposed) return;

        IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(Dialog)));

        // The component can be disposed while the module loads: then nobody else releases it.
        if (_disposed)
        {
            await DisposeModuleAsync(module);
            return;
        }

        _module = module;
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync(FunctionWatch, _element, _reference, nameof(Closed));

        await SyncBackdropCloseAsync();
        await SyncOpenStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await SyncBackdropCloseAsync();
        await SyncOpenStateAsync();
    }

    private async Task SyncBackdropCloseAsync()
    {
        if (_disposed || _module is null) return;

        await _module.InvokeVoidAsync(FunctionSetBackdropClose, _element, !IsRequiredCurrent);
    }

    // The same way out as Escape: the element closes, and its close event reports it to the owner.
    private async Task CloseHandler()
    {
        if (_disposed) return;

        if (_module is null)
        {
            await OpenChanged.InvokeAsync(false);
            return;
        }

        await _module.InvokeVoidAsync(FunctionClose, _element);
    }

    private async Task SyncOpenStateAsync()
    {
        if (_disposed || _module is null || Open == _shown) return;

        // Set before the call so a close event raised by it is not taken for the user closing the dialog.
        _shown = Open;
        try
        {
            await _module.InvokeVoidAsync(Open ? FunctionShow : FunctionClose, _element);
        }
        catch (JSException)
        {
            _shown = !Open;
            throw;
        }
    }

    [JSInvokable]
    public async Task Closed()
    {
        if (_disposed || !_shown) return;

        _shown = false;
        await OpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;
        if (_module is not null)
        {
            await DisposeModuleAsync(_module);
        }

        _reference?.Dispose();
    }

    private static async Task DisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

}
