@inherits BaseComponentElement

<button @attributes="AdditionalAttributes" class="@CssClass" type="@TypeString" disabled="@Disabled" data-loading="@LoadingCurrent" data-status="@StatusString" data-appearance="@AppearanceString" data-is-icon="@IsIcon">
    <Loader Size="LoaderSizeCurrent" Loading="LoadingCurrent">
        @ChildContent
    </Loader>
</button>

@code {

    [Parameter]
    public StatusEnum? Status { get; set; }
    private StatusEnum StatusCurrent => Status ?? StatusEnum.Default;
    private string StatusString => StatusCurrent.ToText();

    [Parameter]
    public ButtonAppearanceEnum? Appearance { get; set; }
    private ButtonAppearanceEnum AppearanceCurrent => Appearance ?? ButtonAppearanceEnum.Filled;
    private string AppearanceString => AppearanceCurrent.ToText();

    [Parameter]
    public HTMLButtonTypeEnum? Type { get; set; }
    private HTMLButtonTypeEnum TypeCurrent => Type ?? HTMLButtonTypeEnum.Button;
    private string TypeString => TypeCurrent.ToText();

    [Parameter]
    public bool? Loading { get; set; }
    private bool LoadingCurrent => Loading ?? false;

    [Parameter]
    public int? LoaderSize { get; set; }
    private int LoaderSizeCurrent => LoaderSize ?? 24;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool? IsIcon { get; set; }

    private bool? Disabled => TryExtractAttribute("disabled", out bool result) ? result : LoadingCurrent;

    public override string CssClass => ComponentMetadata.CombineCssClass(base.CssClass);

} 
