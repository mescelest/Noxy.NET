@inherits BaseComponentElement

@if (LoadingCurrent)
{
    <div @attributes="AdditionalAttributes" class="@CssClass" role="status" style="--loader-duration: @DurationString">
        <span class="visually-hidden">@LabelCurrent</span>
        <svg class="spinner" width="@SizeCurrent" height="@SizeCurrent" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g fill="none" fill-rule="evenodd" stroke-width="10">
                <circle stroke-opacity=".5" cx="50" cy="50" r="45"/>
                <path class="spinner-arc" d="M50,5 A45,45 270 0 1 95,50"/>
            </g>
        </svg>
    </div>

    @if (RenderWhileLoadingCurrent)
    {
        <div class="loading-content">
            @ChildContent
        </div>
    }
}
else
{
    @ChildContent
}

@code {

    [Parameter]
    public string? Label { get; set; }
    private string LabelCurrent => Label ?? "Loading";

    [Parameter]
    public int? Size { get; set; }
    private int SizeCurrent => Size ?? 100;

    [Parameter]
    public int? Duration { get; set; }
    private int DurationCurrent => Math.Max(Duration ?? 1000, 100);
    private string DurationString => $"{DurationCurrent}ms";

    [Parameter]
    public bool? Loading { get; set; }
    private bool LoadingCurrent => Loading ?? false;

    [Parameter]
    public bool? RenderWhileLoading { get; set; }
    private bool RenderWhileLoadingCurrent => RenderWhileLoading ?? false;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}