@inherits BaseInputGroup<string>

<div @attributes="AdditionalAttributes" class="@CssClass">
    <TemplateInputGroup For="@IDCurrent" DisplayName="@DisplayNameCurrent" Description="@DescriptionCurrent" ErrorList="ErrorList">
        <InputElementPassword @attributes="InputAttributes" ID="@IDCurrent" Name="@GetName()" Autocomplete="@Autocomplete" Size="Size"
                              Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression"/>
    </TemplateInputGroup>
</div>

@code {

    [Parameter]
    public WebFormInputElementPasswordAutocompleteEnum? Autocomplete { get; set; }

    [Parameter]
    public int? Size { get; set; }

}

