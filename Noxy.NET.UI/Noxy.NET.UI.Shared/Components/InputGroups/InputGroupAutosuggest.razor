@typeparam TOption
@inherits BaseInputGroup<TOption>

<div @attributes="AdditionalAttributes" class="@CssClass">
    <TemplateInputGroup For="@IDCurrent" DisplayName="@DisplayNameCurrent" Description="@DescriptionCurrent" ErrorList="@ErrorList">
        <InputElementAutosuggest @attributes="InputAttributes" TOption="TOption" OptionSet="OptionList" ID="@IDCurrent" Name="@GetName()" Loading="Loading" Size="Size" DebounceDelay="DebounceDelay"
                                 NoResultText="@NoResultText" MinLengthText="@MinLengthText"
                                 DisplaySelector="DisplaySelector" OnSearch="OnSearch" Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression"/>
    </TemplateInputGroup>
</div>

@code {

    [Parameter, EditorRequired]
    public required HashSet<TOption> OptionList { get; set; }

    [Parameter]
    public int? Size { get; set; }

    [Parameter]
    public int? DebounceDelay { get; set; }

    [Parameter]
    public bool? Loading { get; set; }

    [Parameter]
    public string? NoResultText { get; set; }

    [Parameter]
    public string? MinLengthText { get; set; }

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public Func<TOption?, string>? DisplaySelector { get; set; }

}
