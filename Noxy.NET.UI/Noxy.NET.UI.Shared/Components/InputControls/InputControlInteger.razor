@inherits BaseInput<int?>
@implements IBaseInputTextual

<TemplateInputControlTextual>
    <InputElementInteger @attributes="@AdditionalAttributes" class="@CssClass" ID="@IDCurrent" Name="@GetName()" Size="Size" Min="Min" Max="Max" OnInputDelay="OnInputDelay" Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression"/>
</TemplateInputControlTextual>


@code {

    [Parameter]
    public int? Size { get; set; }

    [Parameter]
    public int? OnInputDelay { get; set; }

    // The lowest and the highest number the field gives; a number outside them becomes the nearest one.
    [Parameter]
    public int? Min { get; set; }

    [Parameter]
    public int? Max { get; set; }

}

