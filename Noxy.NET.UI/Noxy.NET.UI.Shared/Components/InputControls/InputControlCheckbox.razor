@typeparam TOption
@inherits BaseInput<TOption?>

<label class="@CssClass" for="@IDCurrent" data-disabled="@Disabled">
    @if (Visual != null)
    {
        @Visual(Checked)
    }
    else
    {
        <div class="visual" data-checked="@Checked" data-mixed="@IsMixed">
            <span class="tick"></span>
        </div>
    }

    <InputElementCheckbox TOption="TOption" @attributes="@AdditionalAttributes" ID="@IDCurrent" Name="@GetName()" Option="Option" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" disabled="@DisabledCurrent"/>

    @if (ChildContent != null)
    {
        @ChildContent(Checked)
    }
</label>

@code {

    [Parameter, EditorRequired]
    public TOption Option { get; set; }

    [Parameter]
    public RenderFragment<bool?>? ChildContent { get; set; }

    [Parameter]
    public RenderFragment<bool?>? Visual { get; set; }

    // Shows the box as neither ticked nor empty (a dash), for a choice that holds for some of what it stands for and not for the rest. The value is still the caller's: it says what a press does.
    [Parameter]
    public bool IsMixed { get; set; }
// Shows the box as neither ticked nor empty (a dash), for a choice that holds for some of what it stands for and not for the rest. The value is still the caller's: it says what a press does.    [Parameter]    public bool IsMixed { get; set; }

    [Parameter]
    public bool? Disabled { get; set; }
    private bool DisabledCurrent => Disabled ?? false;

    private bool Checked => EqualityComparer<TOption>.Default.Equals(Value, Option);

}
