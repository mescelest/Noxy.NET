@inherits BaseInput<double?>
@implements INotifyInputChanged

<input @attributes="AdditionalAttributes" class="@CssClass" id="@IDCurrent" name="@GetName()" type="range" min="@MinText" max="@MaxText" step="@StepText" value="@ValueText"
       aria-valuemin="@MinText" aria-valuemax="@MaxText" aria-valuenow="@ValueText" @oninput="OnInputChange"/>

@code {

    [Parameter, EditorRequired]
    public double Min { get; set; }

    [Parameter, EditorRequired]
    public double Max { get; set; }

    [Parameter]
    public double? Step { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    // The browser only reads a number with a dot, so these are never written with the culture of the machine (a decimal comma makes the max, step and value invalid).
    private string MinText => Min.ToString(CultureInfo.InvariantCulture);

    private string MaxText => Max.ToString(CultureInfo.InvariantCulture);

    private string? StepText => Step?.ToString(CultureInfo.InvariantCulture);

    private string? ValueText => Value?.ToString(CultureInfo.InvariantCulture);

    private void OnInputChange(ChangeEventArgs args)
    {
        OnChange.InvokeAsync(args);
        NotifyChange(GetEventValue(args));
    }

    private static double? GetEventValue(ChangeEventArgs args)
    {
        return double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? value : null;
    }

}