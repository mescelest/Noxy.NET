@inherits BaseInputTextual<int?>

<input @attributes="AdditionalAttributes" class="@CssClass" ID="@IDCurrent" Name="@GetName()" type="tel" size="@SizeCurrent" value="@ValueInternal" inputmode="numeric" @onchange="OnValueChange" @oninput="OnValueInput"/>

@code {

    // The lowest and the highest number the field gives. A number outside them is brought to the nearest one, and the field shows that number.
    [Parameter]
    public int? Min { get; set; }

    [Parameter]
    public int? Max { get; set; }

    protected override int? GetParsedValue(string value)
    {
        if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out int parsed)) return null;

        return Math.Clamp(parsed, Min ?? int.MinValue, Max ?? int.MaxValue);
    }

    protected override void HandleChange(string value)
    {
        int? parsed = GetParsedValue(value);
        ValueInternal = parsed is null ? value : parsed.Value.ToString(CultureInfo.InvariantCulture);
        NotifyChange(parsed);
    }

}
