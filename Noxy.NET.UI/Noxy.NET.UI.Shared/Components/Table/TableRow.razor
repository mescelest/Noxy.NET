@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass" role="row" aria-rowindex="@AriaRowIndex" data-striped="@IsStriped">
    <CascadingValue Value="TableCellKindEnum.Cell" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The position in the list, from zero: it sets the row number the table reports and which rows are striped.
    [Parameter, EditorRequired]
    public int Index { get; set; }

    private int AriaRowIndex => Index + 2;
    private bool IsStriped => Index % 2 == 0;

}
