@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass" role="rowgroup">
    <Loader class="loading" Loading="Loading">
        @ChildContent
    </Loader>
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Loading { get; set; }

}
