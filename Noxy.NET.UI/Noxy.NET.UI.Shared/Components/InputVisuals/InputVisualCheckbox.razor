@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass" data-checked="@CheckedCurrent">
    @if (CheckedCurrent)
    {
        <span>✔</span>
    }
</div>

@code {

    [Parameter]
    public bool? Checked { get; set; }
    private bool CheckedCurrent => Checked ?? false;

}  