@implements IDisposable
@inherits BaseComponentElement

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div @attributes="AdditionalAttributes" class="@CssClass">
    <div role="tablist" aria-label="@Label" class="tab-list" @onkeydown="HandleKeyDown">
        @foreach (TabPage item in _pages)
        {
            bool isSelected = item == _activePage;
            string isSelectedAria = isSelected ? "true" : "false";
            string tabID = $"tab-{item.ID}";
            string panelID = $"panel-{item.ID}";
            int tabIndex = isSelected ? 0 : -1;

            <div @ref="_tabReferences[item]" class="tab" data-selected="@isSelected">
                <button type="button" class="tab-button" id="@tabID" tabindex="@tabIndex"
                        role="tab" aria-selected="@isSelectedAria" aria-controls="@panelID" @onclick="() => ActivatePage(item)">
                    @item.Title
                </button>
                @if (!string.IsNullOrWhiteSpace(item.Link))
                {
                    <a href="@item.Link" target="_blank" class="tab-link" aria-label="@item.LinkLabelCurrent">
                        @if (item.LinkContent != null)
                        {
                            @item.LinkContent
                        }
                        else
                        {
                            <span aria-hidden="true">⇾</span>
                        }
                    </a>
                }
            </div>
        }
    </div>

    @foreach (TabPage item in _pages)
    {
        bool isSelected = item == _activePage;
        string tabID = $"tab-{item.ID}";
        string panelID = $"panel-{item.ID}";

        <div class="tab-panel" id="@panelID" role="tabpanel" hidden="@IsHidden(item)" aria-labelledby="@tabID">
            @if (isSelected)
            {
                @item.ChildContent
            }
        </div>
    }
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment<bool>? Arrow { get; set; }

    // The name of the tab list for assistive technology.
    [Parameter]
    public string? Label { get; set; }

    private const string KeyNext = "ArrowRight";
    private const string KeyPrevious = "ArrowLeft";
    private const string KeyFirst = "Home";
    private const string KeyLast = "End";

    private readonly List<TabPage> _pages = [];
    private TabPage? _activePage;

    private bool IsHidden(TabPage page) => page != _activePage;

    private readonly Dictionary<TabPage, ElementReference> _tabReferences = new();

    public void AddPage(TabPage page)
    {
        _pages.Add(page);
        if (_pages.Count == 1)
        {
            _activePage = page;
        }

        StateHasChanged();
    }

    public void RemovePage(TabPage page)
    {
        int index = _pages.IndexOf(page);
        if (index < 0) return;

        _pages.RemoveAt(index);
        _tabReferences.Remove(page);
        if (_activePage == page)
        {
            _activePage = _pages.Count > 0 ? _pages[Math.Min(index, _pages.Count - 1)] : null;
        }

        InvokeAsync(StateHasChanged);
    }

    private void ActivatePage(TabPage page)
    {
        _activePage = page;
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_activePage == null || _pages.Count <= 1) return;

        int currentIndex = _pages.IndexOf(_activePage);
        int nextIndex;

        switch (e.Key)
        {
            case KeyNext:
                nextIndex = (currentIndex + 1) % _pages.Count;
                break;
            case KeyPrevious:
                nextIndex = (currentIndex - 1 + _pages.Count) % _pages.Count;
                break;
            case KeyFirst:
                nextIndex = 0;
                break;
            case KeyLast:
                nextIndex = _pages.Count - 1;
                break;
            default:
                return;
        }

        TabPage nextPages = _pages[nextIndex];
        ActivatePage(nextPages);

        // WCAG Focus Management: Shift physical keyboard focus to the new tab
        if (_tabReferences.TryGetValue(nextPages, out ElementReference elementRef))
        {
            await elementRef.FocusAsync();
        }
    }

    public void Dispose()
    {
        _pages.Clear();
        _tabReferences.Clear();
    }

}