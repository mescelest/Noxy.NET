@typeparam T where T : class
@inherits BaseComponentElement
@implements IDisposable

<form @attributes="AdditionalAttributes" class="@CssClass" @onsubmit="SubmitHandler" @onsubmit:preventDefault>

    <MessageBox MessageList="Context.GetFormErrorList()" Status="@StatusEnum.Error"/>

    <CascadingValue @key="Context" Value="@Context" IsFixed="true">
        @ChildContent
    </CascadingValue>

</form>

@code {

    [Parameter, EditorRequired]
    public required WebFormContext<T> Context { get; set; }

    [Parameter]
    public bool? ResetAfterSubmit { get; set; }
    private bool ResetAfterSubmitCurrent => ResetAfterSubmit ?? false;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<WebFormContext<T>> OnSubmit { get; set; }

    private WebFormContext<T>? _context;

    // The parent may hand over a different context, so the subscription follows the current one, and the key above rebuilds the fields for it.
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ReferenceEquals(_context, Context)) return;

        if (_context is not null) _context.Changed -= ContextChangedHandler;
        _context = Context;
        _context.Changed += ContextChangedHandler;
    }

    public void Dispose()
    {
        if (_context is not null) _context.Changed -= ContextChangedHandler;
    }

    private async Task SubmitHandler()
    {
        Context.BeginSubmit();

        try
        {
            if (!Context.Validate()) return;
            await OnSubmit.InvokeAsync(Context);
            if (ResetAfterSubmitCurrent)
            {
                Context.Reset();
            }
        }
        finally
        {
            Context.EndSubmit();
        }
    }


    private void ContextChangedHandler(IWebFormContext sender)
    {
        InvokeAsync(StateHasChanged);
    }

}
