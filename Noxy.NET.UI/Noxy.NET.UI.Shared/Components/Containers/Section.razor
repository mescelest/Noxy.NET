@inherits BaseComponentElement

<section @attributes="AdditionalAttributes" class="@CssClass">
    <div class="head">
        <DynamicHTMLTag Tag="@LevelTag" class="title">@Title</DynamicHTMLTag>
        @HeaderContent
    </div>
    @ChildContent
</section>

@code {

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public HTMLHeaderLevelEnum? Level { get; set; }
    private HTMLHeaderLevelEnum LevelCurrent => Level ?? HTMLHeaderLevelEnum.H2;
    private string LevelTag => LevelCurrent.ToText();

    // Beside the title, at the end of the row: what can be done with the whole section.
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
