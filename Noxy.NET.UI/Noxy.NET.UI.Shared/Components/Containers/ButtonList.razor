@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass" data-alignment="@AlignmentString">
    @ChildContent
</div>

@code {

    [Parameter]
    public ButtonListAlignmentEnum? Alignment { get; set; }
    private ButtonListAlignmentEnum AlignmentCurrent => Alignment ?? ButtonListAlignmentEnum.Left;
    private string AlignmentString => AlignmentCurrent.ToText();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

} 
