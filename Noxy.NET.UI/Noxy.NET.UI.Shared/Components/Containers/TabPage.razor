@implements IDisposable
@inherits BaseComponentElement

@code {
    [CascadingParameter]
    private TabSet? Parent { get; set; }

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public string? Link { get; set; }

    // The name of the link for assistive technology; the arrow alone says nothing.
    [Parameter]
    public string? LinkLabel { get; set; }
    public string LinkLabelCurrent => LinkLabel ?? Title;

    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public RenderFragment? LinkContent { get; set; }

    public string ID => UUIDCode;

    protected override void OnInitialized()
    {
        if (Parent == null)
        {
            throw new InvalidOperationException("TabPage must be used inside a TabSet component.");
        }

        Parent.AddPage(this);
    }

    private string? _shownTitle;

    // The tab list is drawn before the pages get their new parameters, so a title that changed shows one draw late unless the set draws again.
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (_shownTitle is not null && _shownTitle != Title) Parent?.Refresh();

        _shownTitle = Title;
    }

    public void Dispose()
    {
        Parent?.RemovePage(this);
    }

}
