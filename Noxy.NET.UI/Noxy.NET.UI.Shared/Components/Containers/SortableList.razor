@typeparam T
@inject IJSRuntime JS
@inherits BaseComponentElement
@implements IAsyncDisposable

<div @ref="_refElement" class="@CssClass">
    @for (int i = 0; i < List.Count; i++)
    {
        int index = i;
        T item = List[index];

        @ChildContent((item, index))
    }
</div>

@code {

    [Parameter, EditorRequired]
    public required IReadOnlyList<T> List { get; set; }

    [Parameter, EditorRequired]
    public required RenderFragment<(T Item, int Index)> ChildContent { get; set; }

    [Parameter]
    public EventCallback<(int IndexOld, int IndexNew)> OnUpdate { get; set; }

    [Parameter]
    public Func<T, int, object>? KeySelector { get; set; }

    [Parameter]
    public string? HandleClass { get; set; }
    private string HandleClassCurrent => !string.IsNullOrWhiteSpace(HandleClass) ? HandleClass : "sortable-handle";

    [Parameter]
    public string? DragClass { get; set; }
    private string DragClassCurrent => !string.IsNullOrWhiteSpace(DragClass) ? DragClass : "sortable-item";

    [Parameter]
    public string? GhostClass { get; set; }
    private string GhostClassCurrent => !string.IsNullOrWhiteSpace(GhostClass) ? GhostClass : "sortable-ghost";

    private ElementReference _refElement;
    private IJSObjectReference? _componentModule;
    private IJSObjectReference? _refInstance;
    private DotNetObjectReference<SortableList<T>>? _refDotNet;

    private bool _disposed;

    // A touch has to be held for this long before it starts a drag, so scrolling a list with a finger is not taken for one.
    private const int TouchHoldMilliseconds = 250;
    private const int FallbackTolerancePixels = 4;

    protected override async Task OnAfterFirstRenderAsync()
    {
        await base.OnAfterFirstRenderAsync();

        IJSObjectReference library;
        IJSObjectReference module;
        try
        {
            library = await JS.InvokeAsync<IJSObjectReference>("import", $"./_content/{typeof(SortableList<>).Assembly.GetName().Name}/Sortable.min.js");
            module = await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(SortableList<>)));
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        // Disposed while the scripts loaded (a refresh of the page, or a list that went away at once): nothing is left to set up, and nobody else releases what was loaded.
        if (_disposed)
        {
            await TryAsync(async () => await module.DisposeAsync());
            await TryAsync(async () => await library.DisposeAsync());
            return;
        }

        // The animation is off (see the script): the dragged row is put back before the owner renders the new order, so an animation would show the row jumping back.
        // The library follows the mouse itself instead of using the browser's own drag-and-drop, which does not start inside an embedded web view such as the one of a Blazor Hybrid app. A press that moves less than the tolerance is a click.
        Dictionary<string, object?> options = new()
        {
                { "forceFallback", true },
                { "fallbackTolerance", FallbackTolerancePixels },
                { "ghostClass", GhostClassCurrent },
                { "draggable", $".{DragClassCurrent}" },
                { "handle", $".{HandleClassCurrent}" },
                { "delay", TouchHoldMilliseconds },
                { "delayOnTouchOnly", true }
        };
        _componentModule = module;
        _refDotNet = DotNetObjectReference.Create(this);
        _refInstance = await _componentModule.InvokeAsync<IJSObjectReference>("initSortable", _refElement, _refDotNet, options);
        await TryAsync(async () => await library.DisposeAsync());
    }

    [JSInvokable]
    public async Task OnJSUpdate(int oldIndex, int newIndex)
    {
        if (oldIndex != newIndex && OnUpdate.HasDelegate)
        {
            await OnUpdate.InvokeAsync((oldIndex, newIndex));
        }
    }

    // After a refresh of the page the objects on the JavaScript side are gone while this component is still being disposed, so every call into them can fail with a JSException; each one is tried on its own so the rest still goes.
    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_refInstance is not null)
        {
            await TryAsync(async () =>
            {
                await _refInstance.InvokeVoidAsync("destroy");
                await _refInstance.DisposeAsync();
            });
        }

        if (_componentModule is not null)
        {
            await TryAsync(async () => await _componentModule.DisposeAsync());
        }

        _refDotNet?.Dispose();
    }

    private static async Task TryAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

}