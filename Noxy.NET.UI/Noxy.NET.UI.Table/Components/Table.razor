@typeparam T
@inherits ElementComponent

<div @attributes="AdditionalAttributes" class="@CssClass" role="table" data-virtualized="@Virtualize">
    <div class="header" role="rowheader">
        @TableHeader
    </div>

    <Loader class="loading" Loading="Loading">
        @if (List.Any())
        {
            @if (Virtualize)
            {
                <div class="items">
                    <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize TItem="(T Row, int Index)" Items="_indexedList" ItemSize="ItemSize" Context="entry">
                        @{ object? rowKey = KeySelector != null ? KeySelector(entry.Row) : entry.Row; }
                        <div @key="rowKey" class="row" role="row">
                            @TableRow(entry)
                        </div>
                    </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>
                </div>
            }
            else
            {
                @for (int index = 0; index < List.Count; index++)
                {
                    T element = List.ElementAt(index);
                    object? rowKey = KeySelector != null ? KeySelector(element) : element;

                    <div @key="rowKey" class="row" role="row">
                        @TableRow((element, index))
                    </div>
                }
            }
        }
        else if (Placeholder != null)
        {
            <div class="placeholder" role="row">No rows present</div>
        }
    </Loader>
</div>

@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<T> List { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<(T Row, int Index)> TableRow { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment TableHeader { get; set; }

    [Parameter]
    public RenderFragment? Placeholder { get; set; }

    [Parameter]
    public Func<T, object>? KeySelector { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    // Only the rows in view are rendered; the header stays above the scrolling rows. The table then needs a height of its own (the parent gives it one).
    [Parameter]
    public bool Virtualize { get; set; }

    // An estimate of one row, in pixels; the real height is measured.
    [Parameter]
    public float ItemSize { get; set; } = 48;

    private IReadOnlyList<T>? _indexedSource;
    private List<(T Row, int Index)> _indexedList = [];

    // The row numbers are worked out once per list, not once per row drawn.
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!Virtualize || ReferenceEquals(_indexedSource, List)) return;

        _indexedSource = List;
        _indexedList = [.. List.Select((row, index) => (row, index))];
    }

}
