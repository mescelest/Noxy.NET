@inject IState<FeatureSchemaContextState> StateContext
@inject IDispatcher Dispatcher
@inject TextParameterService TextParameterService
@inherits FluxorElementComponent

<div @attributes="AdditionalAttributes" class="@CssClass">
    <Collapsible Loading="IsLoading" @bind-Collapsed:get="_isCollapsed" @bind-Collapsed:set="SetCollapsed">
        <Header>
            <DynamicHTMLTag Tag="@HeaderLevelCurrent.ToText()">Context list</DynamicHTMLTag>
        </Header>
        <Content>
            <Table class="grid" RowCount="List.Count">
                <TableHeader>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelSchemaIdentifier)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelName)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelNote)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelTimeCreated)</strong></TableCell>
                </TableHeader>
                <TableBody>
                    @foreach (var (index, row) in List.Index())
                    {
                        <TableRow Index="index">
                            <TableCell>@row.SchemaIdentifier</TableCell>
                            <TableCell>@row.Name</TableCell>
                            <TableCell>@row.Note</TableCell>
                            <TableCell>@row.TimeCreated</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </Content>
    </Collapsible>
</div>

@code {

    [Parameter, EditorRequired]
    public EntitySchema Schema { get; set; }

    [Parameter]
    public string? Scope { get; set; }
    private string ScopeCurrent => Scope ?? $"{ComponentName}:{Schema.ID}";

    [Parameter]
    public HTMLHeaderLevelEnum? HeaderLevel { get; set; }
    private HTMLHeaderLevelEnum HeaderLevelCurrent => HeaderLevel ?? HTMLHeaderLevelEnum.H4;

    private bool _isCollapsed = true;

    private bool IsLoading => StateContext.Value.TryGetLoading(ScopeCurrent, FeatureSchemaContextActionKind.List, out bool value) && value;
    private IReadOnlyList<EntitySchemaContext> List => StateContext.Value.TryGetList(ScopeCurrent, out IReadOnlyList<EntitySchemaContext>? value) ? value : [];

    private void SetCollapsed(bool value)
    {
        _isCollapsed = value;
        if (!_isCollapsed && !StateContext.Value.List.ContainsKey(ScopeCurrent) && !IsLoading)
        {
            Dispatcher.Dispatch(new FeatureSchemaContextReducers.ListAction(ScopeCurrent, new() { SchemaID = Schema.ID }));
        }
    }

}
