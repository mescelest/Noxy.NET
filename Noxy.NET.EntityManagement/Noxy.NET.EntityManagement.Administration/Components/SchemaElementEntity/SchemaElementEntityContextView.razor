@inject IState<FeatureSchemaContextState> StateContext
@inject IState<FeatureSchemaContextHasElementState> StateContextHasElement
@inject IDispatcher Dispatcher
@inject TextParameterService TextParameterService
@inherits FluxorElementComponent

<div @attributes="AdditionalAttributes" class="@CssClass">
    <Collapsible Loading="IsLoadingList" @bind-Collapsed:get="_isCollapsed" @bind-Collapsed:set="SetCollapsed">
        <Header>
            <DynamicHTMLTag Tag="@HeaderLevelCurrent.ToText()">Context list</DynamicHTMLTag>
        </Header>
        <Content>
            <Table class="grid" RowCount="List.Count">
                <TableHeader>
                    <TableCell/>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelSchemaIdentifier)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelName)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelNote)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelTimeCreated)</strong></TableCell>
                </TableHeader>
                <TableBody>
                    @foreach (var (index, row) in List.Index())
                    {
                        <TableRow Index="index">
                            <TableCell>
                                <InputElementCheckbox Option="true" @bind-Value:get="@IsChecked(row.ID)" @bind-Value:set="x => SetChecked(x, row.ID)"/>
                            </TableCell>
                            <TableCell>@row.SchemaIdentifier</TableCell>
                            <TableCell>@row.Name</TableCell>
                            <TableCell>@row.Note</TableCell>
                            <TableCell>@row.TimeCreated</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </Content>
    </Collapsible>
</div>

@code {

    [Parameter, EditorRequired]
    public EntitySchema Schema { get; set; }

    [Parameter, EditorRequired]
    public EntitySchemaElement SchemaElement { get; set; }

    [Parameter]
    public string? Scope { get; set; }
    private string ScopeCurrent => Scope ?? $"{ComponentName}:{Schema.ID}";

    [Parameter]
    public HTMLHeaderLevelEnum? HeaderLevel { get; set; }
    private HTMLHeaderLevelEnum HeaderLevelCurrent => HeaderLevel ?? HTMLHeaderLevelEnum.H4;

    private bool _isCollapsed = true;

    private bool IsLoading => IsLoadingList || IsLoadingJunction;
    private bool IsLoadingList => StateContext.Value.TryGetLoading(ScopeCurrent, FeatureSchemaContextActionKind.List, out bool value) && value;
    private IReadOnlyList<EntitySchemaContext> List => StateContext.Value.TryGetList(ScopeCurrent, out IReadOnlyList<EntitySchemaContext>? value) ? value : [];

    private bool IsLoadingJunction => StateContextHasElement.Value.TryGetLoading(ScopeCurrent, FeatureSchemaContextHasElementActionKind.List, out bool value) && value;
    private IReadOnlyList<EntitySchemaContextHasElement> Junction => StateContextHasElement.Value.TryGetList(ScopeCurrent, out IReadOnlyList<EntitySchemaContextHasElement>? value) ? value : [];

    private bool IsChecked(Guid id)
    {
        return Junction.Any(x => x.EntityID == id);
    }

    private void SetChecked(bool value, Guid id)
    {
        if (value)
        {
            Dispatcher.Dispatch(new FeatureSchemaContextHasElementReducers.AddAction(ScopeCurrent, new() { SchemaContextID = id, SchemaElementID = SchemaElement.ID }));
        }
        else
        {
            EntitySchemaContextHasElement junction = Junction.Single(x => x.EntityID == id && x.RelationID == SchemaElement.ID);
            Dispatcher.Dispatch(new FeatureSchemaContextHasElementReducers.DeleteAction(ScopeCurrent, new() { ID = junction.ID }));
        }
    }

    private void SetCollapsed(bool value)
    {
        _isCollapsed = value;

        if (_isCollapsed || StateContext.Value.List.ContainsKey(ScopeCurrent) || IsLoading) return;
        Dispatcher.Dispatch(new FeatureSchemaContextReducers.ListAction(ScopeCurrent, new() { SchemaID = Schema.ID }));
        Dispatcher.Dispatch(new FeatureSchemaContextHasElementReducers.ListAction(ScopeCurrent, new() { SchemaElementID = SchemaElement.ID }));
    }

}
