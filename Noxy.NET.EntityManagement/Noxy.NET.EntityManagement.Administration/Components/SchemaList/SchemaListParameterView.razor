@inject IState<FeatureSchemaParameterState> StateContext
@inject TextParameterService TextParameterService
@inject IDispatcher Dispatcher
@inherits FluxorElementComponent

<div @attributes="AdditionalAttributes" class="@CssClass">
    <Collapsible Loading="IsLoading" @bind-Collapsed:get="_isCollapsed" @bind-Collapsed:set="SetCollapsed">
        <Header>
            <div class="title">
                <DynamicHTMLTag Tag="@HeaderLevelCurrent.ToText()">Parameter list</DynamicHTMLTag>
                <NavLink href="@Link">
                    <MaterialIcon Icon="arrow_right_alt" Size="@Size"/>
                </NavLink>
            </div>
        </Header>
        <Content>
            <Table class="grid" RowCount="List.Count">
                <TableHeader>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelSchemaIdentifier)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelName)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelNote)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelTitle)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelDescription)</strong></TableCell>
                    <TableCell><strong>@TextParameterService.Get(ParameterTextConstants.LabelTimeCreated)</strong></TableCell>
                </TableHeader>
                <TableBody>
                    @foreach (var (index, row) in List.Index())
                    {
                        <TableRow Index="index">
                            <TableCell>@row.SchemaIdentifier</TableCell>
                            <TableCell>@row.Name</TableCell>
                            <TableCell>@row.Note</TableCell>
                            <TableCell>@(row.IsApprovalRequired ? TextParameterService.Get(ParameterTextConstants.ValueYes) : TextParameterService.Get(ParameterTextConstants.ValueNo))</TableCell>
                            <TableCell>@(row.IsSystemDefined ? TextParameterService.Get(ParameterTextConstants.ValueYes) : TextParameterService.Get(ParameterTextConstants.ValueNo))</TableCell>
                            <TableCell>@row.TimeCreated</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </Content>
    </Collapsible>
</div>

@code {

    [Parameter, EditorRequired]
    public required Guid SchemaID { get; set; }

    [Parameter]
    public HTMLHeaderLevelEnum? HeaderLevel { get; set; }
    private HTMLHeaderLevelEnum HeaderLevelCurrent => HeaderLevel ?? HTMLHeaderLevelEnum.H4;

    [Parameter]
    public string? Scope { get; set; }
    private string ScopeCurrent => Scope ?? $"{ComponentName}:{SchemaID}";

    private bool _isCollapsed = true;

    private string Size => $"var(--size-text-{HeaderLevelCurrent.ToText()})";
    private string Link => $"/schema/{SchemaID}/parameter";
    private bool IsLoading => StateContext.Value.TryGetLoading(ScopeCurrent, FeatureSchemaParameterActionKind.List, out bool value) && value;
    private IReadOnlyList<EntitySchemaParameter> List => StateContext.Value.TryGetList(ScopeCurrent, out IReadOnlyList<EntitySchemaParameter.Discriminator>? value) ? [..value.Select(x => x.GetValue())] : [];

    private void SetCollapsed(bool value)
    {
        _isCollapsed = value;
        if (_isCollapsed || StateContext.Value.List.ContainsKey(ScopeCurrent) || IsLoading) return;
        Dispatcher.Dispatch(new FeatureSchemaParameterReducers.ListAction(ScopeCurrent, new() { SchemaID = SchemaID }));
    }

}
