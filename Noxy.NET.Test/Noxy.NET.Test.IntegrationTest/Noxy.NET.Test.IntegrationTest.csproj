<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Noxy.NET.Test</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15"/>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageReference Include="xunit.v3" Version="4.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Noxy.NET.MediaPlayer\Noxy.NET.MediaPlayer.Application\Noxy.NET.MediaPlayer.Application.csproj"/>
        <ProjectReference Include="..\..\Noxy.NET.MediaPlayer\Noxy.NET.MediaPlayer.Persistence\Noxy.NET.MediaPlayer.Persistence.csproj"/>
        <ProjectReference Include="..\..\Noxy.NET.MediaPlayer\Noxy.NET.MediaPlayer.API\Noxy.NET.MediaPlayer.API.csproj"/>
        <ProjectReference Include="..\..\Noxy.NET.MediaPlayer\Noxy.NET.MediaPlayer.Presentation\Noxy.NET.MediaPlayer.Presentation.csproj"/>
        <ProjectReference Include="..\..\Noxy.NET.MediaPlayer\Noxy.NET.MediaPlayer.Storage\Noxy.NET.MediaPlayer.Storage.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Noxy.NET.Test.UnitTest\MediaPlayer\Fixtures\MetadataStoreContract.cs" Link="MediaPlayer\Fixtures\MetadataStoreContract.cs"/>
        <Compile Include="..\Noxy.NET.Test.UnitTest\MediaPlayer\Fakes\FakeSessionStorage.cs" Link="MediaPlayer\Fakes\FakeSessionStorage.cs"/>
        <Compile Include="..\Noxy.NET.Test.UnitTest\MediaPlayer\Fakes\FakeServerAddressStorage.cs" Link="MediaPlayer\Fakes\FakeServerAddressStorage.cs"/>
        <Compile Include="..\Noxy.NET.Test.UnitTest\MediaPlayer\Fakes\FakeGoogleSignInService.cs" Link="MediaPlayer\Fakes\FakeGoogleSignInService.cs"/>
    </ItemGroup>

</Project>
