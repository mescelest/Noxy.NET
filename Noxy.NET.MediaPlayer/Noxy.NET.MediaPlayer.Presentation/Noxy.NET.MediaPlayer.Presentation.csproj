<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Title>Noxy.NET.MediaPlayer.Presentation</Title>
        <Authors>Noxy.NET</Authors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Update="Resources\PresentationTexts.Designer.cs">
            <DependentUpon>PresentationTexts.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\PresentationTexts.resx">
            <Generator>MSBuild:Compile</Generator>
            <StronglyTypedFileName>Resources\PresentationTexts.Designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>Noxy.NET.MediaPlayer.Presentation.Resources</StronglyTypedNamespace>
            <StronglyTypedClassName>PresentationTexts</StronglyTypedClassName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Noxy.NET.MediaPlayer.Presentation.Resources"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fluxor" Version="6.11.0"/>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Noxy.NET.MediaPlayer.Application\Noxy.NET.MediaPlayer.Application.csproj"/>
        <ProjectReference Include="..\Noxy.NET.MediaPlayer.Domain\Noxy.NET.MediaPlayer.Domain.csproj"/>
    </ItemGroup>

</Project>
