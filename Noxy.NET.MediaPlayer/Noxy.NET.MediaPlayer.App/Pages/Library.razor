@page "/library"
@inject IState<FeatureLibraryState> StateLibrary
@inject IDispatcher Dispatcher
@inject IPlaybackControlService ServicePlaybackControl
@inject IToastService ServiceToast
@inherits BaseComponentPageFluxor

<div class="@CssClass @FullscreenPageClass">
    <UploadMediaDropZone>
        <MediaFileHeader Name="Library" EntryCount="Current.MediaList.Count" SelectedCount="Current.SelectedSet.Count">
            <LibraryContextMenu @ref="_contextMenu" SelectedSet="Current.SelectedSet" SelectedKeyList="Current.SelectedIDList" ShowTrigger="@HasSelection"/>
        </MediaFileHeader>

        <MediaFileTable RowList="RowList" IsEmpty="IsLibraryEmpty" EmptyTitle="Your library is empty"
                        EmptyDescription="Upload music files from your computer to start your library. Once they are in, you can search and sort them, play them, and put them in playlists." StateMap="Current.StateMap" Sort="Current.Sort"
                        Descending="Current.Descending" OnSortChanged="Sort"
                        SelectedSet="Current.SelectedSet" AllSelected="Current.AllVisibleSelected" OnToggleAll="ToggleAllVisibleSelected" OnToggleRow="ToggleSelected"
                        OnPlay="Play" OnContextMenu="OpenRowMenu">
            <ToolContent>
                <InputControlText class="search" Type="WebFormInputTextTypeEnum.Search" OnInputDelay="0" placeholder="Search the library" aria-label="Search the library" Value="@Current.Search" ValueChanged="ChangeSearch"/>
                <ButtonList>
                    <UploadMediaButton Appearance="ButtonAppearanceEnum.Outline"/>
                </ButtonList>
            </ToolContent>
            <EmptyContent>
                <UploadMediaButton/>
            </EmptyContent>
        </MediaFileTable>
    </UploadMediaDropZone>
</div>

@code {

    private LibraryContextMenu? _contextMenu;
    private List<ResponseMediaFile>? _rowSource;

    private FeatureLibraryState Current => StateLibrary.Value;

    // The rows follow the visible list and are rebuilt only when it is another list.
    private List<MediaFileTableRow> RowList
    {
        get
        {
            if (ReferenceEquals(_rowSource, Current.VisibleList)) return field;

            _rowSource = Current.VisibleList;
            return field = [.. _rowSource.Select(x => new MediaFileTableRow(x.ID, x))];
        }
    } = [];

    private async Task OpenRowMenu((MouseEventArgs Args, MediaFileTableRow Row) context)
    {
        if (_contextMenu is null) return;

        await _contextMenu.OpenAtAsync(context.Args, context.Row.Key);
    }

    private bool IsLibraryEmpty => Current.MediaList.Count == 0;

    private bool HasSelection => Current.SelectedSet.Count > 0;

    // The feature toggles: the new value of the box is already what the state will say once it is dispatched.
    private void ToggleAllVisibleSelected()
    {
        Dispatcher.Dispatch(new ActionLibraryVisibleSelected());
    }

    private void ToggleSelected(Guid id)
    {
        Dispatcher.Dispatch(new ActionLibrarySelectionToggled(id));
    }

    private void Sort(LibrarySortEnum sort)
    {
        Dispatcher.Dispatch(new ActionLibrarySortChanged(sort));
    }

    private void ChangeSearch(string? search)
    {
        Dispatcher.Dispatch(new ActionLibrarySearchChanged(search ?? string.Empty));
    }

    // The played list is exactly what the page shows: the same sort and search.
    private async Task Play(MediaFileTableRow row)
    {
        try
        {
            await ServicePlaybackControl.StartLibrary(row.MediaFile.ID, Current.Sort, Current.Descending, Current.Search);
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
    }

}
