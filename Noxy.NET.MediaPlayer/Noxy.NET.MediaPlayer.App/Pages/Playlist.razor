@page "/playlist/{Id:guid}"
@inject IState<FeatureLibraryState> StateLibrary
@inject IState<FeaturePlaylistListState> StatePlaylistList
@inject IPlaylistService ServicePlaylist
@inject ISyncService ServiceSync
@inject IMetadataStore StoreMetadata
@inject IToastService ServiceToast
@inherits BaseComponentPageFluxor
@implements IAsyncDisposable

<div class="@CssClass @FullscreenPageClass">
    @if (_gone)
    {
        <MessageBox MessageList="@(["This playlist was deleted."])" Status="StatusEnum.Warning"/>
    }
    else if (_detail is null)
    {
        <Loader Loading="true" Label="Loading"/>
    }
    else
    {
        <UploadMediaDropZone PlaylistID="Id">
            <MediaFileHeader Name="@_detail.Name" EntryCount="_detail.EntryList.Count" SelectedCount="_selectedSet.Count">
                <LibraryContextMenu @ref="_contextMenu" PlaylistID="Id" SelectedSet="_selectedSet" SelectedKeyList="SelectedKeyList"
                                    MediaFileIDOf="MediaFileIDOf" OnPlaylistChanged="Load" ShowTrigger="@HasSelection"/>
            </MediaFileHeader>

            <MediaFileTable RowList="_rowList" IsEmpty="IsPlaylistEmpty" EmptyTitle="This playlist is empty" EmptyDescription="Add media files from the Library." StateMap="StateLibrary.Value.StateMap" Sort="_sort" Descending="_descending"
                            OnSortChanged="ChangeSort"
                            SelectedSet="_selectedSet" AllSelected="IsAllSelected" OnToggleAll="ToggleAllShown" OnToggleRow="ToggleRow" OnPlay="Play" OnContextMenu="OpenRowMenu"
                            IsReorderable="CanReorder" ReorderHint="ReorderHint" OnMove="Move">
                <ToolContent>
                    <InputControlText class="search" Type="WebFormInputTextTypeEnum.Search" OnInputDelay="0" placeholder="Search the playlist" aria-label="Search the playlist" Value="@_search" ValueChanged="ChangeSearch"/>
                    <ButtonList>
                        @if (_sort is not null)
                        {
                            <Button Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.None" @onclick="ClickClearSortHandler">Clear sort</Button>
                        }
                        <Button Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.Highlight" aria-label="Play" @onclick="ClickPlayHandler">
                            <MaterialIcon Icon="play_arrow" Size="var(--size-icon-md)"/>
                            <span>Play</span>
                        </Button>
                        <UploadMediaButton PlaylistID="Id" Appearance="ButtonAppearanceEnum.Outline"/>
                        @if (Summary is { } summary)
                        {
                            <Button Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.None" aria-label="Playlist actions" aria-haspopup="menu"
                                    popovertarget="@PlaylistContextMenu.MenuID(summary.ID, PlaylistContextMenu.PlacePage)">
                                <MaterialIcon Icon="more_horiz" Size="var(--size-icon-md)"/>
                            </Button>
                            <PlaylistContextMenu Playlist="summary" Place="@PlaylistContextMenu.PlacePage"/>
                        }
                    </ButtonList>
                </ToolContent>
            </MediaFileTable>
        </UploadMediaDropZone>
    }
</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private ResponsePlaylistDetail? _detail;
    private bool _gone;
    private readonly HashSet<Guid> _selectedSet = [];
    private Guid _loadedID;

    // What the page shows is its own and forgotten when the page is left: the sort and the search never change the playlist.
    private LibrarySortEnum? _sort;
    private bool _descending;
    private string _search = string.Empty;
    private List<MediaFileTableRow> _rowList = [];
    private Dictionary<Guid, Guid> _mediaFileIDMap = [];
    private LibraryContextMenu? _contextMenu;

    private ResponsePlaylist? Summary => StatePlaylistList.Value.PlaylistList.FirstOrDefault(x => x.ID == Id);

    private bool IsPlaylistEmpty => _detail is not null && _detail.EntryList.Count == 0;

    private bool HasSelection => _selectedSet.Count > 0;

    private bool IsAllSelected => _rowList.Count > 0 && _rowList.All(x => _selectedSet.Contains(x.Key));

    private bool CanReorder => ResponsePlaylistEntryListExtension.CanReorder(_search, _sort);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedID == Id) return;

        _loadedID = Id;
        _detail = null;
        _gone = false;
        _selectedSet.Clear();
        _sort = null;
        _descending = false;
        _search = string.Empty;
        _rowList = [];
        ServiceSync.Changed -= OnSyncChanged;
        ServiceSync.Changed += OnSyncChanged;

        // Opening syncs the detail and starts the downloads of what is missing: nothing else downloads for a playlist.
        await Run(() => ServicePlaylist.Open(Id));
        await Load();
    }

    private void OnSyncChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        });
    }

    // A playlist deleted on another device disappears from the list: the page then says so.
    private async Task Load()
    {
        try
        {
            _detail = await StoreMetadata.GetPlaylistDetail(Id);
            if (_detail is null)
            {
                _gone = !(await StoreMetadata.GetPlaylistList()).Any(x => x.ID == Id);
                return;
            }

            RebuildRows();
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
    }

    // The rows are the stored order, filtered and sorted for the eyes only. A media file twice in the playlist is two rows with their own keys.
    private void RebuildRows()
    {
        if (_detail is null) return;

        List<ResponsePlaylistEntry> storedList = [.. _detail.EntryList.OrderBy(x => x.Position)];
        _rowList = [.. storedList.ToDisplayList(_search, _sort, _descending).Select(x => new MediaFileTableRow(x.ID, x.MediaFile))];
        _mediaFileIDMap = storedList.ToDictionary(x => x.ID, x => x.MediaFileID);
        _selectedSet.IntersectWith(_mediaFileIDMap.Keys);
    }

    // Says whether the action went through: a failure is raised as a toast.
    private async Task<bool> Run(Func<Task> action)
    {
        try
        {
            await action();
            return true;
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
            return false;
        }
    }

    private Task ClickPlayHandler() => Run(() => ServicePlaylist.Play(Id));

    // Playback follows the playlist's own order, whatever the rows show.
    private Task Play(MediaFileTableRow row) => Run(() => ServicePlaylist.Play(Id, row.Key));

    // A second click on the same column turns the direction round, as in the Library.
    private void ChangeSort(LibrarySortEnum column)
    {
        _descending = _sort == column && !_descending;
        _sort = column;
        RebuildRows();
    }

    private void ClickClearSortHandler()
    {
        _sort = null;
        _descending = false;
        RebuildRows();
    }

    private void ChangeSearch(string? search)
    {
        _search = search ?? string.Empty;
        RebuildRows();
    }

    private void ToggleRow(Guid entryID)
    {
        if (!_selectedSet.Remove(entryID))
        {
            _selectedSet.Add(entryID);
        }
    }

    private void ToggleAllShown()
    {
        bool isAllSelected = IsAllSelected;
        foreach (MediaFileTableRow row in _rowList)
        {
            if (isAllSelected)
            {
                _selectedSet.Remove(row.Key);
            }
            else
            {
                _selectedSet.Add(row.Key);
            }
        }
    }

    // The ticked entries in the order of the rows, then the ones a search hides.
    private List<Guid> SelectedKeyList => [.. _rowList.Where(x => _selectedSet.Contains(x.Key)).Select(x => x.Key), .. _selectedSet.Except(_rowList.Select(x => x.Key))];

    // An entry stands for its media file; the same media file can be two entries.
    private Guid MediaFileIDOf(Guid entryID) => _mediaFileIDMap.GetValueOrDefault(entryID, entryID);

    private async Task OpenRowMenu((MouseEventArgs Args, MediaFileTableRow Row) context)
    {
        if (_contextMenu is null) return;

        await _contextMenu.OpenAtAsync(context.Args, context.Row.Key);
    }

    // The dragged entry goes to the stored position of the one it is dropped on.
    private async Task Move((Guid DragKey, Guid TargetKey) move)
    {
        ResponsePlaylistEntry? target = _detail?.EntryList.FirstOrDefault(x => x.ID == move.TargetKey);
        if (target is null) return;

        await Run(() => ServicePlaylist.MoveEntry(Id, move.DragKey, target.Position));
        await Load();
    }

    public new async ValueTask DisposeAsync()
    {
        ServiceSync.Changed -= OnSyncChanged;
        await base.DisposeAsync();
    }

}
