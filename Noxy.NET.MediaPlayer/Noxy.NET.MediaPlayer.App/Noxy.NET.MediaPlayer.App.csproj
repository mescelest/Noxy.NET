<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>Noxy.NET.MediaPlayer.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Disable MAUI CSS handling so Blazor can handle it -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Noxy.NET.MediaPlayer</ApplicationTitle>

        <!-- Also the package name of the Android OAuth client in Google Cloud Console -->
        <ApplicationId>com.noxy.net.mediaplayer</ApplicationId>

        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Unpackaged on Windows: runs without installing a package -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <!-- CsWinRT generates the marshalling code for the .NET collection types (such as the sets the table takes) with unsafe code, for trimming and AOT. -->
        <AllowUnsafeBlocks Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- The designer is a source file the IDE regenerates when the resx is saved. The build does not generate it for this project. -->
        <Compile Update="Resources\AppTexts.Designer.cs">
            <AutoGen>True</AutoGen>
            <DesignTime>True</DesignTime>
            <DependentUpon>AppTexts.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Resources\AppTexts.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>AppTexts.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4"/>
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128"/>
        <MauiImage Include="Resources\Images\*"/>
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208"/>
        <MauiFont Include="Resources\Fonts\*"/>
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The git-ignored Google client secret, copied next to the app when it exists -->
        <None Include="google.local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('google.local.json')"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)"/>
        <PackageReference Include="Fluxor.Blazor.Web" Version="6.11.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Noxy.NET.Shared\Noxy.NET.Shared.csproj"/>
        <ProjectReference Include="..\..\Noxy.NET.UI\Noxy.NET.UI.Shared\Noxy.NET.UI.Shared.csproj"/>
        <ProjectReference Include="..\..\Noxy.NET.UI\Noxy.NET.UI.Shared.Fluxor\Noxy.NET.UI.Shared.Fluxor.csproj"/>
        <ProjectReference Include="..\Noxy.NET.MediaPlayer.Presentation\Noxy.NET.MediaPlayer.Presentation.csproj"/>
        <ProjectReference Include="..\Noxy.NET.MediaPlayer.Storage\Noxy.NET.MediaPlayer.Storage.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Pages\Bandcamp.razor"/>
        <AdditionalFiles Include="Pages\Home.razor"/>
        <AdditionalFiles Include="Pages\Library.razor"/>
        <AdditionalFiles Include="Pages\NotFound.razor"/>
        <AdditionalFiles Include="Pages\Playlist.razor"/>
        <AdditionalFiles Include="Pages\Settings.razor"/>
        <AdditionalFiles Include="Pages\Youtube.razor"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Components\Dialogs\ServerManageDialog.razor.js"/>
        <None Include="Components\NarrowWatcher.razor.js"/>
    </ItemGroup>

</Project>
