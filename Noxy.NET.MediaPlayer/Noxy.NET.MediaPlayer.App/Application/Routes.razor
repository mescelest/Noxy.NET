@inject IStateBridgeService StateBridge

<Fluxor.Blazor.Web.StoreInitializer/>
<CascadingValue Name="@Dialog.CloseContentName" Value="_closeContent" IsFixed="true">
    <Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(AppLayout)"/>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
    </Router>
</CascadingValue>

@code {

    // What every dialog's close button holds.
    private readonly RenderFragment _closeContent = @<MaterialIcon Icon="close" Size="var(--size-icon-xs)"/>;


    // The store is ready when the components render: the bridge starts here, in the scope the components share with the store.
    protected override void OnInitialized()
    {
        StateBridge.Start();
    }

}
