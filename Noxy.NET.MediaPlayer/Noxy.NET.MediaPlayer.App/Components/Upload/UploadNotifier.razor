@inject IUploadService ServiceUpload
@inject IToastService ServiceToast
@inject IMetadataStore StoreMetadata
@inherits BaseComponentBlazor
@implements IDisposable

@code {

    protected override void OnInitialized()
    {
        ServiceUpload.Started += OnStarted;
        ServiceUpload.BatchCompleted += OnBatchCompleted;
    }

    private void OnStarted(int count)
    {
        ServiceToast.ShowInfo(count.ToCountText(AppTexts.UploadStartedOne, AppTexts.UploadStartedMany));
    }

    private void OnBatchCompleted(UploadBatchResult result)
    {
        _ = Report(result);
    }

    private async Task Report(UploadBatchResult result)
    {
        if (result.SucceededCount + result.ExistingAddedCount > 0)
        {
            ServiceToast.ShowSuccess(await SuccessMessageOf(result));
        }

        if (result.DuplicateCount > 0)
        {
            ServiceToast.ShowWarning(result.DuplicateCount.ToCountText(AppTexts.UploadDuplicateOne, AppTexts.UploadDuplicateMany));
        }

        foreach (UploadFailure failure in result.FailureList)
        {
            ServiceToast.ShowError(string.Format(AppTexts.UploadFailureLine, failure.Name, failure.Message));
        }
    }

    private async Task<string> SuccessMessageOf(UploadBatchResult result)
    {
        int count = result.SucceededCount + result.ExistingAddedCount;
        if (result.PlaylistID is not { } playlistID) return count.ToCountText(AppTexts.UploadAddedLibraryOne, AppTexts.UploadAddedLibraryMany);

        string? name = (await StoreMetadata.GetPlaylistList()).Find(x => x.ID == playlistID)?.Name;

        return name is null ? count.ToCountText(AppTexts.UploadAddedOne, AppTexts.UploadAddedMany) : count.ToCountText(AppTexts.UploadAddedPlaylistOne, AppTexts.UploadAddedPlaylistMany, name);
    }

    public void Dispose()
    {
        ServiceUpload.Started -= OnStarted;
        ServiceUpload.BatchCompleted -= OnBatchCompleted;
    }

}
