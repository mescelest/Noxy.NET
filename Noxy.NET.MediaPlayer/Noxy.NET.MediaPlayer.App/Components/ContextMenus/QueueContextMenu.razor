@inject IState<FeaturePlaylistListState> StatePlaylistList
@inject IState<FeatureLibraryState> StateLibrary
@inject ILibraryActionService ServiceLibraryAction
@inject IQueueActionService ServiceQueueAction
@inject IPlaybackControlService ServiceControl
@inject IToastService ServiceToast
@using Noxy.NET.MediaPlayer.Presentation
@inherits BaseComponentElementFluxor

<div @attributes="AdditionalAttributes" class="@CssClass">
    @if (ShowTrigger)
    {
        <Button Type="@HTMLButtonTypeEnum.Button" class="trigger" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" disabled="@IsNothingTicked" aria-label="@AppTexts.LibraryActions" aria-haspopup="menu" popovertarget="@MenuID">
            <MaterialIcon Icon="more_horiz" Size="var(--size-icon-sm)"/>
        </Button>
    }

    <ContextMenu @ref="_menu" ID="@MenuID" ItemList="ItemList" Side="PlacementSideEnum.Bottom" Align="PlacementAlignEnum.End" OnClose="CloseHandler"/>

    <AddToPlaylistDialog @bind-Open="_choosingPlaylist" OnChosen="AddToPlaylist"/>
</div>

@code {

    // The item IDs of the ticked rows, and the same in the order of the list.
    [Parameter, EditorRequired]
    public required IReadOnlySet<Guid> SelectedSet { get; set; }

    [Parameter, EditorRequired]
    public required List<Guid> SelectedKeyList { get; set; }

    // The row of an item, or null when it is not in the queue any more.
    [Parameter, EditorRequired]
    public required Func<Guid, QueueListRow?> RowOf { get; set; }

    // The button for the ticked rows. The menu itself stays, for the right-click on a row, whether the button shows or not.
    [Parameter]
    public bool ShowTrigger { get; set; } = true;

    private const string MenuID = "queue-context-menu";

    private ContextMenu? _menu;
    private Guid? _clickedKey;
    private List<Guid> _playlistTargetList = [];
    private bool _choosingPlaylist;

    private bool IsNothingTicked => SelectedSet.Count == 0;

    // A right-click on a row acts on that row; the button acts on the ticked rows.
    private List<ContextMenuItem> ItemList => _clickedKey is { } key ? BuildItemList([key]) : BuildItemList(SelectedKeyList);

    public async Task OpenAtAsync(MouseEventArgs args, Guid itemID)
    {
        if (_menu is null) return;

        _clickedKey = itemID;
        StateHasChanged();
        await _menu.OpenAtAsync(args);
    }

    private Task CloseHandler()
    {
        _clickedKey = null;
        return Task.CompletedTask;
    }

    // The menu for these queue items: what the queue can do with them, then what the library can do with their files.
    private List<ContextMenuItem> BuildItemList(List<Guid> itemIDList)
    {
        List<QueueListRow> rowList = [.. itemIDList.Select(RowOf).OfType<QueueListRow>()];
        List<Guid> upcomingIDList = [.. rowList.Where(x => x.Kind.IsUpcoming).Select(x => x.Item?.ItemID).OfType<Guid>()];
        List<Guid> itemIDChosenList = [.. rowList.Select(x => x.Item?.ItemID).OfType<Guid>()];
        List<Guid> mediaFileIDList = [.. rowList.Select(x => x.Item?.MediaFileID).OfType<Guid>()];
        string? upcomingReason = upcomingIDList.Count == 0 ? AppTexts.QueueNothingRemovable : null;

        List<ContextMenuItem> list = [];
        if (rowList.Count == 1 && rowList[0].Item is { } only)
        {
            list.Add(ContextMenuItem.Item(AppTexts.QueuePlayNow, () => Run(() => ServiceControl.JumpTo(only.ItemID, true)), icon: "play_arrow"));
        }

        list.Add(ContextMenuItem.Item(AppTexts.QueuePlayNext, () => Show(ServiceQueueAction.PlayNext(upcomingIDList)), upcomingReason is not null, upcomingReason, icon: "playlist_play"));
        list.Add(ContextMenuItem.Item(AppTexts.QueueRemove, () => Show(ServiceQueueAction.Remove(itemIDChosenList)), itemIDChosenList.Count == 0, null, true, "remove_circle_outline"));
        list.Add(ContextMenuItem.Separator());
        list.Add(AddToPlaylistItem(mediaFileIDList));

        // What the device holds decides what can be done with it, as in the library menu: a file that is there can have its metadata written, be shown and removed, one that is not can be downloaded, and a copy can be saved either way.
        bool anyOnDevice = mediaFileIDList.Any(IsOnDevice);
        list.Add(ManageFileItem(mediaFileIDList, anyOnDevice));

        if (mediaFileIDList.Any(x => !IsOnDevice(x)))
        {
            list.Add(ItemOf(LibraryActionEnum.Download, AppTexts.LibraryDownload, () => Show(ServiceLibraryAction.Download(mediaFileIDList)), "download"));
        }

        if (!anyOnDevice) return list;

        list.Add(ContextMenuItem.Separator());
        list.Add(ItemOf(LibraryActionEnum.RemoveFromDevice, AppTexts.LibraryRemoveFromDevice, () => Show(ServiceLibraryAction.RemoveFromDevice(mediaFileIDList)), "delete_sweep", true, AppTexts.ConfirmActionAgain));

        return list;
    }

    // What can be done with the files themselves: write the metadata into the copies on the device, save a copy (the server's, so it works for songs that are not on the device too), and show the file in the file manager where the platform has one.
    private ContextMenuItem ManageFileItem(List<Guid> mediaFileIDList, bool anyOnDevice)
    {
        List<ContextMenuItem> list = [];
        if (anyOnDevice)
        {
            list.Add(ItemOf(LibraryActionEnum.UpdateFileMetadata, AppTexts.LibraryUpdateFileMetadata, () => Show(ServiceLibraryAction.UpdateFileMetadata(mediaFileIDList)), "edit_note"));
        }

        list.Add(ItemOf(LibraryActionEnum.SaveAsFile, AppTexts.LibrarySaveAsFile, () => Show(ServiceLibraryAction.SaveAsFile(mediaFileIDList)), "save_alt"));
        if (anyOnDevice && ServiceLibraryAction.CanOpenFolder)
        {
            list.Add(ItemOf(LibraryActionEnum.OpenFolder, AppTexts.LibraryOpenFolder, () => Show(ServiceLibraryAction.OpenContainingFolder(mediaFileIDList)), "folder_open"));
        }

        return ContextMenuItem.Submenu(AppTexts.LibraryManageFile, list, "description");
    }

    private bool IsOnDevice(Guid mediaFileID)
    {
        return StateLibrary.Value.StateMap.GetValueOrDefault(mediaFileID, FileSyncStateEnum.NotDownloaded) == FileSyncStateEnum.OnDevice;
    }

    private ContextMenuItem ItemOf(LibraryActionEnum action, string text, Func<Task> run, string icon, bool isDestructive = false, string? confirmText = null, RenderFragment? graphic = null)
    {
        string? reason = ServiceLibraryAction.GetDisabledReason(action);
        return ContextMenuItem.Item(text, run, reason is not null, reason, isDestructive, icon, confirmText: confirmText, graphic: graphic);
    }

    private async Task Run(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
    }

    private async Task Show(Task<BulkResult> action)
    {
        BulkResult result;
        try
        {
            result = await action;
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
            return;
        }

        if (result.FailedIDList.Count > 0)
        {
            ServiceToast.ShowWarning(string.Format(AppTexts.BulkFailed, result.FailedIDList.Count, result.Message).Trim());
        }
    }

    private Task ChoosePlaylist(List<Guid> mediaFileIDList)
    {
        _playlistTargetList = mediaFileIDList;
        _choosingPlaylist = true;

        return Task.CompletedTask;
    }

    // A sub-menu: pick a playlist in the dialog, or one of the playlists played most recently (the same short list as the home page) at once.
    private ContextMenuItem AddToPlaylistItem(List<Guid> mediaFileIDList)
    {
        List<ContextMenuItem> list = [ItemOf(LibraryActionEnum.AddToPlaylist, AppTexts.LibraryPickPlaylist, () => ChoosePlaylist(mediaFileIDList), "playlist_add")];
        List<ResponsePlaylist> recentList = StatePlaylistList.Value.PlaylistList.TakeRecentlyPlayed(PresentationConstants.HomeRecentCount);
        if (recentList.Count > 0)
        {
            list.Add(ContextMenuItem.Separator());
            list.AddRange(recentList.Select(playlist => ItemOf(LibraryActionEnum.AddToPlaylist, playlist.Name, () => AddToPlaylist(playlist.ID, mediaFileIDList), "playlist_add", graphic: ArtOf(playlist))));
        }

        return ContextMenuItem.Submenu(AppTexts.LibraryAddToPlaylist, list, "playlist_add");
    }

    // The graphic of a playlist, the size of a menu icon.
    private static RenderFragment ArtOf(ResponsePlaylist playlist) => @<PlaylistArt Hue="playlist.ArtHueCurrent" Size="var(--size-icon-md)"/>;

    private Task AddToPlaylist(Guid playlistID, List<Guid> mediaFileIDList)
    {
        return Show(ServiceLibraryAction.AddToPlaylist(playlistID, mediaFileIDList));
    }

    private Task AddToPlaylist(Guid playlistID)
    {
        return Show(ServiceLibraryAction.AddToPlaylist(playlistID, _playlistTargetList));
    }

}
