@inherits BaseComponentElement

<Dialog @attributes="AdditionalAttributes" class="@CssClass" Open="Open" OpenChanged="OpenChanged">
    <h2>@Title</h2>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p>@Message</p>
    }
    @if (!string.IsNullOrEmpty(Detail))
    {
        <p class="detail">@Detail</p>
    }
    @if (!string.IsNullOrEmpty(Warning))
    {
        <p class="warning">@Warning</p>
    }
    <div class="actions">
        <ButtonConfirm Status="AcceptStatus" OnConfirm="Accept">
            <ChildContent>@AcceptText</ChildContent>
            <ConfirmContent>@AppTexts.ConfirmActionAgain</ConfirmContent>
        </ButtonConfirm>
    </div>
</Dialog>

@code {

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Message { get; set; }

    // What comes after the message, a new line in it is a line break, for example how many of the rows are hidden by the search.
    [Parameter]
    public string? Detail { get; set; }

    // The line that must not be missed, after the rest and before the buttons: for example that it cannot be undone.
    [Parameter]
    public string? Warning { get; set; }

    [Parameter]
    public string? AcceptText { get; set; }

    // The colour of the accept button: red for something that cannot be undone.
    [Parameter]
    public StatusEnum AcceptStatus { get; set; } = StatusEnum.Highlight;

    [Parameter]
    public EventCallback<bool> OnSubmit { get; set; }

    private async Task Accept()
    {
        await OnSubmit.InvokeAsync(true);
        await OpenChanged.InvokeAsync(false);
    }

}
