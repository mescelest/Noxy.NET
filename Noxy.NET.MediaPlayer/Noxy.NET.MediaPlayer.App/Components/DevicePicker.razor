@inject IState<FeatureSessionState> StateSession
@inject IRemotePlaybackService ServiceRemote
@inject IPlaybackControlService ServiceControl
@inject IDeviceService ServiceDevice
@inherits BaseComponentElementFluxor
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes" class="@CssClass">
    <Button Type="@HTMLButtonTypeEnum.Button" class="trigger" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" disabled="@IsOffline" title="@IsOfflineReason" aria-haspopup="listbox" aria-expanded="@_open" popovertarget="@PopoverID">
        <span class="label">@DeviceLabel</span>
        <MaterialIcon Icon="devices" Size="var(--size-icon-sm)"/>
    </Button>

    <Popover @ref="_popover" ID="@PopoverID" @bind-Open="_open" Side="PlacementSideEnum.Top" Align="PlacementAlignEnum.End" class="list PopoverSurface">
        <div class="PopoverLabel">Choose device to play on</div>
        <ul class="devices" role="listbox">
            @foreach (ResponseDevice device in DeviceList)
            {
                ResponseDevice chosen = device;
                string name = chosen.DeviceID == _thisID ? $"{chosen.Name} (this device)" : chosen.Name;

                <li>
                    <button type="button" role="option" class="device PopoverRow" aria-selected="@chosen.IsActive" @onclick="() => Choose(chosen)">
                        <span class="name">@name</span>
                        @if (chosen.IsActive)
                        {
                            <MaterialIcon class="active" Icon="graphic_eq" Size="var(--size-icon-xs)" title="Playing" aria-label="Playing"/>
                        }
                    </button>
                </li>
            }

            @if (DeviceList.Count == 0)
            {
                <li class="none">No devices are online.</li>
            }
        </ul>
    </Popover>
</div>

@code {

    private const string PopoverIDPrefix = "device-picker-";

    private Popover? _popover;
    private bool _open;
    private Guid? _thisID;

    private string PopoverID { get; } = PopoverIDPrefix + Guid.NewGuid().ToString("N");
    private string? _movingTo;

    // Offline there is no live session to move: the button says why.
    private bool IsOffline => StateSession.Value.IsOffline || !ServiceRemote.IsOnline;
    private string? IsOfflineReason => IsOffline ? "Offline" : null;

    // Which device the music plays on, or that it is being moved.
    private string DeviceLabel => _movingTo is not null ? $"Moving playback to {_movingTo}…" : ServiceRemote.Role == PlaybackRoleEnum.Controller ? $"Playing on {ActiveName}" : "This device";

    private string ActiveName => ServiceRemote.DeviceList.FirstOrDefault(x => x.DeviceID == ServiceRemote.ActiveDeviceID)?.Name ?? "another device";

    // This device first, then the others in the order the server sent them.
    private List<ResponseDevice> DeviceList => [.. ServiceRemote.DeviceList.OrderByDescending(x => x.DeviceID == _thisID)];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _thisID = await ServiceDevice.GetDeviceID();
        ServiceRemote.Changed += OnChanged;
        ServiceControl.TransferFailed += OnTransferFailed;
    }

    private void OnChanged()
    {
        _movingTo = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnTransferFailed()
    {
        _movingTo = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Choose(ResponseDevice device)
    {
        if (_popover is not null)
        {
            await _popover.HideAsync();
        }

        // Moving to the device that already plays changes nothing and no update follows, so there is nothing to wait for.
        if (device.IsActive || (device.DeviceID == _thisID && ServiceRemote.Role != PlaybackRoleEnum.Controller))
        {
            return;
        }


        _movingTo = device.Name;
        try
        {
            await ServiceControl.Transfer(device.DeviceID);
        }
        catch (Exception)
        {
            _movingTo = null;
        }
    }

    public new async ValueTask DisposeAsync()
    {
        ServiceRemote.Changed -= OnChanged;
        ServiceControl.TransferFailed -= OnTransferFailed;
        await base.DisposeAsync();
    }

}
