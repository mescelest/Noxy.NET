@inject IState<FeatureSessionState> StateSession
@inject IState<FeatureLibraryState> StateLibrary
@inject IDispatcher Dispatcher
@inject ISessionService ServiceSession
@inject IAppStartupService ServiceStartup
@inject NavigationManager Navigation
@inherits BaseComponentElementFluxor

<header @attributes="AdditionalAttributes" class="@CssClass">
    <button type="button" class="icon-button" aria-label="Show or hide the sidebar" aria-expanded="@SidebarOpen" @onclick="OnToggleSidebar">
        <MaterialIcon Icon="menu" Size="var(--size-icon-md)"/>
    </button>

    <a class="logo" href="">Noxy Player</a>

    <form class="search" role="search" @onsubmit="GoToLibrary">
        <MaterialIcon Icon="search" Size="var(--size-icon-md)"/>
        <input type="search" placeholder="Search the library" aria-label="Search the library" value="@StateLibrary.Value.Search" @oninput="OnSearchInput"/>
    </form>

    <div class="right">
        @if (StateSession.Value.IsOffline)
        {
            <span class="offline" role="status">
                Offline
                @if (StateSession.Value.IsRetrying)
                {
                    <button type="button" class="link-button" @onclick="ServiceStartup.RetryNow">Try now</button>
                }
            </span>
        }

        <button type="button" class="text-button" @onclick="SignOut">Sign out</button>
    </div>
</header>

@code {

    [Parameter]
    public bool SidebarOpen { get; set; }

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private void OnSearchInput(ChangeEventArgs args)
    {
        Dispatcher.Dispatch(new ActionLibrarySearchChanged(args.Value?.ToString() ?? string.Empty));
        if (!Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("library", StringComparison.OrdinalIgnoreCase)) GoToLibrary();
    }

    private void GoToLibrary()
    {
        Navigation.NavigateTo("library");
    }

    private async Task SignOut()
    {
        await ServiceSession.SignOut();
    }

}
