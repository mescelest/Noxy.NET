@inject ISessionService ServiceSession
@inject IAppStartupService ServiceStartup
@inject IToastService ServiceToast
@inject NavigationManager Navigation
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <div class="container">
        <h1 class="logo">@AppTexts.AppName</h1>

        <Divider>
            <span>@AppTexts.LoginChooseServer</span>
        </Divider>

        <div class="configuration">
            <ServerPicker Disabled="IsBusy"/>
        </div>

        <Divider>
            <span>@AppTexts.LoginChooseLogin</span>
        </Divider>

        <div class="provider-list">
            <Button class="provider" Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.Error" Loading="@IsGoogleBusy" disabled="@IsBusy" @onclick="SignInGoogle">
                <MaterialIcon Icon="mail"/>
                @AppTexts.LoginGoogle
            </Button>
        </div>

        <Divider>
            <span>@AppTexts.LoginOr</span>
        </Divider>

        <TabSet class="login-tab-list">
            <TabPage Title="@AppTexts.AuthSignIn">
                <FormSignIn Disabled="@IsSignInDisabled" OnLoadingChanged="SetSignInBusy" OnSubmit="SubmitSignInHandler"/>
            </TabPage>
            <TabPage Title="@AppTexts.AuthSignUp">
                <FormSignUp Disabled="@IsSignUpDisabled" OnLoadingChanged="SetSignUpBusy" OnSubmit="SubmitSignUpHandler"/>
            </TabPage>
        </TabSet>
    </div>
</div>

@code {

    // The one source that is busy: everything else on the screen is disabled until it finishes.
    private LoginSourceEnum _busy = LoginSourceEnum.None;

    private bool IsBusy => _busy != LoginSourceEnum.None;

    private bool IsDisabled(LoginSourceEnum source) => IsBusy && _busy != source;

    private bool IsGoogleBusy => _busy == LoginSourceEnum.Google;

    private bool IsSignInDisabled => IsDisabled(LoginSourceEnum.SignIn);

    private bool IsSignUpDisabled => IsDisabled(LoginSourceEnum.SignUp);

    private void SetSignInBusy(bool loading)
    {
        SetBusy(LoginSourceEnum.SignIn, loading);
    }

    private void SetSignUpBusy(bool loading)
    {
        SetBusy(LoginSourceEnum.SignUp, loading);
    }

    private void SetBusy(LoginSourceEnum source, bool loading)
    {
        _busy = loading ? source : LoginSourceEnum.None;
    }

    private async Task SignInGoogle()
    {
        SetBusy(LoginSourceEnum.Google, true);
        try
        {
            await ServiceSession.SignInWithGoogle();
            await CompleteSignIn();
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToSignInMessage());
        }
        finally
        {
            SetBusy(LoginSourceEnum.Google, false);
        }
    }

    private async Task SubmitSignInHandler()
    {
        await CompleteSignIn();
    }

    private async Task SubmitSignUpHandler()
    {
        await CompleteSignIn();
    }

    private async Task CompleteSignIn()
    {
        await ServiceStartup.Connect();
        Navigation.NavigateTo("");
    }

}
