@inject ISessionService ServiceSession
@inject IAppStartupService ServiceStartup
@inject IServerAddressStorage StorageServerAddress
@inject NavigationManager Navigation
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <div class="container">
        <h1 class="logo">Noxy Player</h1>

        <Divider>
            <span>Choose server</span>
        </Divider>

        <div class="configuration">
            @if (_showAddress)
            {
                <FormServerAddress Disabled="IsDisabled(LoginSourceEnum.ServerAddress)" OnLoadingChanged="loading => SetBusy(LoginSourceEnum.ServerAddress, loading)" OnSubmit="SubmitServerAddressHandler"/>
            }
            else
            {
                <Button class="link-button" Type="@HTMLButtonTypeEnum.Button" Status="StatusEnum.Info" disabled="@IsBusy" @onclick="() => _showAddress = true">
                    Server: @_savedAddress (change)
                </Button>
            }
        </div>

        <Divider>
            <span>Choose login</span>
        </Divider>

        <div class="provider-list">
            <Button class="provider" Type="@HTMLButtonTypeEnum.Button" Status="StatusEnum.Notice" Loading="@(_busy == LoginSourceEnum.Google)" disabled="@IsBusy" @onclick="SignInGoogle">
                <MaterialIcon Icon="mail"/>
                Sign in with Gmail
            </Button>

            <MessageBox MessageList="_providerMessageList" Status="StatusEnum.Error"/>
        </div>

        <Divider>
            <span>or</span>
        </Divider>

        <TabSet class="login-tab-list">
            <TabPage Title="Sign in">
                <FormSignIn Disabled="IsDisabled(LoginSourceEnum.SignIn)" OnLoadingChanged="loading => SetBusy(LoginSourceEnum.SignIn, loading)" OnSubmit="SubmitSignInHandler"/>
            </TabPage>
            <TabPage Title="Sign up">
                <FormSignUp Disabled="IsDisabled(LoginSourceEnum.SignUp)" OnLoadingChanged="loading => SetBusy(LoginSourceEnum.SignUp, loading)" OnSubmit="SubmitSignUpHandler"/>
            </TabPage>
        </TabSet>
    </div>
</div>

@code {

    private List<string> _providerMessageList = [];

    private string? _savedAddress;
    private bool _showAddress;

    // The one source that is busy: everything else on the screen is disabled until it finishes.
    private LoginSourceEnum _busy = LoginSourceEnum.None;

    private bool IsBusy => _busy != LoginSourceEnum.None;

    private bool IsDisabled(LoginSourceEnum source) => IsBusy && _busy != source;

    private void SetBusy(LoginSourceEnum source, bool loading)
    {
        _busy = loading ? source : LoginSourceEnum.None;
    }

    protected override async Task OnInitializedAsync()
    {
        _savedAddress = await StorageServerAddress.GetAddress() ?? string.Empty;
        _showAddress = string.IsNullOrWhiteSpace(_savedAddress);
    }

    private void SubmitServerAddressHandler(string address)
    {
        _showAddress = false;
        _savedAddress = address;
    }

    private async Task SignInGoogle()
    {
        SetBusy(LoginSourceEnum.Google, true);
        try
        {
            _providerMessageList = [];
            await ServiceSession.SignInWithGoogle();
            await CompleteSignIn();
        }
        catch (Exception exception)
        {
            _providerMessageList = [exception.ToSignInMessage()];
        }
        finally
        {
            SetBusy(LoginSourceEnum.Google, false);
        }
    }

    private async Task SubmitSignInHandler()
    {
        await CompleteSignIn();
    }

    private async Task SubmitSignUpHandler()
    {
        await CompleteSignIn();
    }

    private async Task CompleteSignIn()
    {
        await ServiceStartup.Connect();
        Navigation.NavigateTo("");
    }

}
