@inject ISettingService ServiceSetting
@inject ISyncService ServiceSync
@inherits BaseComponentElement
@using System.Text.Json
@implements IDisposable

<div @attributes="AdditionalAttributes" class="@CssClass">
    @if (IsOffline)
    {
        <MessageBox MessageList="OfflineMessageList" Status="StatusEnum.None"/>
    }
    @foreach (ResponseSetting setting in ShownList)
    {
        <div class="setting" @key="(setting.Key, _resetCount)">
            <div class="text">
                <span class="label">@LabelOf(setting.Key)</span>
                <span class="help">@HelpOf(setting.Key)</span>
                @if (_errorMap.TryGetValue(setting.Key, out string? error))
                {
                    <span class="error">@error</span>
                }
            </div>
            @switch (setting.ValueType)
            {
                case SettingValueTypeEnum.Boolean:
                    <InputControlCheckbox Option="true" aria-label="@LabelOf(setting.Key)" Disabled="@IsOffline" @bind-Value:get="@AsBool(setting)" @bind-Value:set="value => Save(setting, value)"/>
                    break;
                case SettingValueTypeEnum.Integer:
                    SettingDeclarationInteger? integer = SettingCatalog.Find(setting.Key) as SettingDeclarationInteger;
                    <InputControlInteger class="integer" Size="2" Min="integer?.Minimum" Max="integer?.Maximum" Value="@AsInteger(setting)" ValueChanged="value => SaveInteger(setting, value)" disabled="@IsOffline" aria-label="@LabelOf(setting.Key)"/>
                    break;
                case SettingValueTypeEnum.Enum:
                    <select disabled="@IsOffline" aria-label="@LabelOf(setting.Key)" @onchange="args => Save(setting, args.Value?.ToString() ?? string.Empty)">
                        @foreach (string name in MemberNameList(setting.Key))
                        {
                            <option value="@name" selected="@IsSelected(setting, name)">@name</option>
                        }
                    </select>
                    break;
                default:
                    throw new InvalidEnumArgumentException(nameof(setting.ValueType), (int)setting.ValueType, typeof(SettingValueTypeEnum));
            }
        </div>
    }
</div>

@code {

    private List<ResponseSetting> _settingList = [];
    private readonly Dictionary<string, string> _errorMap = [];

    // Raised after a refused write so the inputs are drawn again with the value that is stored.
    private int _resetCount;

    // Shuffle and repeat are set from the player bar, so they are not offered here.
    private List<ResponseSetting> ShownList => [.. _settingList.Where(x => x.Key is not (SettingKey.Shuffle or SettingKey.Repeat))];

    private string? OfflineReason => ServiceSync.IsOffline ? PresentationTexts.ActionMessageOffline : null;
    private bool IsOffline => OfflineReason is not null;
    private List<string> OfflineMessageList => [$"{OfflineReason} They are read-only until the server can be reached."];

    protected override async Task OnInitializedAsync()
    {
        ServiceSetting.Changed += OnChanged;
        ServiceSync.Changed += OnChanged;
        await Load();
    }

    private void OnChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        });
    }

    private async Task Load()
    {
        _settingList = await ServiceSetting.GetSettingList();
    }

    // The server is the authority: a refused write leaves the value as it was and shows the reason.
    private async Task Save(ResponseSetting setting, object value)
    {
        _errorMap.Remove(setting.Key);
        try
        {
            await ServiceSetting.Update(setting.Key, JsonSerializer.SerializeToElement(value));
        }
        catch (Exception exception)
        {
            _errorMap[setting.Key] = exception.ToActionMessage();
            _resetCount++;
        }

        await Load();
    }

    // The field gives no number for text that is not one; the range is the server's to refuse.
    private Task SaveInteger(ResponseSetting setting, int? number)
    {
        if (number is null)
        {
            _errorMap[setting.Key] = "Enter a whole number.";
            _resetCount++;
            return Task.CompletedTask;
        }

        return Save(setting, number.Value);
    }

    // A setting the server has that this page has no text for is shown by its key, so it can still be changed.
    private static string LabelOf(string key)
    {
        return key switch
        {
            SettingKey.MergeOnRename => AppTexts.SettingMergeOnRename,
            SettingKey.KeepQueuedItems => AppTexts.SettingKeepQueuedItems,
            SettingKey.PrefetchCount => AppTexts.SettingPrefetchCount,
            _ => key
        };
    }

    private static string? HelpOf(string key)
    {
        return key switch
        {
            SettingKey.MergeOnRename => AppTexts.SettingMergeOnRenameHelp,
            SettingKey.KeepQueuedItems => AppTexts.SettingKeepQueuedItemsHelp,
            SettingKey.PrefetchCount => AppTexts.SettingPrefetchCountHelp,
            _ => null
        };
    }

    private static bool AsBool(ResponseSetting setting) => setting.Value is JsonElement element ? element.ValueKind == JsonValueKind.True : setting.Value is true;

    private static int? AsInteger(ResponseSetting setting) => int.TryParse(AsText(setting), NumberStyles.Integer, CultureInfo.InvariantCulture, out int number) ? number : null;

    private static bool IsSelected(ResponseSetting setting, string name) => name == AsText(setting);

    private static string AsText(ResponseSetting setting) => setting.Value is JsonElement element ? element.ToString() : setting.Value.ToString() ?? string.Empty;

    private static IReadOnlyList<string> MemberNameList(string key) => SettingCatalog.Find(key) is SettingDeclarationEnum declaration ? declaration.MemberNameList : [];

    public void Dispose()
    {
        ServiceSetting.Changed -= OnChanged;
        ServiceSync.Changed -= OnChanged;
    }

}
