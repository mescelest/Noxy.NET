@inject NavigationManager Navigation
@inherits BaseComponentElement
@using System.Web
@implements IDisposable

<div @attributes="AdditionalAttributes" class="@CssClass">
    <div class="duration">
        <span class="time">@Time</span>
    </div>

    <div class="volume">
        <MaterialIcon Icon="volume_up" Size="var(--size-icon-md)"/>
        <input type="range" min="0" max="100" step="1" value="@VolumeCurrent" aria-label="Volume" @oninput="InputVolumeHandler" @onchange="ChangeVolumeHandler"/>
    </div>

    <Button Type="@HTMLButtonTypeEnum.Button" class="queue" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" aria-label="Queue" aria-pressed="@QueuePressedValue" @onclick="ClickQueueHandler">
        <MaterialIcon class="queue-icon" Icon="playlist_play" Size="var(--size-icon-sm)"/>
    </Button>

    <DevicePicker/>
</div>

@code {

    [Parameter, EditorRequired]
    public required PlaybackDisplay Display { get; set; }

    // Each step of a drag, in percent.
    [Parameter]
    public EventCallback<int> OnVolumePreview { get; set; }

    // The volume the slider was left at, in percent.
    [Parameter]
    public EventCallback<int> OnVolumeChanged { get; set; }

    // The query parameter that carries the page the user was on when the queue button took them to the queue page.
    private const string ReturnUrlParameter = nameof(ReturnUrl);

    private string RelativePath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool IsOnQueue => RelativePath == Queue.Route;

    // Where the queue button goes back to: the page in the return url, or the start page when there is none or it points outside the app.
    private string ReturnUrl
    {
        get
        {
            string? value = HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)[ReturnUrlParameter];

            return value is not null && Navigation.ToAbsoluteUri(value).ToString().StartsWith(Navigation.BaseUri, StringComparison.Ordinal) ? value : string.Empty;
        }
    }

    private string QueuePressedValue => IsOnQueue.ToString().ToLowerInvariant();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    // On the queue page the button goes back to the return url; anywhere else it opens the queue page with the current page as the return url.
    private void ClickQueueHandler()
    {
        if (IsOnQueue)
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo($"{Queue.Route}?{ReturnUrlParameter}={Uri.EscapeDataString(Navigation.Uri)}");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private int? _dragVolume;
    private int? _committedVolume;

    private int VolumeCurrent => _dragVolume ?? Display.VolumePercent;

    private string Time => $"{Format(Display.Position)} / {Format(Display.Duration)}";

    private static string Format(TimeSpan time) => $"{(int)time.TotalMinutes}:{time.Seconds:00}";

    private static double ParseDouble(object? value) => double.TryParse(value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double result) ? result : 0;

    // The slider moves in whole percent; rounding, not cutting, so a value read as 69.9999 is 70.
    private static int ParseVolume(object? value) => (int)Math.Round(ParseDouble(value));

    private Task InputVolumeHandler(ChangeEventArgs args)
    {
        int volume = ParseVolume(args.Value);

        // The webview can report the end of a gesture as the change first and the last input after it (seen on the seek bar), so an input that repeats the value just committed is the tail of that gesture, not a new drag.
        bool isTail = _committedVolume == volume;
        _committedVolume = null;
        if (isTail) return Task.CompletedTask;

        _dragVolume = volume;

        return OnVolumePreview.InvokeAsync(volume);
    }

    // The value comes from the event itself, so the release counts whichever of the two events came first.
    private Task ChangeVolumeHandler(ChangeEventArgs args)
    {
        int volume = ParseVolume(args.Value);
        _committedVolume = volume;
        _dragVolume = null;

        return OnVolumeChanged.InvokeAsync(volume);
    }

}
