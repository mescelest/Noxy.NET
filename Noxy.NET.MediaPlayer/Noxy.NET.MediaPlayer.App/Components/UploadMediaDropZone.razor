@inject IUploadService ServiceUpload
@inject ISyncService ServiceSync
@inject IToastService ServiceToast
@inherits BaseComponentElement
@implements IDisposable

<div @attributes="AdditionalAttributes" class="@CssClass">
    <FileDropZone class="zone" Accept="@AcceptAudio" Disabled="@IsOffline" OnSelected="SelectedHandler" OnRejected="RejectedHandler">
        <DraggingContent>
            <div class="hint">
                <MaterialIcon Icon="upload_file" Size="var(--size-icon-xl)"/>
                <span>@HintText</span>
            </div>
        </DraggingContent>
        <ChildContent>
            @ChildContent
        </ChildContent>
    </FileDropZone>
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The playlist the files are added to once they are in the library. Null uploads to the library alone.
    [Parameter]
    public Guid? PlaylistID { get; set; }

    private const string AcceptAudio = "audio/*";

    private bool IsOffline => ServiceSync.IsOffline;

    private string HintText => PlaylistID is null ? "Drop audio files to add them to your library" : "Drop audio files to add them to your library and this playlist";

    protected override void OnInitialized()
    {
        ServiceSync.Changed += OnSyncChanged;
    }

    private void OnSyncChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SelectedHandler(List<IBrowserFile> fileList)
    {
        await ServiceUpload.Upload(fileList.ToUploadFileList(), PlaylistID);
    }

    private void RejectedHandler(List<IBrowserFile> fileList)
    {
        ServiceToast.ShowWarning(fileList.Count.ToCountText(AppTexts.UploadSkippedOne, AppTexts.UploadSkippedMany));
    }

    public void Dispose()
    {
        ServiceSync.Changed -= OnSyncChanged;
    }

}
