@inject IState<FeaturePlaylistListState> StatePlaylistList
@inherits FluxorElementComponent

<nav @attributes="AdditionalAttributes" class="@CssClass" aria-label="Main">
    <Collapsible Collapsed="false" ToggleLabel="Your music">
        <Header>
            <span class="section-title">Your music</span>
        </Header>
        <Content>
            <NavLink class="link" href="" Match="NavLinkMatch.All" @onclick="OnNavigate">
                <MaterialIcon Icon="home" Size="var(--size-icon-md)"/>
                Home
            </NavLink>
            <NavLink class="link" href="library" @onclick="OnNavigate">
                <MaterialIcon Icon="library_music" Size="var(--size-icon-md)"/>
                Library
            </NavLink>
            <NavLink class="link" href="account" @onclick="OnNavigate">
                <MaterialIcon Icon="account_circle" Size="var(--size-icon-md)"/>
                Account
            </NavLink>
            <NavLink class="link" href="settings" @onclick="OnNavigate">
                <MaterialIcon Icon="settings" Size="var(--size-icon-md)"/>
                Settings
            </NavLink>
        </Content>
    </Collapsible>

    <Collapsible Collapsed="false" ToggleLabel="Integrations">
        <Header>
            <span class="section-title">Integrations</span>
        </Header>
        <Content>
            <NavLink class="link" href="youtube" @onclick="OnNavigate">
                <MaterialIcon Icon="radio" Size="var(--size-icon-md)"/>
                YouTube
            </NavLink>
            <NavLink class="link" href="bandcamp" @onclick="OnNavigate">
                <MaterialIcon Icon="music_note" Size="var(--size-icon-md)"/>
                Bandcamp
            </NavLink>
        </Content>
    </Collapsible>

    <Collapsible Collapsed="false" ToggleLabel="Playlists">
        <Header>
            <span class="section-title">Playlists</span>
        </Header>
        <Content>
            <button type="button" class="link new-playlist" @onclick="NewPlaylist">
                <MaterialIcon Icon="add" Size="var(--size-icon-md)"/>
                New playlist
            </button>
            @foreach (ResponsePlaylist playlist in PlaylistList)
            {
                <NavLink class="link" href="@($"playlist/{playlist.ID}")" @onclick="OnNavigate">@playlist.Name</NavLink>
            }
        </Content>
    </Collapsible>

    <NewPlaylistDialog Open="_newPlaylistOpen" OpenChanged="SetNewPlaylistOpen"/>
</nav>

@code {

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _newPlaylistOpen;

    // Most recently played first, then the ones never played, newest modified first.
    private List<ResponsePlaylist> PlaylistList => StatePlaylistList.Value.PlaylistList.OrderMostRecentlyPlayedFirst();

    private void NewPlaylist()
    {
        _newPlaylistOpen = true;
    }

    // A narrow window hides the sidebar when it is told to navigate, and a dialog inside a hidden sidebar cannot show, so that waits until the dialog has closed.
    private async Task SetNewPlaylistOpen(bool open)
    {
        _newPlaylistOpen = open;
        if (!open) await OnNavigate.InvokeAsync();
    }

}
