@inject IServerAddressStorage StorageServerAddress
@inject IJSRuntime JS
@inherits BaseComponentElement
@using Noxy.NET.UI.Extensions
@implements IAsyncDisposable

<Dialog @attributes="AdditionalAttributes" class="@CssClass" Size="DialogSizeEnum.Medium" Open="Open" OpenChanged="HandleOpenChanged">
    <div class="header">
        <h2>@AppTexts.ServerDialogTitle</h2>
        <Button class="add" Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.Success" IsIcon="true" disabled="@_isAdding" aria-label="@AppTexts.ServerDialogAdd" title="@AppTexts.ServerDialogAdd" @onclick="Add">
            <MaterialIcon Icon="add" Size="var(--size-icon-sm)"/>
        </Button>
    </div>

    @if (_addressList.Count == 0 && !_isAdding)
    {
        <p class="empty">@AppTexts.ServerDialogEmpty</p>
    }
    else
    {
        <ul class="server-list">
            @foreach (string address in _addressList)
            {
                <li @key="address" class="server" @onkeydown="HandleKeyDown">
                    @if (IsEditing(address))
                    {
                        <Button class="cancel" Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" IsIcon="true" aria-label="@AppTexts.CommonCancel" title="@AppTexts.CommonCancel" @onclick="Cancel">
                            <MaterialIcon Icon="arrow_back" Size="var(--size-icon-sm)"/>
                        </Button>
                        <InputControlText class="address" Size="1" aria-label="@AppTexts.ServerDialogAddress" autofocus="true" OnInputDelay="0" @bind-Value:get="_draft" @bind-Value:set="ChangeDraft"/>
                        <Button class="save" Type="@HTMLButtonTypeEnum.Button" Status="StatusEnum.Highlight" IsIcon="true" aria-label="@AppTexts.CommonSave" title="@AppTexts.CommonSave" @onclick="Save">
                            <MaterialIcon Icon="check" Size="var(--size-icon-xs)"/>
                        </Button>
                    }
                    else
                    {
                        <Button class="delete" Type="@HTMLButtonTypeEnum.Button" Appearance="@DeleteAppearanceOf(address)" Status="StatusEnum.Error" IsIcon="true" data-confirming="@IsConfirming(address)"
                                aria-label="@DeleteLabelOf(address)" title="@DeleteLabelOf(address)" @onclick="() => Delete(address)">
                            <MaterialIcon Icon="@DeleteIconOf(address)" Size="var(--size-icon-sm)"/>
                        </Button>
                        <span class="address">@address</span>
                        <Button class="edit" Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.None" IsIcon="true" aria-label="@AppTexts.CommonEdit" title="@AppTexts.CommonEdit" @onclick="() => Edit(address)">
                            <MaterialIcon Icon="edit" Size="var(--size-icon-xs)"/>
                        </Button>
                    }
                </li>
            }
            @if (_isAdding)
            {
                <li class="server" @onkeydown="HandleKeyDown">
                    <Button class="cancel" Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" IsIcon="true" aria-label="@AppTexts.CommonCancel" title="@AppTexts.CommonCancel" @onclick="Cancel">
                        <MaterialIcon Icon="arrow_back" Size="var(--size-icon-sm)"/>
                    </Button>
                    <InputControlText class="address" Size="1" aria-label="@AppTexts.ServerDialogAddress" placeholder="https://" autofocus="true" OnInputDelay="0" @bind-Value:get="_draft" @bind-Value:set="ChangeDraft"/>
                    <Button class="save" Type="@HTMLButtonTypeEnum.Button" Status="StatusEnum.Highlight" IsIcon="true" aria-label="@AppTexts.CommonSave" title="@AppTexts.CommonSave" @onclick="Save">
                        <MaterialIcon Icon="check" Size="var(--size-icon-xs)"/>
                    </Button>
                </li>
            }
        </ul>
    }

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
</Dialog>

@code {

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    // Raised after a server was added, edited or removed, so the picker follows.
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<string> _addressList = [];
    private bool _wasOpen;

    // The saved address whose row is being edited in place, or null; a new server is typed into an extra row at the end of the list.
    private string? _editing;
    private bool _isAdding;
    private string _draft = string.Empty;
    private string? _error;

    // The address whose delete button was clicked once: a second click removes it.
    private string? _confirming;

    private bool IsEditing(string address) => _editing == address;

    private bool IsConfirming(string address) => _confirming == address;

    private string DeleteLabelOf(string address) => IsConfirming(address) ? AppTexts.ServerDialogConfirmDelete : AppTexts.CommonDelete;

    // The first click is a quiet cross; the second, which removes the server, is a filled check.
    private ButtonAppearanceEnum DeleteAppearanceOf(string address) => IsConfirming(address) ? ButtonAppearanceEnum.Filled : ButtonAppearanceEnum.Ghost;

    private string DeleteIconOf(string address) => IsConfirming(address) ? "check" : "close";

    private const string FunctionWatchOutsideClick = "WatchOutsideClick";
    private const string SelectorConfirming = "[data-confirming]";

    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;
    private DotNetObjectReference<ServerManageDialog>? _reference;
    private bool _watching;
    private bool _disposed;

    // A click outside the delete button that waits for its second click cancels it, without blocking what was clicked instead.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await SyncWatchAsync();
    }

    private async Task SyncWatchAsync()
    {
        if (_disposed || Open == _watching) return;

        _watching = Open;
        if (Open)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(ServerManageDialog), true));
            _reference ??= DotNetObjectReference.Create(this);
            _watch = await _module.InvokeAsync<IJSObjectReference>(FunctionWatchOutsideClick, _reference, nameof(ClickedOutside), SelectorConfirming);
        }
        else if (_watch is not null)
        {
            await StopWatchAsync();
        }
    }

    private async Task StopWatchAsync()
    {
        IJSObjectReference? watch = _watch;
        _watch = null;
        if (watch is null) return;

        try
        {
            await watch.InvokeVoidAsync("dispose");
            await watch.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    [JSInvokable]
    public async Task ClickedOutside()
    {
        if (_confirming is null) return;

        _confirming = null;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;
        await StopWatchAsync();
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }

        _reference?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Open == _wasOpen) return;

        _wasOpen = Open;
        if (!Open) return;

        _confirming = null;
        await Load();

        // Nothing saved yet: the first thing to do is to add a server.
        StartEditing(null, _addressList.Count == 0);
    }

    private void StartEditing(string? address, bool isAdding)
    {
        _editing = address;
        _isAdding = isAdding;
        _draft = address ?? string.Empty;
        _error = null;
    }

    private async Task Load()
    {
        _addressList = await StorageServerAddress.GetAddressList();
    }

    private Task HandleOpenChanged(bool open)
    {
        return open ? Task.CompletedTask : Close();
    }

    private async Task Close()
    {
        await OpenChanged.InvokeAsync(false);
    }

    private void Add()
    {
        _confirming = null;
        StartEditing(null, true);
    }

    private void Edit(string address)
    {
        _confirming = null;
        StartEditing(address, false);
    }

    private void Cancel()
    {
        StartEditing(null, false);
    }

    private void ChangeDraft(string? value)
    {
        _draft = value ?? string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == KeyEnter)
        {
            await Save();
        }
    }

    private const string KeyEnter = "Enter";

    private async Task Save()
    {
        try
        {
            if (_editing is null)
            {
                await StorageServerAddress.SetAddress(_draft);
            }
            else
            {
                await StorageServerAddress.ReplaceAddress(_editing, _draft);
            }
        }
        catch (ArgumentException)
        {
            _error = PresentationTexts.ServerAddressInvalid;
            return;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
            return;
        }

        StartEditing(null, false);
        await Load();
        await OnChanged.InvokeAsync();
    }

    private async Task Delete(string address)
    {
        if (_confirming != address)
        {
            _confirming = address;
            return;
        }

        _confirming = null;
        await StorageServerAddress.RemoveAddress(address);
        await Load();
        await OnChanged.InvokeAsync();
    }

}
