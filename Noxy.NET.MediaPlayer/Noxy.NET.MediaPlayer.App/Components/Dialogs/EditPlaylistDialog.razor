@inject IState<FeaturePlaylistListState> StatePlaylistList
@inherits BaseComponentElementFluxor

<Dialog @attributes="AdditionalAttributes" class="@CssClass" Open="Open" OpenChanged="HandleOpenChanged">
    <h2>@AppTexts.EditPlaylistTitle</h2>
    @if (Open && Playlist is { } playlist)
    {
        <FormEditPlaylist Playlist="playlist" OnSubmit="Close"/>
    }
</Dialog>

@code {

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired]
    public Guid PlaylistID { get; set; }

    private ResponsePlaylist? Playlist => StatePlaylistList.Value.PlaylistList.FirstOrDefault(x => x.ID == PlaylistID);

    private Task HandleOpenChanged(bool open)
    {
        return open ? Task.CompletedTask : Close();
    }

    private async Task Close()
    {
        await OpenChanged.InvokeAsync(false);
    }

}
