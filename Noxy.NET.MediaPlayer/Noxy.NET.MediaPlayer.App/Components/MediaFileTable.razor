@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <Table class="table" data-empty="@IsEmpty" data-grip="@HasGrip" RowCount="RowList.Count">
        <TableHeader class="header">
            <div class="action-row">
                @ToolContent
            </div>
            <div class="header-row">
                @if (HasGrip)
                {
                    <TableCell class="cell"></TableCell>
                }
                <TableCell class="cell">
                    <InputControlCheckbox Option="true" aria-label="Select all shown" @bind-Value:get="@AllSelected" @bind-Value:set="ChangeAllHandler"/>
                </TableCell>
                <TableCell class="cell">
                    <MaterialIcon Icon="download_for_offline" Size="var(--size-icon-sm)"/>
                </TableCell>
                <SortHeaderCell class="cell sort" Direction="DirectionOf(LibrarySortEnum.Title)" OnClick="() => ClickSortHandler(LibrarySortEnum.Title)"><strong>Title</strong></SortHeaderCell>
                <SortHeaderCell class="cell sort" Direction="DirectionOf(LibrarySortEnum.Artist)" OnClick="() => ClickSortHandler(LibrarySortEnum.Artist)"><strong>Artist</strong></SortHeaderCell>
                <SortHeaderCell class="cell sort" Direction="DirectionOf(LibrarySortEnum.Album)" OnClick="() => ClickSortHandler(LibrarySortEnum.Album)"><strong>Album</strong></SortHeaderCell>
                <SortHeaderCell class="cell sort" Direction="DirectionOf(LibrarySortEnum.Year)" OnClick="() => ClickSortHandler(LibrarySortEnum.Year)"><strong>Year</strong></SortHeaderCell>
                <SortHeaderCell class="cell sort" Direction="DirectionOf(LibrarySortEnum.TimeCreated)" OnClick="() => ClickSortHandler(LibrarySortEnum.TimeCreated)"><strong>Added</strong></SortHeaderCell>
            </div>
        </TableHeader>

        @if (IsEmpty)
        {
            <div class="empty">
                <MaterialIcon Icon="library_music" Size="var(--size-icon-xxl)"/>
                <h2>@EmptyTitle</h2>
                @if (EmptyDescription is not null)
                {
                    <p>@EmptyDescription</p>
                }
                @EmptyContent
            </div>
        }
        else
        {
            <TableBodyVirtualize T="MediaFileTableRow" class="body" List="RowList" ItemSize="48" Context="entry">
                <div @key="entry.Row.Key" class="row-menu" @oncontextmenu="args => ContextMenuHandler(args, entry.Row)" @oncontextmenu:preventDefault
                     @ondragover="() => DragOverHandler(entry.Row)" @ondragover:preventDefault @ondrop="() => DropHandler(entry.Row)" @ondrop:preventDefault>
                    <TableRow class="row" Index="entry.Index" draggable="@DraggableValue" data-over="@IsOver(entry.Row)"
                              @ondblclick="() => PlayHandler(entry.Row)" @ondragstart="() => DragStartHandler(entry.Row)">
                        @if (HasGrip)
                        {
                            <TableCell class="cell grip" data-disabled="@IsGripDisabled" title="@ReorderHint" aria-hidden="true">
                                <MaterialIcon Icon="drag_indicator" Size="var(--size-icon-md)"/>
                            </TableCell>
                        }
                        <TableCell class="cell">
                            <InputControlCheckbox Option="true" aria-label="@SelectLabel(entry.Row)" @bind-Value:get="@IsSelected(entry.Row)" @bind-Value:set="_ => ChangeSelectedHandler(entry.Row)"/>
                        </TableCell>
                        <TableCell class="cell">
                            <FileStatusIcon State="StateOf(entry.Row)"/>
                        </TableCell>
                        <TableCell class="cell" Kind="TableCellKindEnum.RowHeader">@entry.Row.MediaFile.Title</TableCell>
                        <TableCell class="cell">@entry.Row.MediaFile.Artist</TableCell>
                        <TableCell class="cell">@entry.Row.MediaFile.Album</TableCell>
                        <TableCell class="cell">@entry.Row.MediaFile.Year</TableCell>
                        <TableCell class="cell">@entry.Row.MediaFile.TimeCreated.ToLocalTime().ToString("d")</TableCell>
                    </TableRow>
                </div>
            </TableBodyVirtualize>
        }
    </Table>
</div>

@code {

    [Parameter, EditorRequired]
    public required List<MediaFileTableRow> RowList { get; set; }

    // The state of each media file on this device, by media file ID.
    [Parameter]
    public Dictionary<Guid, FileSyncStateEnum> StateMap { get; set; } = [];

    // The column the rows are sorted by, or none.
    [Parameter]
    public LibrarySortEnum? Sort { get; set; }

    [Parameter]
    public bool Descending { get; set; }

    [Parameter]
    public EventCallback<LibrarySortEnum> OnSortChanged { get; set; }

    // The keys of the ticked rows.
    [Parameter]
    public IReadOnlySet<Guid> SelectedSet { get; set; } = new HashSet<Guid>();

    [Parameter]
    public bool AllSelected { get; set; }

    [Parameter]
    public EventCallback OnToggleAll { get; set; }

    [Parameter]
    public EventCallback<Guid> OnToggleRow { get; set; }

    // A double-click on a row.
    [Parameter]
    public EventCallback<MediaFileTableRow> OnPlay { get; set; }

    [Parameter]
    public EventCallback<(MouseEventArgs Args, MediaFileTableRow Row)> OnContextMenu { get; set; }

    // A grip column shows only when the host listens to OnMove. It is dimmed, and cannot start a drag, while this is false.
    [Parameter]
    public bool IsReorderable { get; set; }

    // Why the rows cannot be dragged now, shown as the grip's tooltip.
    [Parameter]
    public string? ReorderHint { get; set; }

    // The dragged row's key, then the key of the row it was dropped on.
    [Parameter]
    public EventCallback<(Guid DragKey, Guid TargetKey)> OnMove { get; set; }

    // The action row above the column headers: the search box and the buttons.
    [Parameter]
    public RenderFragment? ToolContent { get; set; }

    // When IsEmpty a box takes the place of the rows: what is empty, a short explanation, and what can be done about it.
    [Parameter]
    public string? EmptyTitle { get; set; }

    [Parameter]
    public string? EmptyDescription { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public bool IsEmpty { get; set; }

    private Guid? _dragKey;
    private Guid? _overKey;

    private bool HasGrip => OnMove.HasDelegate;

    private bool IsGripDisabled => !IsReorderable;

    private string DraggableValue => IsReorderable.ToString().ToLowerInvariant();

    private bool IsOver(MediaFileTableRow row) => _overKey == row.Key;

    private static string SelectLabel(MediaFileTableRow row) => $"Select {row.MediaFile.Title}";

    private bool IsSelected(MediaFileTableRow row) => SelectedSet.Contains(row.Key);

    private FileSyncStateEnum StateOf(MediaFileTableRow row) => StateMap.GetValueOrDefault(row.MediaFile.ID, FileSyncStateEnum.NotDownloaded);

    private SortDirectionEnum DirectionOf(LibrarySortEnum column)
    {
        if (Sort != column) return SortDirectionEnum.None;

        return Descending ? SortDirectionEnum.Descending : SortDirectionEnum.Ascending;
    }

    private Task ClickSortHandler(LibrarySortEnum column) => OnSortChanged.InvokeAsync(column);

    // The host toggles: the new value of the box is already what its state will say once it has changed.
    private Task ChangeAllHandler(bool selected) => OnToggleAll.InvokeAsync();

    private Task ChangeSelectedHandler(MediaFileTableRow row) => OnToggleRow.InvokeAsync(row.Key);

    private Task PlayHandler(MediaFileTableRow row) => OnPlay.InvokeAsync(row);

    private Task ContextMenuHandler(MouseEventArgs args, MediaFileTableRow row) => OnContextMenu.InvokeAsync((args, row));

    private void DragStartHandler(MediaFileTableRow row)
    {
        if (!IsReorderable) return;

        _dragKey = row.Key;
    }

    private void DragOverHandler(MediaFileTableRow row)
    {
        if (_dragKey is null) return;

        _overKey = row.Key;
    }

    private async Task DropHandler(MediaFileTableRow target)
    {
        Guid? dragged = _dragKey;
        _dragKey = null;
        _overKey = null;
        if (dragged is null || dragged == target.Key || !IsReorderable) return;

        await OnMove.InvokeAsync((dragged.Value, target.Key));
    }

}
