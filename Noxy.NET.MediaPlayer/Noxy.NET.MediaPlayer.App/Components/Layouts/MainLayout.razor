@inject IState<FeatureSessionState> StateSession
@inject IDispatcher Dispatcher
@inherits BaseComponentLayoutFluxor

<CascadingValue Value="Context">
    @* <NarrowWatcher OnChanged="OnNarrowChanged"/> *@

    @if (!StateSession.Value.IsRestored)
    {
        <Loader Loading="true"/>
    }
    else if (!StateSession.Value.HasSession)
    {
        <Login/>
    }
    else
    {
        @Body
    }

    <ToastRenderer/>
    <UploadNotifier/>
</CascadingValue>

@code {

    private bool _isNarrow;

    private AppStateEnum State => !StateSession.Value.IsRestored ? AppStateEnum.Starting : !StateSession.Value.HasSession ? AppStateEnum.SignedOut : AppStateEnum.SignedIn;
    private AppSessionContext Context => new(State, _isNarrow);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new ActionShellStarted());
    }

    private void OnNarrowChanged(bool narrow)
    {
        _isNarrow = narrow;
    }

}
