@inject IJSRuntime JS
@using Noxy.NET.UI.Extensions
@implements IAsyncDisposable

@code {

    [Parameter]
    public EventCallback<bool> OnChanged { get; set; }

    private const string FunctionIsNarrow = "IsNarrow";
    private const string FunctionWatch = "Watch";
    private const string FunctionUnwatch = "Unwatch";

    // The script module is shared by every watcher, so each one names its own listener.
    private readonly string _key = Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private DotNetObjectReference<NarrowWatcher>? _reference;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender || _disposed) return;

        IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(NarrowWatcher), local: true));

        // The component can be disposed while the module loads: then nobody else releases it.
        if (_disposed)
        {
            await ReleaseModuleAsync(module);
            return;
        }

        _module = module;
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync(FunctionWatch, _key, _reference, nameof(Changed));
        await OnChanged.InvokeAsync(await _module.InvokeAsync<bool>(FunctionIsNarrow));
    }

    [JSInvokable]
    public Task Changed(bool narrow)
    {
        return InvokeAsync(() => OnChanged.InvokeAsync(narrow));
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;
        if (_module is not null)
        {
            await ReleaseModuleAsync(_module);
        }

        _reference?.Dispose();
    }

    // The listener is stopped before the module is let go, so nothing calls into the reference afterwards.
    private async Task ReleaseModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync(FunctionUnwatch, _key);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

}
