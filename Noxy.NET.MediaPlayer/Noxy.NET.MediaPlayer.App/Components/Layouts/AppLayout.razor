@layout MainLayout
@inject IState<FeatureShellState> StateShell
@inject IDispatcher Dispatcher
@inherits BaseComponentLayoutFluxor

<div class="@CssClass">
    <header>
        <HeaderElement/>
    </header>

    <div class="content">
        <aside data-open="@SidebarOpen">
            <SidebarElement/>
        </aside>

        <main>
            @Body
        </main>
    </div>

    <footer>
        <FooterElement/>
    </footer>
</div>

@code {

    private bool SidebarOpen => StateShell.Value.SidebarOpen;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new ActionShellStarted());
    }

}
