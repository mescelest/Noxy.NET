@inject ISessionService ServiceSession
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <WebForm T="FormModelSignUp" Context="_context" OnSubmit="Submit" Disabled="Disabled">
        <InputGroupText @bind-Value="_context.Model.Email"/>
        <InputGroupPassword @bind-Value="_context.Model.Password"/>
        <Button Type="@HTMLButtonTypeEnum.Submit" Status="StatusEnum.Highlight" Loading="@LoadingCurrent">@AppTexts.AuthSignUp</Button>
    </WebForm>
</div>

@code {

    [Parameter]
    public bool? Loading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<bool> OnLoadingChanged { get; set; }
    private bool LoadingCurrent => Loading ?? _context.IsSubmitting;

    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    private readonly WebFormContext<FormModelSignUp> _context = new(new());

    private async Task Submit(WebFormContext<FormModelSignUp> context)
    {
        await OnLoadingChanged.InvokeAsync(true);
        try
        {
            await ServiceSession.SignUp(context.Model.Email, context.Model.Password);
            await OnSubmit.InvokeAsync();
        }
        finally
        {
            await OnLoadingChanged.InvokeAsync(false);
        }
    }

}
