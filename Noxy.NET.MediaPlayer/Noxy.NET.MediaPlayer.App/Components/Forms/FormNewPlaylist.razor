@inject IPlaylistService ServicePlaylist
@inject IState<FeaturePlaylistListState> StatePlaylistList
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <WebForm T="FormModelNewPlaylist" Context="_context" ResetAfterSubmit="true" OnSubmit="Submit">
        <InputGroupText @bind-Value="_context.Model.Name"/>
        <div class="actions">
            <Button Type="@HTMLButtonTypeEnum.Submit" Status="StatusEnum.Success" Loading="@LoadingCurrent">Create</Button>
        </div>
    </WebForm>
</div>

@code {

    [Parameter]
    public bool? Loading { get; set; }
    private bool LoadingCurrent => Loading ?? _context.IsSubmitting;

    [Parameter]
    public EventCallback<Guid> OnSubmit { get; set; }

    private WebFormContext<FormModelNewPlaylist> _context = new(new());

    // The dialog builds the form each time it opens, so the number is the one of that moment.
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _context = new(new() { Name = string.Format(AppTexts.NewPlaylistSuggestedName, StatePlaylistList.Value.PlaylistList.Count + 1) });
    }

    private async Task Submit(WebFormContext<FormModelNewPlaylist> context)
    {
        ResponsePlaylist playlist = await ServicePlaylist.Create(context.Model.Name);
        await OnSubmit.InvokeAsync(playlist.ID);
    }

}
