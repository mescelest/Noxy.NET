@inject IPlaylistService ServicePlaylist
@using Noxy.NET.MediaPlayer.Presentation.Exceptions
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <WebForm T="FormModelEditPlaylist" Context="_context" OnSubmit="Submit">
        <InputGroupText @bind-Value="_context.Model.Name"/>
        <InputControlCheckbox Option="true" @bind-Value="_context.Model.AllowDuplicates">
            <span>@AppTexts.EditPlaylistAllowDuplicates</span>
        </InputControlCheckbox>
        <fieldset class="colours">
            <legend>@AppTexts.EditPlaylistColor</legend>
            <InputControlRadio TOption="int?" Option="null" @bind-Value="_context.Model.ArtHue" class="choice">
                <Visual Context="isChecked">
                    <span class="swatch" style="@DefaultStyle" data-checked="@isChecked"></span>
                </Visual>
                <ChildContent>@AppTexts.EditPlaylistColorDefault</ChildContent>
            </InputControlRadio>
            @foreach (int hue in FormModelEditPlaylist.HueList)
            {
                <InputControlRadio TOption="int?" Option="hue" @bind-Value="_context.Model.ArtHue" class="choice" aria-label="@HueLabel(hue)">
                    <Visual Context="isChecked">
                        <span class="swatch" style="@HueStyle(hue)" data-checked="@isChecked"></span>
                    </Visual>
                    <ChildContent></ChildContent>
                </InputControlRadio>
            }
        </fieldset>
        <div class="actions">
            <Button Type="@HTMLButtonTypeEnum.Submit" Status="StatusEnum.Success" Loading="@LoadingCurrent">@AppTexts.EditPlaylistSave</Button>
        </div>
    </WebForm>
</div>

@code {

    [Parameter, EditorRequired]
    public required ResponsePlaylist Playlist { get; set; }

    [Parameter]
    public bool? Loading { get; set; }
    private bool LoadingCurrent => Loading ?? _context.IsSubmitting;

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    private WebFormContext<FormModelEditPlaylist> _context = new(new());

    private string DefaultStyle => HueStyle(Playlist.ArtHueDefault);

    private static string HueStyle(int hue) => $"--playlist-hue: {hue}";

    private static string HueLabel(int hue) => string.Format(AppTexts.EditPlaylistColorHue, hue);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _context = new(new() { Name = Playlist.Name, AllowDuplicates = Playlist.AllowDuplicates, ArtHue = Playlist.ArtHue });
    }

    private async Task Submit(WebFormContext<FormModelEditPlaylist> context)
    {
        try
        {
            await ServicePlaylist.Edit(Playlist.ID, context.Model.Name, context.Model.AllowDuplicates, context.Model.GetArtHueChange(Playlist.ArtHue));
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            // A refusal, such as turning the rule off while the playlist has the same song twice, belongs to the form.
            context.HandleException(exception);
            return;
        }

        await OnSubmit.InvokeAsync();
    }

}
