@inject IServerAddressStorage StorageServerAddress
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <WebForm T="FormModelServerAddress" Context="_context" OnSubmit="Submit" Disabled="Disabled">
        <InputGroupText @bind-Value="_context.Model.ServerAddress"/>
        <Button Type="@HTMLButtonTypeEnum.Submit" Loading="@LoadingCurrent">Save</Button>
    </WebForm>
</div>

@code {

    [Parameter]
    public bool? Loading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<bool> OnLoadingChanged { get; set; }
    private bool LoadingCurrent => Loading ?? _context.IsSubmitting;

    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    private readonly WebFormContext<FormModelServerAddress> _context = new(new());
    private string? _savedAddress;

    protected override async Task OnInitializedAsync()
    {
        _savedAddress = await StorageServerAddress.GetAddress();
        _context.Model.ServerAddress = _savedAddress ?? string.Empty;
    }

    private async Task Submit(WebFormContext<FormModelServerAddress> context)
    {
        await OnLoadingChanged.InvokeAsync(true);
        try
        {
            await StorageServerAddress.SetAddress(context.Model.ServerAddress);
            _savedAddress = await StorageServerAddress.GetAddress();
            context.Model.ServerAddress = _savedAddress ?? string.Empty;

            await OnSubmit.InvokeAsync(_savedAddress);
        }
        finally
        {
            await OnLoadingChanged.InvokeAsync(false);
        }
    }

}
