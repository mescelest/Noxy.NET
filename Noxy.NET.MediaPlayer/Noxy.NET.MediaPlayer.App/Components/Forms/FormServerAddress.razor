@inject IServerAddressStorage StorageServerAddress
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <WebForm T="FormModelServerAddress" Context="_context" OnSubmit="Submit">
        <InputGroupText @bind-Value="_context.Model.ServerAddress"/>
        <Button Type="@HTMLButtonTypeEnum.Submit" Loading="@LoadingCurrent">Save</Button>
    </WebForm>
</div>

@code {

    [Parameter]
    public bool? Loading { get; set; }
    private bool LoadingCurrent => Loading ?? _context.IsSubmitting;

    // The saved address that is edited, or null to add a new one.
    [Parameter]
    public string? Address { get; set; }

    [Parameter]
    public EventCallback<string> OnSubmit { get; set; }

    private readonly WebFormContext<FormModelServerAddress> _context = new(new());

    protected override void OnInitialized()
    {
        _context.Model.ServerAddress = Address ?? string.Empty;
    }

    private async Task Submit(WebFormContext<FormModelServerAddress> context)
    {
        try
        {
            if (Address is null)
            {
                await StorageServerAddress.SetAddress(context.Model.ServerAddress);
            }
            else
            {
                await StorageServerAddress.ReplaceAddress(Address, context.Model.ServerAddress);
            }
        }
        catch (ArgumentException)
        {
            context.HandleException(PresentationTexts.ServerAddressInvalid);
            return;
        }
        catch (InvalidOperationException exception)
        {
            context.HandleException(exception.Message);
            return;
        }

        await OnSubmit.InvokeAsync(context.Model.ServerAddress.NormalizeServerAddress());
    }

}
