@inherits BaseComponentElement

<span @attributes="AdditionalAttributes" class="@CssClass" data-state="@State" title="@Label" role="img" aria-label="@Label">
    @switch (State)
    {
        case FileSyncStateEnum.OnDevice:
            <MaterialIcon Icon="check_circle" Size="var(--size-icon-sm)"/>
            break;
        case FileSyncStateEnum.Downloading:
            <MaterialIcon Icon="downloading" Size="var(--size-icon-sm)"/>
            break;
        case FileSyncStateEnum.Failed:
            <MaterialIcon Icon="error" Size="var(--size-icon-sm)"/>
            break;
        case FileSyncStateEnum.NotDownloaded:
            <MaterialIcon Icon="pending" Size="var(--size-icon-sm)"/>
            break;
        default:
            throw new InvalidEnumArgumentException(nameof(State), (int)State, typeof(FileSyncStateEnum));
    }
</span>

@code {

    [Parameter]
    public FileSyncStateEnum State { get; set; }

    private string Label => State switch
    {
            FileSyncStateEnum.OnDevice => AppTexts.FileStatusOnDevice,
            FileSyncStateEnum.Downloading => AppTexts.FileStatusDownloading,
            FileSyncStateEnum.Failed => AppTexts.FileStatusFailed,
            FileSyncStateEnum.NotDownloaded => AppTexts.FileStatusNotDownloaded,
        _ => throw new InvalidEnumArgumentException(nameof(State), (int)State, typeof(FileSyncStateEnum))
    };

}
