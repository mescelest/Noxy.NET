@inject IDeviceService ServiceDevice
@inject IToastService ServiceToast
@using Noxy.NET.MediaPlayer.Presentation
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <label for="device-name">Name of this device</label>
    <div class="row">
        <input id="device-name" type="text" maxlength="50" @bind="_name" @bind:event="oninput"/>
        <button type="button" disabled="@IsSaveDisabled" @onclick="Save">Save</button>
    </div>
    <MessageBox MessageList="_messageList" Status="StatusEnum.Error"/>
</div>

@code {

    private string _name = string.Empty;
    private List<string> _messageList = [];
    private bool _busy;

    private bool IsSaveDisabled => _busy || string.IsNullOrWhiteSpace(_name);

    protected override async Task OnInitializedAsync()
    {
        _name = await ServiceDevice.GetName();
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            await ServiceDevice.SetName(_name);
            _name = await ServiceDevice.GetName();
            _messageList = [];
            ServiceToast.ShowSuccess(AppTexts.DeviceNameSaved);
        }
        catch (ArgumentException)
        {
            _messageList = [string.Format(AppTexts.DeviceNameInvalid, PresentationConstants.DeviceNameMaxLength)];
        }
        finally
        {
            _busy = false;
        }
    }

}
