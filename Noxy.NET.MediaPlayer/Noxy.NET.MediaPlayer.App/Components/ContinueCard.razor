@inherits ElementComponent

<button type="button" @attributes="AdditionalAttributes" class="@CssClass" @onclick="OnContinue">
    <IconPlay Size="IconSizeEnum.Large"/>
    <span class="text">
        <span class="title">Continue</span>
        <span class="detail">@Detail</span>
    </span>
</button>

@code {

    [Parameter, EditorRequired]
    public required ContinueInfo Info { get; set; }

    [Parameter]
    public EventCallback OnContinue { get; set; }

    private string Detail
    {
        get
        {
            string name = string.Join(" - ", new[] { Info.Title, Info.Artist }.Where(x => !string.IsNullOrWhiteSpace(x)));
            TimeSpan position = TimeSpan.FromSeconds(Math.Max(0, Info.PositionSeconds));

            string at = $"{(int)position.TotalMinutes}:{position.Seconds:00}";

            return string.IsNullOrEmpty(name) ? $"at {at}" : $"{name} at {at}";
        }
    }

}
