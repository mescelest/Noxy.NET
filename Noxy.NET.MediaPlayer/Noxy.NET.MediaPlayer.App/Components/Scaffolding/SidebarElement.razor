@inject IState<FeaturePlaylistListState> StatePlaylistList
@inherits BaseComponentElementFluxor

<nav @attributes="AdditionalAttributes" class="@CssClass" aria-label="Main">
    <div class="link-list">
        <NavLink class="link" href="" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <MaterialIcon Icon="home" Size="var(--size-icon-sm)"/>
            <span>Home</span>
        </NavLink>
        <NavLink class="link" href="library" @onclick="OnNavigate">
            <MaterialIcon Icon="library_music" Size="var(--size-icon-sm)"/>
            <span>Library</span>
        </NavLink>
        <NavLink class="link" href="settings" @onclick="OnNavigate">
            <MaterialIcon Icon="settings" Size="var(--size-icon-sm)"/>
            <span>Settings</span>
        </NavLink>
    </div>

    @* <div class="link-list"> *@
    @*     <NavLink class="link" href="youtube" @onclick="OnNavigate"> *@
    @*         <MaterialIcon Icon="radio" Size="var(--size-icon-sm)"/> *@
    @*         YouTube *@
    @*     </NavLink> *@
    @*     <NavLink class="link" href="bandcamp" @onclick="OnNavigate"> *@
    @*         <MaterialIcon Icon="music_note" Size="var(--size-icon-sm)"/> *@
    @*         Bandcamp *@
    @*     </NavLink> *@
    @* </div> *@

    <div class="link-list">
        <div class="link-list-header">
            <span>Playlists</span>
            <Button class="link-list-header-button" Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.Success" @onclick="ClickNewPlaylistHandler">
                <MaterialIcon Icon="add" Size="var(--size-icon-sm)"/>
            </Button>
        </div>

        @foreach (ResponsePlaylist playlist in PlaylistList)
        {
            ResponsePlaylist row = playlist;

            <div @key="row.ID" class="playlist-row" @oncontextmenu="args => OpenPlaylistMenu(args, row.ID)" @oncontextmenu:preventDefault>
                <NavLink class="link" href="@($"playlist/{row.ID}")" @onclick="OnNavigate">
                    <PlaylistArt Playlist="row"/>
                    <span>@row.Name</span>
                </NavLink>
                <Button class="more" Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" aria-label="@($"Actions for {row.Name}")" aria-haspopup="menu"
                        popovertarget="@PlaylistContextMenu.MenuID(row.ID, PlaylistContextMenu.PlaceSidebar)">
                    <MaterialIcon Icon="more_horiz" Size="var(--size-icon-sm)"/>
                </Button>
                <PlaylistContextMenu @ref="_menuMap[row.ID]" Playlist="row" Place="@PlaylistContextMenu.PlaceSidebar"/>
            </div>
        }
    </div>

    <NewPlaylistDialog @bind-Open="_showNewPlaylistDialog"/>
</nav>

@code {

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private List<ResponsePlaylist> PlaylistList => StatePlaylistList.Value.PlaylistList.OrderNewestCreatedFirst();

    private bool _showNewPlaylistDialog;
    private readonly Dictionary<Guid, PlaylistContextMenu> _menuMap = [];

    // A right-click on a playlist opens the same menu as its "⋯" button, at the pointer.
    private async Task OpenPlaylistMenu(MouseEventArgs args, Guid playlistID)
    {
        if (_menuMap.TryGetValue(playlistID, out PlaylistContextMenu? menu))
        {
            await menu.OpenAtAsync(args);
        }
    }

    private void ClickNewPlaylistHandler()
    {
        _showNewPlaylistDialog = true;
    }

}
