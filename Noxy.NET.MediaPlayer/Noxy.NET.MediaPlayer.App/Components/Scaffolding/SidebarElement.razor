@inject IState<FeaturePlaylistListState> StatePlaylistList
@inject IPlaylistService ServicePlaylist
@inject IToastService ServiceToast
@using Noxy.NET.MediaPlayer.Presentation.Exceptions
@inherits BaseComponentElementFluxor

<nav @attributes="AdditionalAttributes" class="@CssClass" aria-label="@AppTexts.SidebarMain">
    <div class="link-list">
        <NavLink class="link" href="" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <MaterialIcon Icon="home" Size="var(--size-icon-sm)"/>
            <span>@AppTexts.SidebarHome</span>
        </NavLink>
        <NavLink class="link" href="library" @onclick="OnNavigate">
            <MaterialIcon Icon="library_music" Size="var(--size-icon-sm)"/>
            <span>@AppTexts.SidebarLibrary</span>
        </NavLink>
        <NavLink class="link" href="organise" @onclick="OnNavigate">
            <MaterialIcon Icon="tune" Size="var(--size-icon-sm)"/>
            <span>@AppTexts.SidebarOrganise</span>
        </NavLink>
        <NavLink class="link" href="settings" @onclick="OnNavigate">
            <MaterialIcon Icon="settings" Size="var(--size-icon-sm)"/>
            <span>@AppTexts.SidebarSettings</span>
        </NavLink>
    </div>

    @* <div class="link-list"> *@
    @*     <NavLink class="link" href="youtube" @onclick="OnNavigate"> *@
    @*         <MaterialIcon Icon="radio" Size="var(--size-icon-sm)"/> *@
    @*         YouTube *@
    @*     </NavLink> *@
    @*     <NavLink class="link" href="bandcamp" @onclick="OnNavigate"> *@
    @*         <MaterialIcon Icon="music_note" Size="var(--size-icon-sm)"/> *@
    @*         Bandcamp *@
    @*     </NavLink> *@
    @* </div> *@

    <div class="link-list">
        <div class="link-list-header">
            <span>@AppTexts.SidebarPlaylists</span>
            <Button class="link-list-header-button" Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.Success" aria-label="@AppTexts.NewPlaylistTitle" title="@AppTexts.NewPlaylistTitle"
                    @onclick="ClickNewPlaylistHandler">
                <MaterialIcon Icon="add" Size="var(--size-icon-sm)"/>
            </Button>
        </div>

        <SortableList T="ResponsePlaylist" class="playlist-list" HandleClass="sortable-item" FilterSelector="dialog, [popover]" List="PlaylistList" OnUpdate="MoveHandler" Context="entry">
            @{ ResponsePlaylist row = entry.Item; }
            <div @key="row.ID" class="playlist-row sortable-item" @oncontextmenu="args => OpenPlaylistMenu(args, row.ID)" @oncontextmenu:preventDefault>
                <NavLink class="link" href="@($"playlist/{row.ID}")" @onclick="OnNavigate">
                    <PlaylistArt Hue="row.ArtHueCurrent"/>
                    <span>@row.Name</span>
                </NavLink>
                <Button class="more" Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" aria-label="@string.Format(AppTexts.SidebarPlaylistActions, row.Name)" aria-haspopup="menu"
                        popovertarget="@PlaylistContextMenu.MenuID(row.ID, PlaylistContextMenu.PlaceSidebar)">
                    <MaterialIcon Icon="more_horiz" Size="var(--size-icon-sm)"/>
                </Button>
                <PlaylistContextMenu @ref="_menuMap[row.ID]" Playlist="row" Place="@PlaylistContextMenu.PlaceSidebar"/>
            </div>
        </SortableList>
    </div>

    <NewPlaylistDialog @bind-Open="_showNewPlaylistDialog"/>
</nav>

@code {

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    // The order the user saved; while a drop is being saved, the order the user just made, so the row does not jump back.
    private List<ResponsePlaylist> PlaylistList => _droppedList ?? StatePlaylistList.Value.PlaylistList.OrderByPosition();

    private List<ResponsePlaylist>? _droppedList;
    private bool _showNewPlaylistDialog;
    private readonly Dictionary<Guid, PlaylistContextMenu> _menuMap = [];

    // A right-click on a playlist opens the same menu as its "⋯" button, at the pointer.
    private async Task OpenPlaylistMenu(MouseEventArgs args, Guid playlistID)
    {
        if (_menuMap.TryGetValue(playlistID, out PlaylistContextMenu? menu))
        {
            await menu.OpenAtAsync(args);
        }
    }

    // A drop shows at once and is saved on the server. When the save fails (refused, or offline), the saved order comes back and the reason is shown.
    private async Task MoveHandler((int IndexOld, int IndexNew) move)
    {
        List<ResponsePlaylist> list = PlaylistList;
        ResponsePlaylist moved = list[move.IndexOld];
        List<ResponsePlaylist> droppedList = [.. list];
        droppedList.RemoveAt(move.IndexOld);
        droppedList.Insert(move.IndexNew, moved);
        _droppedList = droppedList;

        try
        {
            await ServicePlaylist.Move(moved.ID, move.IndexNew);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
        finally
        {
            _droppedList = null;
        }
    }

    private void ClickNewPlaylistHandler()
    {
        _showNewPlaylistDialog = true;
    }

}
