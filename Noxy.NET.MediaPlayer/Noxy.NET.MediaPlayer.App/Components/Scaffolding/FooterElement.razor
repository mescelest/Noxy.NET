@inject IState<FeaturePlayerState> StatePlayer
@inject IState<FeatureLibraryState> StateLibrary
@inject IState<FeatureSessionState> StateSession
@inject IPlaybackControlService ServiceControl
@inject IRemotePlaybackService ServiceRemote
@inherits BaseComponentElementFluxor
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes" class="@CssClass">
    <input class="seek" type="range" min="0" max="@DurationSeconds" step="1" value="@TimeCurrentSeconds" aria-label="Position" @oninput="InputSeekHandler" @onchange="ChangeSeekHandler"/>

    <div class="content">
        <div class="section left">
            <div class="album">
                <MaterialIcon Icon="album" Size="var(--size-icon-xl)"/>
            </div>
            <span class="name">@Title</span>
            <span class="artist">@Artist</span>

            <span class="status">@Status</span>
        </div>

        <div class="section center">
            <Button Type="@HTMLButtonTypeEnum.Button" class="mode" IsIcon="true" aria-label="@ShuffleAriaLabel" data-on="@ShuffleOn" @onclick="CycleShuffle">
                <MaterialIcon Icon="shuffle" Size="var(--size-icon-md)"/> @Shuffle
            </Button>

            <Button Type="@HTMLButtonTypeEnum.Button" class="icon" IsIcon="true" aria-label="Previous" @onclick="ClickPreviousHandler">
                <MaterialIcon Icon="skip_previous" Size="var(--size-icon-md)"/>
            </Button>

            <Button Type="@HTMLButtonTypeEnum.Button" class="icon primary" IsIcon="true" aria-label="@PlayingAriaLabel" @onclick="ClickPlayingHandler">
                @if (IsPlaying)
                {
                    <MaterialIcon Icon="pause" Size="var(--size-icon-md)"/>
                }
                else
                {
                    <MaterialIcon Icon="play_arrow" Size="var(--size-icon-md)"/>
                }
            </Button>

            <Button Type="@HTMLButtonTypeEnum.Button" class="icon" IsIcon="true" aria-label="Next" @onclick="ClickNextHandler">
                <MaterialIcon Icon="skip_next" Size="var(--size-icon-md)"/>
            </Button>

            <Button Type="@HTMLButtonTypeEnum.Button" class="mode" IsIcon="true" aria-label="@RepeatAriaLabel" data-on="@RepeatOn" @onclick="CycleRepeat">
                <MaterialIcon Icon="repeat" Size="var(--size-icon-md)"/>
                Repeat: @Repeat
            </Button>
        </div>

        <div class="section right">
            <div class="duration">
                <span class="time">@Format(TimeCurrent) / @Format(Duration)</span>
            </div>

            <div class="volume">
                <MaterialIcon Icon="volume_up" Size="var(--size-icon-md)"/>
                <input type="range" min="0" max="100" step="1" value="@VolumeCurrent" aria-label="Volume" @oninput="InputVolumeHandler" @onchange="ChangeVolumeHandler"/>
            </div>

            <Button Type="@HTMLButtonTypeEnum.Button" class="queue" IsIcon="true" @onclick="ClickQueueHandler" aria-expanded="@_queueOpen">
                <MaterialIcon Icon="queue_music" Size="var(--size-icon-md)"/>
            </Button>

            <DevicePicker/>
        </div>
    </div>

    <MessageBox MessageList="_messageList" Status="StatusEnum.Error"/>

    @if (_queueOpen)
    {
        <QueuePanel OnClose="CloseQueuePanelHandler"/>
    }
</div>

@code {

    private List<string> _messageList = [];
    private bool _queueOpen;
    private TimeSpan? _dragPosition;
    private int? _dragVolume;
    private CancellationTokenSource? _tickSource;

    private PlayerSnapshot Snapshot => StatePlayer.Value.Snapshot;

    // A controller shows what the active device reports; any other device shows its own player.
    private ResponsePlayerState? RemoteState => ServiceRemote.Role == PlaybackRoleEnum.Controller ? ServiceRemote.Remote?.State : null;

    private bool IsController => RemoteState is not null;
    private bool IsPlaying => RemoteState is { } remote ? remote.IsPlaying : Snapshot.IsPlaying;

    private TimeSpan PositionCurrent => IsController ? ServiceRemote.GetPosition() : Snapshot.Position;
    private TimeSpan Duration => RemoteState is { } remote ? MediaOf(remote.CurrentItemID)?.Duration ?? TimeSpan.Zero : Snapshot.Duration;
    private double DurationSeconds => Math.Max(1, Duration.TotalSeconds);
    private TimeSpan TimeCurrent => _dragPosition ?? PositionCurrent;
    private int TimeCurrentSeconds => (int)TimeCurrent.TotalSeconds;

    private int VolumePercent => RemoteState is { } remote ? remote.Volume : (int)Math.Round(Snapshot.Volume * 100);
    private int VolumeCurrent => _dragVolume ?? VolumePercent;

    private string PlayingAriaLabel => IsPlaying ? "Pause" : "Play";

    private ShuffleModeEnum Shuffle => RemoteState is { } remote ? remote.Shuffle : Snapshot.Shuffle;
    private string ShuffleAriaLabel => $"Shuffle: {Shuffle}";
    private bool ShuffleOn => Shuffle != ShuffleModeEnum.Off;

    private RepeatModeEnum Repeat => RemoteState is { } remote ? remote.Repeat : Snapshot.Repeat;
    private string RepeatAriaLabel => $"Repeat: {Repeat}";
    private bool RepeatOn => Repeat != RepeatModeEnum.No;

    private string Title => RemoteState is { } remote ? remote.Title ?? string.Empty : MediaOf(Snapshot.Current?.MediaFileID)?.Title ?? string.Empty;
    private string Artist => RemoteState is { } remote ? remote.Artist ?? string.Empty : MediaOf(Snapshot.Current?.MediaFileID)?.Artist ?? string.Empty;

    private string Status
    {
        get
        {
            if (IsController) return $"Playing on {ActiveDeviceName}";
            if (Snapshot.IsWaiting) return "Waiting for a download";
            return StateSession.Value.IsOffline ? "Offline" : string.Empty;
        }
    }

    private string ActiveDeviceName => ServiceRemote.DeviceList.FirstOrDefault(x => x.DeviceID == ServiceRemote.ActiveDeviceID)?.Name ?? "another device";

    private Dictionary<Guid, ResponseMediaFile>? _mediaMap;
    private List<ResponseMediaFile>? _mediaMapSource;

    private ResponseMediaFile? MediaOf(Guid? id)
    {
        return id is not null ? GetMediaMap().GetValueOrDefault(id.Value) : null;
    }

    private Dictionary<Guid, ResponseMediaFile> GetMediaMap()
    {
        if (_mediaMap is { } map && ReferenceEquals(_mediaMapSource, StateLibrary.Value.MediaList)) return map;

        _mediaMapSource = StateLibrary.Value.MediaList;
        return _mediaMap = _mediaMapSource.ToDictionary(x => x.ID);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ServiceRemote.Changed += OnRemoteChanged;
        _tickSource = new();
        _ = Tick(_tickSource.Token);
    }

    // A controller's position moves between the active device's reports: redraw twice a second while it plays.
    private async Task Tick(CancellationToken token)
    {
        using PeriodicTimer timer = new(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (IsController && IsPlaying && _dragPosition is null) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The bar is gone.
        }
    }

    private void OnRemoteChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Run(Func<Task> action)
    {
        _messageList = [];
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _messageList = [exception.ToActionMessage()];
        }
    }


    private Task ChangeVolumeHandler()
    {
        int? volume = _dragVolume;
        _dragVolume = null;

        return volume is null ? Task.CompletedTask : Run(() => ServiceControl.SetVolume(volume.Value));
    }

    private Task CycleShuffle() => Run(() => ServiceControl.SetShuffle(Shuffle switch
    {
        ShuffleModeEnum.Off => ShuffleModeEnum.Random,
        ShuffleModeEnum.Random => ShuffleModeEnum.SpreadArtists,
        ShuffleModeEnum.SpreadArtists => ShuffleModeEnum.Off,
        _ => throw new InvalidEnumArgumentException(nameof(Shuffle), (int)Shuffle, typeof(ShuffleModeEnum))
    }));

    private Task CycleRepeat() => Run(() => ServiceControl.SetRepeat(Repeat switch
    {
        RepeatModeEnum.No => RepeatModeEnum.Once,
        RepeatModeEnum.Once => RepeatModeEnum.Forever,
        RepeatModeEnum.Forever => RepeatModeEnum.No,
        _ => throw new InvalidEnumArgumentException(nameof(Repeat), (int)Repeat, typeof(RepeatModeEnum))
    }));

    private static double ParseDouble(object? value) => double.TryParse(value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double result) ? result : 0;

    private static string Format(TimeSpan time) => $"{(int)time.TotalMinutes}:{time.Seconds:00}";

    public new async ValueTask DisposeAsync()
    {
        ServiceRemote.Changed -= OnRemoteChanged;
        if (_tickSource is not null)
        {
            await _tickSource.CancelAsync();
            _tickSource.Dispose();
        }

        await base.DisposeAsync();
    }

    private void InputSeekHandler(ChangeEventArgs args)
    {
        _dragPosition = TimeSpan.FromSeconds(ParseDouble(args.Value));
    }

    private Task ChangeSeekHandler()
    {
        TimeSpan? position = _dragPosition;
        _dragPosition = null;

        return position is null ? Task.CompletedTask : Run(() => ServiceControl.Seek(position.Value));
    }

    private void InputVolumeHandler(ChangeEventArgs args)
    {
        _dragVolume = (int)ParseDouble(args.Value);
    }

    private Task ClickPlayingHandler()
    {
        return Run(IsPlaying ? ServiceControl.Pause : ServiceControl.Play);
    }

    private Task ClickNextHandler()
    {
        return Run(ServiceControl.Next);
    }

    private Task ClickPreviousHandler()
    {
        return Run(ServiceControl.Previous);
    }

    private void ClickQueueHandler()
    {
        _queueOpen = !_queueOpen;
    }

    private void CloseQueuePanelHandler()
    {
        _queueOpen = false;
    }

}
