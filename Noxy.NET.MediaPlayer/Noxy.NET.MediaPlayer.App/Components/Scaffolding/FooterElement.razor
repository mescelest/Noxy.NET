@inject IState<FeaturePlayerState> StatePlayer
@inject IState<FeatureLibraryState> StateLibrary
@inject IState<FeatureSessionState> StateSession
@inject IPlayerService ServicePlayer
@inject IPlaybackControlService ServiceControl
@inject IRemotePlaybackService ServiceRemote
@inject IToastService ServiceToast
@inject IEnumerable<IMediaKeyService> ServiceMediaKeyList
@inherits BaseComponentElementFluxor
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes" class="@CssClass">
    <SeekBar Value="Display.Position.TotalSeconds" Max="DurationSeconds" Label="@AppTexts.PlayerPosition" OnInput="InputSeekHandler" OnChange="ChangeSeekHandler"/>

    <div class="content">
        <MediaTrackInfo Display="Display"/>

        <MediaTransportControls Display="Display" OnPrevious="ClickPreviousHandler" OnPlayPause="ClickPlayingHandler" OnNext="ClickNextHandler" OnShuffle="ChangeShuffle" OnRepeat="ChangeRepeat"/>

        <MediaOutputControls Display="Display" OnVolumePreview="PreviewVolume" OnVolumeChanged="ChangeVolume"/>
    </div>

</div>

@code {

    private const int TickMilliseconds = 250;

    // Half of the seek bar's step of 0.01 seconds.
    private const double SeekToleranceSeconds = 0.005;

    private TimeSpan? _dragPosition;
    private double? _committedSeconds;
    private PlaybackDisplay? _display;
    private CancellationTokenSource? _tickSource;
    private Dictionary<Guid, ResponseMediaFile>? _mediaMap;
    private List<ResponseMediaFile>? _mediaMapSource;

    // What the bar shows, worked out once per render: the same figures reach the seek bar and the three sections.
    private PlaybackDisplay Display => _display ??= PlaybackDisplay.Of(StatePlayer.Value.Snapshot, RemoteState, PositionCurrent, MediaOf, ActiveDeviceName, StateSession.Value.IsOffline);

    private double DurationSeconds => Math.Max(1, Display.Duration.TotalSeconds);

    // A controller shows what the active device reports; any other device shows its own player.
    private ResponsePlayerState? RemoteState => ServiceRemote.Role == PlaybackRoleEnum.Controller ? ServiceRemote.Remote?.State : null;

    // A controller works the position out from the active device's last report; this device reads its own player as it is now, not as it was at the last once-a-second report. A thumb being dragged shows where it is.
    private TimeSpan PositionCurrent => _dragPosition ?? (RemoteState is not null ? ServiceRemote.GetPosition() : ServicePlayer.Position);

    private string? ActiveDeviceName => ServiceRemote.DeviceList.FirstOrDefault(x => x.DeviceID == ServiceRemote.ActiveDeviceID)?.Name;

    private ResponseMediaFile? MediaOf(Guid id)
    {
        return GetMediaMap().GetValueOrDefault(id);
    }

    private Dictionary<Guid, ResponseMediaFile> GetMediaMap()
    {
        if (_mediaMap is { } map && ReferenceEquals(_mediaMapSource, StateLibrary.Value.MediaList)) return map;

        _mediaMapSource = StateLibrary.Value.MediaList;
        return _mediaMap = _mediaMapSource.ToDictionary(x => x.ID);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ServiceRemote.Changed += OnRemoteChanged;
        _tickSource = new();
        _ = Tick(_tickSource.Token);
    }

    private MediaKeyState? _mediaKeyState;

    // The system media overlay shows what the bar shows; it is told only when that changed, not on every tick.
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        MediaKeyState state = new(Display.IsPlaying, Display.Title, Display.Artist);
        if (state == _mediaKeyState) return;

        _mediaKeyState = state;
        foreach (IMediaKeyService service in ServiceMediaKeyList) service.SetState(state);
    }

    // Every render starts from figures read now, whatever read them before.
    protected override bool ShouldRender()
    {
        _display = null;

        return base.ShouldRender();
    }

    // The position moves between the reports of the player or of the active device: redraw a few times a second while it plays, so the time and the bar follow it.
    private async Task Tick(CancellationToken token)
    {
        using PeriodicTimer timer = new(TimeSpan.FromMilliseconds(TickMilliseconds));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (Display.IsPlaying && _dragPosition is null) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The bar is gone.
        }
    }

    private void OnRemoteChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Run(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
    }

    private void InputSeekHandler(double seconds)
    {
        // The webview reports the end of a drag or a click as the change first and the last input after it (seen in a log), so an input that repeats the value just committed is the tail of that gesture, not a new drag.
        bool isTail = IsSameSeek(_committedSeconds, seconds);
        _committedSeconds = null;
        if (isTail) return;

        _dragPosition = TimeSpan.FromSeconds(seconds);
    }

    // Two readings of the same spot on the bar, which are never compared for exact equality: they match when they are within half a step of the bar.
    private static bool IsSameSeek(double? committedSeconds, double seconds)
    {
        return committedSeconds is { } committed && Math.Abs(committed - seconds) < SeekToleranceSeconds;
    }

    private Task ChangeSeekHandler(double seconds)
    {
        _committedSeconds = seconds;
        _dragPosition = null;

        return Run(() => ServiceControl.Seek(TimeSpan.FromSeconds(seconds)));
    }

    private Task ChangeShuffle(ShuffleModeEnum mode) => Run(() => ServiceControl.SetShuffle(mode));

    private Task ChangeRepeat(RepeatModeEnum mode) => Run(() => ServiceControl.SetRepeat(mode));

    private Task PreviewVolume(int volume) => Run(() => ServiceControl.PreviewVolume(volume));

    private Task ChangeVolume(int volume) => Run(() => ServiceControl.SetVolume(volume));

    private Task ClickPlayingHandler()
    {
        return Run(ServiceControl.TogglePlay);
    }

    private Task ClickNextHandler()
    {
        return Run(ServiceControl.Next);
    }

    private Task ClickPreviousHandler()
    {
        return Run(ServiceControl.Previous);
    }

    public new async ValueTask DisposeAsync()
    {
        ServiceRemote.Changed -= OnRemoteChanged;
        if (_tickSource is not null)
        {
            await _tickSource.CancelAsync();
            _tickSource.Dispose();
        }

        await base.DisposeAsync();
    }

}
