@inherits BaseComponentElement

<span @attributes="AdditionalAttributes" class="@CssClass" style="@StyleCurrent" aria-hidden="true">
    <MaterialIcon Icon="queue_music" Size="@IconSize"/>
</span>

@code {

    // The colour of the tile on the colour wheel, in degrees. The colour in the stylesheet is worked out from it.
    [Parameter, EditorRequired]
    public required int Hue { get; set; }

    // The size of the square, as a CSS length; unset, it is --size-playlist-art.
    [Parameter]
    public string? Size { get; set; }

    // The icon in the square, as a CSS length; unset, it is --size-icon-xs.
    [Parameter]
    public string? IconSize { get; set; } = "var(--size-icon-xs)";

    private string StyleCurrent => Size is null ? $"--playlist-hue: {Hue}" : $"--playlist-hue: {Hue}; --size-playlist-art: {Size}";

}
