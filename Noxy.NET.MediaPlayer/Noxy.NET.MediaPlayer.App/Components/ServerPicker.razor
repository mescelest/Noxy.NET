@inject IServerAddressStorage StorageServerAddress
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <InputControlSelect TOption="string" ID="server-picker" Name="server" aria-label="Server" disabled="@IsSelectDisabled" OptionList="_optionList" @bind-Value:get="@CurrentOption" @bind-Value:set="Select">
        @OptionText(context)
    </InputControlSelect>
    <Button class="manage" Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.None" IsIcon="true" disabled="@Disabled" aria-label="Manage servers" @onclick="OpenDialog">
        <MaterialIcon Icon="settings" Size="var(--size-icon-sm)"/>
    </Button>

    <ServerManageDialog @bind-Open="_open" OnChanged="Load"/>
</div>

@code {

    [Parameter]
    public bool Disabled { get; set; }

    // The empty option stands for "no server in use": it is the placeholder, and it is there only while none is.
    private const string PlaceholderOption = "";

    private List<string> _addressList = [];
    private HashSet<string> _optionList = [];
    private string? _current;
    private bool _open;

    private bool IsSelectDisabled => Disabled || _addressList.Count == 0;

    private string CurrentOption => _current ?? PlaceholderOption;

    private string PlaceholderText => _addressList.Count == 0 ? "No server saved" : "Choose a server";

    private string OptionText(string? option) => string.IsNullOrEmpty(option) ? PlaceholderText : option;

    private void OpenDialog()
    {
        _open = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _addressList = await StorageServerAddress.GetAddressList();
        _current = await StorageServerAddress.GetAddress();
        _optionList = _current is null ? [PlaceholderOption, .. _addressList] : [.. _addressList];
    }

    private async Task Select(string? address)
    {
        if (string.IsNullOrEmpty(address)) return;

        await StorageServerAddress.SetAddress(address);
        await Load();
    }

}
