@inject IDeviceResetService ServiceDeviceReset
@inject ISyncService ServiceSync
@inject IMetadataStore StoreMetadata
@inject IFileStore StoreFile
@inject IToastService ServiceToast
@inherits BaseComponentElement
@implements IDisposable

<Section @attributes="AdditionalAttributes" class="@CssClass" Title="@AppTexts.SectionDeviceTitle">
    <HeaderContent>
        <Button Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.None" disabled="@IsOffline" title="@RefreshTitle" aria-label="@AppTexts.DeviceRefreshLibrary" @onclick="RefreshLibrary">
            <MaterialIcon Icon="refresh" Size="var(--size-icon-sm)"/>
        </Button>
    </HeaderContent>
    <ChildContent>
        <DeviceNameField/>

        <dl>
            <dt>@AppTexts.SectionDeviceMediaFiles</dt>
            <dd>@OnDeviceText</dd>

            <dt>@AppTexts.SectionDeviceStored</dt>
            <dd>@UsedText</dd>

            <dt>@AppTexts.SectionDeviceFree</dt>
            <dd>@FreeText</dd>
        </dl>

        <div class="theme">
            <span class="theme-label">@AppTexts.SettingsTheme</span>
            <ThemePicker/>
        </div>

        <div class="danger">
            <ButtonConfirm Status="StatusEnum.Warning" OnConfirm="ResetPreferences">
                <ChildContent>
                    <MaterialIcon Icon="restart_alt" Size="var(--size-icon-sm)"/>
                    @AppTexts.ResetPreferencesButton
                </ChildContent>
                <ConfirmContent>
                    <MaterialIcon Icon="check" Size="var(--size-icon-sm)"/>
                    @AppTexts.ResetPreferencesConfirm
                </ConfirmContent>
            </ButtonConfirm>
            <Button Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Filled" Status="StatusEnum.Error" @onclick="AskDeleteAllData">
                <MaterialIcon Icon="delete_forever" Size="var(--size-icon-sm)"/>
                @AppTexts.DeleteAllDataButton
            </Button>
        </div>

        <ConfirmActionDialog Open="_isDeletingAllData" OpenChanged="CloseDeleteAllData" Title="@AppTexts.DeleteAllDataTitle" Detail="@AppTexts.DeleteAllDataDetail" Warning="@AppTexts.DeleteAllDataWarning" AcceptText="@AppTexts.DeleteAllDataAccept"
                             AcceptStatus="StatusEnum.Error"
                             OnSubmit="SubmitDeleteAllData"/>
    </ChildContent>
</Section>

@code {

    private static string TextUnknown => AppTexts.SettingsUnknown;

    private bool _isDeletingAllData;
    private int _mediaCount;
    private int _onDeviceCount;
    private StorageEstimate? _estimate;

    private string? OfflineReason => ServiceSync.IsOffline ? PresentationTexts.ActionMessageOffline : null;
    private bool IsOffline => OfflineReason is not null;
    private string RefreshTitle => OfflineReason ?? AppTexts.DeviceRefreshLibrary;

    private string OnDeviceText => $"{_onDeviceCount} of {_mediaCount}";
    private string UsedText => _estimate is null ? TextUnknown : Format(_estimate.UsedBytes);
    private string FreeText => _estimate is null ? TextUnknown : Format(_estimate.FreeBytes);

    protected override async Task OnInitializedAsync()
    {
        ServiceSync.Changed += OnChanged;
        await Load();
    }

    private void OnChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        });
    }

    private async Task Load()
    {
        _mediaCount = (await StoreMetadata.GetMediaFileList()).Count;
        _onDeviceCount = (await StoreMetadata.GetFileStateList()).Count(x => x.State == FileSyncStateEnum.OnDevice);
        try
        {
            _estimate = await StoreFile.GetEstimate();
        }
        catch (IOException)
        {
            _estimate = null;
        }
    }

    private async Task RefreshLibrary()
    {
        await Run(async () =>
        {
            await ServiceSync.SyncLibrary(true);
            await ServiceSync.SyncPlaylistList(true);
        });
    }

    private void AskDeleteAllData()
    {
        _isDeletingAllData = true;
    }

    private void CloseDeleteAllData(bool open)
    {
        _isDeletingAllData = open;
    }

    private async Task ResetPreferences()
    {
        await Run(ServiceDeviceReset.ResetPreferences);
    }

    private async Task SubmitDeleteAllData(bool accepted)
    {
        if (!accepted) return;

        await Run(ServiceDeviceReset.DeleteAllData);
    }

    private async Task Run(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
    }

    private static string Format(long bytes)
    {
        string[] unitList = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < unitList.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {unitList[unit]}";
    }

    public void Dispose()
    {
        ServiceSync.Changed -= OnChanged;
    }

}
