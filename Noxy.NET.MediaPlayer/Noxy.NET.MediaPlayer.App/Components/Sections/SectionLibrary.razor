@inject ISyncService ServiceSync
@inject IMetadataStore StoreMetadata
@inject IFileStore StoreFile
@inject IToastService ServiceToast
@inherits BaseComponentElement
@implements IDisposable

<Section @attributes="AdditionalAttributes" class="@CssClass" Title="Library">
    <MessageBox MessageList="OnDeviceMessageList" Status="StatusEnum.None"/>
    <Button Type="@HTMLButtonTypeEnum.Button" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.None" disabled="@IsOffline" title="@OfflineReason" @onclick="RefreshLibrary">Refresh library</Button>
</Section>

@code {

    private int _mediaCount;
    private List<string> OnDeviceMessageList => [$"{_onDeviceCount} of {_mediaCount} media files are on this device ({Format(_usedBytes)})."];

    private int _onDeviceCount;
    private long _usedBytes;

    private string? OfflineReason => ServiceSync.IsOffline ? PresentationTexts.ActionMessageOffline : null;
    private bool IsOffline => OfflineReason is not null;

    protected override async Task OnInitializedAsync()
    {
        ServiceSync.Changed += OnChanged;
        await Load();
    }

    private void OnChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        });
    }

    private async Task Load()
    {
        _mediaCount = (await StoreMetadata.GetMediaFileList()).Count;
        _onDeviceCount = (await StoreMetadata.GetFileStateList()).Count(x => x.State == FileSyncStateEnum.OnDevice);
        try
        {
            _usedBytes = (await StoreFile.GetEstimate()).UsedBytes;
        }
        catch (IOException)
        {
            _usedBytes = 0;
        }
    }

    private async Task RefreshLibrary()
    {
        try
        {
            await ServiceSync.SyncLibrary(true);
            await ServiceSync.SyncPlaylistList(true);
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
        }
    }

    private static string Format(long bytes)
    {
        string[] unitList = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < unitList.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {unitList[unit]}";
    }

    public void Dispose()
    {
        ServiceSync.Changed -= OnChanged;
    }

}
