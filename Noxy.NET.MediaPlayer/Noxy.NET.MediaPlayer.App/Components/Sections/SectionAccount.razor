@inject ISessionService ServiceSession
@inherits BaseComponentElement

<Section @attributes="AdditionalAttributes" class="@CssClass" Title="Account">
    <HeaderContent>
        <Button Type="@HTMLButtonTypeEnum.Button" IsIcon="true" Appearance="ButtonAppearanceEnum.Ghost" Status="StatusEnum.Error" title="@AppTexts.AccountSignOut" aria-label="@AppTexts.AccountSignOut" @onclick="ServiceSession.SignOut">
            <MaterialIcon Icon="logout" Size="var(--size-icon-sm)"/>
        </Button>
    </HeaderContent>
    <ChildContent>
        <div class="signed-in">
            <div class="text">
                <span class="label">Signed in as</span>
                <span class="help">@MethodText</span>
            </div>
            <span class="email">@EmailText</span>
        </div>

        <SettingList/>
    </ChildContent>
</Section>

@code {

    private string? _email;
    private SignInMethodEnum? _method;

    private const string TextUnknown = "Unknown";

    private string EmailText => _email ?? TextUnknown;

    // A session from before the way of signing in was kept has none until the next sign in: it says so.
    private string MethodText
    {
        get
        {
            return _method switch
            {
                    null => AppTexts.AccountSignedInUnknown,
                    SignInMethodEnum.Google => AppTexts.AccountSignedInWithGoogle,
                    SignInMethodEnum.Password => AppTexts.AccountSignedInWithPassword,
                    _ => throw new InvalidEnumArgumentException(nameof(_method), (int)_method.Value, typeof(SignInMethodEnum))
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        string? token = await ServiceSession.GetAccessToken();
        _email = token?.GetAccessTokenEmail();
        _method = await ServiceSession.GetSignInMethod();
    }

}
