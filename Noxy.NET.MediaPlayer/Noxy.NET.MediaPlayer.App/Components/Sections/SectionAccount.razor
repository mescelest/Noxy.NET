@inject ISessionService ServiceSession
@inject IFileStore StoreFile
@inherits BaseComponentElement

<Section @attributes="AdditionalAttributes" class="@CssClass" Title="Account">

    <dl>
        <dt>Signed in as</dt>
        <dd>@EmailText</dd>

        <dt>Stored on this device</dt>
        <dd>@UsedText</dd>

        <dt>Free space on this device</dt>
        <dd>@FreeText</dd>
    </dl>

    <button type="button" class="sign-out" @onclick="ServiceSession.SignOut">Sign out</button>
</Section>

@code {

    private string? _email;
    private StorageEstimate? _estimate;

    private const string TextUnknown = "Unknown";

    private string EmailText => _email ?? TextUnknown;
    private string UsedText => _estimate is null ? TextUnknown : Format(_estimate.UsedBytes);
    private string FreeText => _estimate is null ? TextUnknown : Format(_estimate.FreeBytes);

    protected override async Task OnInitializedAsync()
    {
        string? token = await ServiceSession.GetAccessToken();
        _email = token?.GetAccessTokenEmail();

        try
        {
            _estimate = await StoreFile.GetEstimate();
        }
        catch (IOException)
        {
            _estimate = null;
        }
    }

    private static string Format(long bytes)
    {
        string[] unitList = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < unitList.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {unitList[unit]}";
    }

}
