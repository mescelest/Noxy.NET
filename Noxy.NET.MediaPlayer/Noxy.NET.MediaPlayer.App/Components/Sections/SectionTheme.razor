@inherits BaseComponentElement

<Section @attributes="AdditionalAttributes" class="@CssClass" Title="Theme">
    <ThemeToggle TType="ThemeEnum" Label="Theme">
        <Template Context="theme">
            <Button Type="@HTMLButtonTypeEnum.Button" Status="StatusOf(theme.Service.GetTheme() == theme.Value)" @onclick="() => theme.Service.SetTheme(theme.Value)">@theme.Value</Button>
        </Template>
    </ThemeToggle>
</Section>

@code {

    // The theme in force is the highlighted one.
    private static StatusEnum StatusOf(bool isOn)
    {
        return isOn ? StatusEnum.Highlight : StatusEnum.None;
    }

}
