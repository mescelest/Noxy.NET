@inject IJSRuntime JS
@inherits BaseComponentElement
@using Noxy.NET.UI.Extensions
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes" class="@CssClass" role="grid" aria-label="@AppTexts.QueueTitle">
    <div class="scroller" @ref="_scroller">
        <div class="header-row" role="row">
            <div class="cell" role="columnheader">
                <InputControlCheckbox Option="true" aria-label="@AppTexts.SelectAll" @bind-Value:get="@AllSelected" @bind-Value:set="ChangeAllHandler"/>
            </div>
            <div class="cell" role="columnheader"></div>
            <div class="cell" role="columnheader"><strong>@AppTexts.QueueColumnTitle</strong></div>
            <div class="cell" role="columnheader"><strong>@AppTexts.QueueColumnArtist</strong></div>
            <div class="cell" role="columnheader"><strong>@AppTexts.QueueColumnAlbum</strong></div>
            <div class="cell" role="columnheader"><strong>@AppTexts.QueueColumnDuration</strong></div>
        </div>

        <Virtualize Items="Model.RowList" ItemSize="RowSize" Context="row">
            @if (!row.Kind.IsItem)
            {
                <div @key="row.Kind" class="divider" data-row role="presentation">@DividerText(row)</div>
            }
            else
            {
                <div @key="ItemIDOf(row)" class="row" data-row role="row" data-current="@IsCurrent(row)" data-striped="@IsStriped(row)" data-selected="@IsSelected(row)" data-over="@IsOver(row)" draggable="@DraggableValue(row)"
                     @ondblclick="() => JumpHandler(row)" @oncontextmenu="args => ContextMenuHandler(args, row)" @oncontextmenu:preventDefault
                     @ondragstart="() => DragStartHandler(row)" @ondragover="() => DragOverHandler(row)" @ondragover:preventDefault @ondrop="() => DropHandler(row)" @ondrop:preventDefault @ondragend="DragEndHandler">
                    <div class="cell">
                        <InputControlCheckbox Option="true" aria-label="@SelectLabel(row)" @bind-Value:get="@IsSelected(row)" @bind-Value:set="_ => ToggleHandler(row)"/>
                    </div>
                    <div class="cell">
                        <FileStatusIcon State="StateOf(ItemOf(row))"/>
                    </div>
                    <div class="cell text">
                        <AlbumArt class="art" AlbumID="AlbumIDOf(row)"/>@TitleOf(row)</div>
                    <div class="cell text">@MediaOf(MediaFileIDOf(row))?.Artist</div>
                    <div class="cell text">@MediaOf(MediaFileIDOf(row))?.Album</div>
                    <div class="cell">@DurationOf(row)</div>
                </div>
            }
        </Virtualize>
    </div>

    @if (IsAway)
    {
        <Button Type="@HTMLButtonTypeEnum.Button" class="back" Appearance="ButtonAppearanceEnum.Outline" Status="StatusEnum.None" @onclick="ClickBackHandler">@AppTexts.QueueBackToPlaying</Button>
    }
</div>

@code {

    [Parameter, EditorRequired]
    public required QueueListModel Model { get; set; }

    // The item IDs of the ticked rows.
    [Parameter]
    public IReadOnlySet<Guid> SelectedSet { get; set; } = new HashSet<Guid>();

    [Parameter]
    public bool AllSelected { get; set; }

    [Parameter, EditorRequired]
    public required Func<Guid, ResponseMediaFile?> MediaOf { get; set; }

    [Parameter, EditorRequired]
    public required Func<QueueItem, FileSyncStateEnum> StateOf { get; set; }

    [Parameter]
    public EventCallback OnToggleAll { get; set; }

    [Parameter]
    public EventCallback<Guid> OnToggleRow { get; set; }

    // A double-click on a row: the item to jump to.
    [Parameter]
    public EventCallback<Guid> OnJump { get; set; }

    [Parameter]
    public EventCallback<(MouseEventArgs Args, QueueListRow Row)> OnContextMenu { get; set; }

    // The dragged item's ID, then the ID of the item it was dropped on.
    [Parameter]
    public EventCallback<(Guid DragKey, Guid TargetKey)> OnMove { get; set; }

    // The estimate of one row for the virtual list, in pixels; the rows are one --size-library-row high (3rem).
    private const float RowSize = 48;

    // The rows above the current one when the list scrolls to it: its heading and the song played before it.
    private const int RowsAboveCurrent = 2;

    private const string FunctionScrollToIndex = "ScrollToIndex";
    private const string FunctionSetCurrent = "SetCurrent";
    private const string FunctionWatch = "Watch";
    private const string FunctionUnwatch = "Unwatch";

    private ElementReference _scroller;
    private IJSObjectReference? _module;
    private DotNetObjectReference<QueueList>? _reference;
    private Guid? _followedID;
    private int _sentIndex = -1;
    private Guid? _dragKey;
    private Guid? _overKey;
    private bool _isAway;
    private bool _disposed;

    // The items that take the stripe: every second one, counted over the items alone so a heading does not shift the pattern, and the first is plain like in the library.
    private HashSet<Guid> _stripedSet = [];

    private bool IsAway => _isAway && Model.CurrentIndex >= 0;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        HashSet<Guid> stripedSet = [];
        int count = 0;
        foreach (QueueListRow row in Model.RowList)
        {
            if (row.Item is null) continue;

            if (count % 2 == 1) stripedSet.Add(row.Item.ItemID);
            count++;
        }

        _stripedSet = stripedSet;
    }

    private Guid? CurrentItemID => Model.CurrentIndex >= 0 ? Model.RowList[Model.CurrentIndex].Item?.ItemID : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_disposed) return;

        if (firstRender)
        {
            IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(QueueList), local: true));

            // The component can be disposed while the module loads: then nobody else releases it.
            if (_disposed)
            {
                await ReleaseModuleAsync(module);
                return;
            }

            _module = module;
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync(FunctionWatch, _scroller, _reference, nameof(UserScrolled));
        }

        await FollowCurrentAsync();
    }

    // The list goes to the song that is playing when it opens and when the song changes, unless the user has scrolled away from it.
    private async Task FollowCurrentAsync()
    {
        if (_module is null) return;

        if (Model.CurrentIndex != _sentIndex)
        {
            _sentIndex = Model.CurrentIndex;
            await _module.InvokeVoidAsync(FunctionSetCurrent, _scroller, _sentIndex);
        }

        Guid? currentID = CurrentItemID;
        if (currentID == _followedID) return;

        _followedID = currentID;
        if (currentID is null || _isAway) return;

        await ScrollToCurrentAsync();
    }

    private async Task ScrollToCurrentAsync()
    {
        if (_module is null || Model.CurrentIndex < 0) return;

        await _module.InvokeVoidAsync(FunctionScrollToIndex, _scroller, Model.CurrentIndex, RowsAboveCurrent);
    }

    // The script says so when the user's scrolling takes the current song out of view or brings it back.
    [JSInvokable]
    public async Task UserScrolled(bool isAway)
    {
        if (_disposed) return;

        _isAway = isAway;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClickBackHandler()
    {
        _isAway = false;
        await ScrollToCurrentAsync();
    }

    private string DividerText(QueueListRow row)
    {
        switch (row.Kind)
        {
            case QueueRowKindEnum.DividerCurrent:
                return AppTexts.QueueDividerCurrent;
            case QueueRowKindEnum.DividerUserQueue:
                return AppTexts.QueueDividerUserQueue;
            case QueueRowKindEnum.DividerSource:
                return string.Format(AppTexts.QueueDividerSource, row.SourceName ?? AppTexts.QueueSourceLibrary);
            case QueueRowKindEnum.History:
            case QueueRowKindEnum.Current:
            case QueueRowKindEnum.UserQueue:
            case QueueRowKindEnum.Source:
                throw new InvalidOperationException("A song row has no heading text.");
            default:
                throw new InvalidEnumArgumentException(nameof(row), (int)row.Kind, typeof(QueueRowKindEnum));
        }
    }

    private static QueueItem ItemOf(QueueListRow row) => row.Item ?? throw new InvalidOperationException("A heading row has no queue item.");

    private static Guid ItemIDOf(QueueListRow row) => ItemOf(row).ItemID;

    private static Guid MediaFileIDOf(QueueListRow row) => ItemOf(row).MediaFileID;

    private static bool IsCurrent(QueueListRow row) => row.Kind == QueueRowKindEnum.Current;

    private bool IsSelected(QueueListRow row) => SelectedSet.Contains(ItemIDOf(row));

    private bool IsStriped(QueueListRow row) => _stripedSet.Contains(ItemIDOf(row));

    private bool IsOver(QueueListRow row) => _overKey == ItemIDOf(row);

    private string DraggableValue(QueueListRow row) => row.Kind.IsUpcoming.ToString().ToLowerInvariant();

    private string TitleOf(QueueListRow row) => MediaOf(MediaFileIDOf(row))?.Title ?? AppTexts.QueueUnknownMedia;

    private Guid? AlbumIDOf(QueueListRow row) => MediaOf(MediaFileIDOf(row))?.AlbumID;

    private string SelectLabel(QueueListRow row) => string.Format(AppTexts.SelectRow, TitleOf(row));

    private string DurationOf(QueueListRow row)
    {
        TimeSpan? duration = MediaOf(MediaFileIDOf(row))?.Duration;

        return duration is { } time ? $"{(int)time.TotalMinutes}:{time.Seconds:00}" : string.Empty;
    }

    // The host toggles: the new value of the box is already what its state will say once it has changed.
    private Task ChangeAllHandler(bool selected) => OnToggleAll.InvokeAsync();

    private Task ToggleHandler(QueueListRow row) => OnToggleRow.InvokeAsync(ItemIDOf(row));

    private Task JumpHandler(QueueListRow row) => OnJump.InvokeAsync(ItemIDOf(row));

    private Task ContextMenuHandler(MouseEventArgs args, QueueListRow row) => OnContextMenu.InvokeAsync((args, row));

    private void DragStartHandler(QueueListRow row)
    {
        if (!row.Kind.IsUpcoming) return;

        _dragKey = ItemIDOf(row);
    }

    private void DragOverHandler(QueueListRow row)
    {
        if (_dragKey is null) return;

        _overKey = ItemIDOf(row);
    }

    private async Task DropHandler(QueueListRow target)
    {
        Guid? dragged = _dragKey;
        _dragKey = null;
        _overKey = null;
        if (dragged is null || dragged == ItemIDOf(target)) return;

        await OnMove.InvokeAsync((dragged.Value, ItemIDOf(target)));
    }

    // A drag that ended anywhere but on a row leaves nothing marked.
    private void DragEndHandler()
    {
        _dragKey = null;
        _overKey = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync(FunctionUnwatch, _scroller);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }

            await ReleaseModuleAsync(_module);
        }

        _reference?.Dispose();
    }

    private static async Task ReleaseModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

}
