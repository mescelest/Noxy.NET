@inject IPlaylistService ServicePlaylist
@inject IToastService ServiceToast
@inject NavigationManager Navigation
@inherits BaseComponentElement

<div @attributes="AdditionalAttributes" class="@CssClass">
    <ContextMenu @ref="_menu" ID="@MenuID(Playlist.ID, Place)" ItemList="ItemList"/>

    <EditPlaylistDialog @bind-Open="_editing" PlaylistID="Playlist.ID"/>
</div>

@code {

    [Parameter, EditorRequired]
    public required ResponsePlaylist Playlist { get; set; }

    // Where the menu sits on the screen. The same playlist has a menu in the sidebar and one on its page, and an element ID may appear only once, or a trigger would open the first of them.
    [Parameter, EditorRequired]
    public required string Place { get; set; }

    public const string PlaceSidebar = "sidebar";
    public const string PlacePage = "page";

    private const string MenuIDPrefix = "playlist-menu-";

    private ContextMenu? _menu;
    private bool _editing;

    // The playlist's "⋯" button puts this in its popovertarget attribute.
    public static string MenuID(Guid playlistID, string place) => $"{MenuIDPrefix}{place}-{playlistID:N}";

    private List<ContextMenuItem> ItemList =>
    [
            ContextMenuItem.Item(AppTexts.PlaylistPlay, () => Run(() => ServicePlaylist.Play(Playlist.ID)), icon: "play_arrow"),
            ContextMenuItem.Item(AppTexts.PlaylistDownloadAll, () => Run(() => ServicePlaylist.DownloadAll(Playlist.ID)), icon: "download"),
            ContextMenuItem.Item(AppTexts.PlaylistEdit, Edit, icon: "edit"),
            ContextMenuItem.Item(AppTexts.PlaylistRefresh, () => Run(() => ServicePlaylist.Refresh(Playlist.ID)), icon: "refresh"),
            ContextMenuItem.Separator(),
            ContextMenuItem.Item(AppTexts.PlaylistDelete, Delete, isDestructive: true, icon: "delete", confirmText: AppTexts.ConfirmActionAgain)
    ];

    public async Task OpenAtAsync(MouseEventArgs args)
    {
        if (_menu is null) return;

        await _menu.OpenAtAsync(args);
    }

    // The click is the menu's own event, so only the menu is drawn again after it; this component holds the dialog and has to ask for it.
    private async Task Edit()
    {
        _editing = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Delete()
    {
        bool isOnScreen = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') == $"playlist/{Playlist.ID}";
        if (!await Run(() => ServicePlaylist.Delete(Playlist.ID))) return;

        if (isOnScreen)
        {
            Navigation.NavigateTo(string.Empty);
        }
    }

    private async Task<bool> Run(Func<Task> action)
    {
        try
        {
            await action();
            return true;
        }
        catch (Exception exception)
        {
            ServiceToast.ShowError(exception.ToActionMessage());
            return false;
        }
    }

}
