@inject IState<FeatureLibraryState> StateLibrary
@inject IState<FeaturePlaylistListState> StatePlaylistList
@inject IDispatcher Dispatcher
@inject ILibraryActionService ServiceLibraryAction
@inherits FluxorElementComponent

<div @attributes="AdditionalAttributes" class="@CssClass">
    <button type="button" class="trigger" disabled="@(Library.SelectedCount == 0)" aria-label="Actions" aria-haspopup="menu" aria-expanded="@_open" @onclick="() => _open = !_open">
        <MaterialIcon Icon="more_horiz" Size="var(--size-icon-md)"/>
    </button>

    @if (_open)
    {
        <div class="backdrop" @onclick="() => _open = false"></div>
        <ul class="menu" role="menu">
            @foreach (MenuItem item in ItemList)
            {
                string? reason = ServiceLibraryAction.GetDisabledReason(item.Action) ?? item.UnavailableReason;
                <li>
                    <button type="button" role="menuitem" class="item" data-destructive="@item.IsDestructive" disabled="@(reason is not null)" title="@reason" @onclick="() => Choose(item)">
                        @item.Label
                        @if (reason is not null)
                        {
                            <span class="reason">@reason</span>
                        }
                    </button>
                </li>
            }
        </ul>
    }

    <ConfirmActionDialog Open="@(_confirm is not null)" OpenChanged="CloseConfirm" Title="@_confirm?.Title" Message="@_confirm?.Message" Detail="@_confirm?.Detail" AcceptText="@_confirm?.AcceptText" OnSubmit="SubmitConfirm"/>

    <Dialog @bind-Open="_choosingPlaylist">
        <h2>Add to playlist</h2>
        @if (StatePlaylistList.Value.PlaylistList.Count == 0)
        {
            <p>You have no playlists yet.</p>
        }
        @foreach (ResponsePlaylist playlist in StatePlaylistList.Value.PlaylistList)
        {
            Guid playlistID = playlist.ID;
            <button type="button" class="playlist-choice" @onclick="() => AddToPlaylist(playlistID)">@playlist.Name</button>
        }
        <div class="actions">
            <button type="button" class="cancel" @onclick="() => _choosingPlaylist = false">Cancel</button>
        </div>
    </Dialog>

    <MessageBox MessageList="_messageList" Status="StatusEnum.Warning"/>
</div>

@code {

    private sealed record MenuItem(LibraryActionEnum Action, string Label, Func<Task> Run, bool IsDestructive = false, string? UnavailableReason = null);

    private sealed record ConfirmRequest(string Title, string Message, string? Detail, string AcceptText, Func<Task> Run);

    private List<string> _messageList = [];
    private bool _open;
    private ConfirmRequest? _confirm;
    private bool _choosingPlaylist;

    private FeatureLibraryState Library => StateLibrary.Value;

    // The menu in its order: one more entry is one more item.
    private List<MenuItem> ItemList =>
    [
        new(LibraryActionEnum.Download, "Download to this device", Download),
        new(LibraryActionEnum.PlayNext, "Play next", PlayNext),
        new(LibraryActionEnum.AddToQueue, "Add to queue", AddToQueue),
        new(LibraryActionEnum.SaveAsFile, "Save as file", SaveAsFile),
        new(LibraryActionEnum.AddToPlaylist, "Add to playlist", ChoosePlaylist),
        new(LibraryActionEnum.RemoveFromDevice, "Remove from this device", () => Confirm("Remove from this device", $"Remove {Count(Library.SelectedCount)} from this device? They stay in your library.", "Remove", RemoveFromDevice)),
        new(LibraryActionEnum.DeleteFromLibrary, "Delete from library", () => Confirm("Delete from library", $"Delete {Count(Library.SelectedCount)} from your library?", "Delete", DeleteFromLibrary), true)
    ];

    private static string Count(int count) => count == 1 ? "1 media file" : $"{count} media files";

    private List<Guid> SelectedIDList => Library.SelectedIDList;

    private async Task Choose(MenuItem item)
    {
        _open = false;
        await item.Run();
    }

    private Task Download() => Show(ServiceLibraryAction.Download(SelectedIDList));

    private Task PlayNext() => Show(ServiceLibraryAction.PlayNext(SelectedIDList));

    private Task AddToQueue() => Show(ServiceLibraryAction.AddToQueue(SelectedIDList));

    private Task SaveAsFile() => Show(ServiceLibraryAction.SaveAsFile(SelectedIDList));

    private Task RemoveFromDevice() => Show(ServiceLibraryAction.RemoveFromDevice(SelectedIDList));

    private async Task DeleteFromLibrary()
    {
        await Show(ServiceLibraryAction.DeleteFromLibrary(SelectedIDList));
        Dispatcher.Dispatch(new ActionLibrarySelectionCleared());
    }

    private async Task Show(Task<BulkResult> action)
    {
        BulkResult result;
        try
        {
            result = await action;
        }
        catch (Exception exception)
        {
            _messageList = [exception.ToActionMessage()];
            return;
        }

        _messageList = result.FailedIDList.Count == 0 ? [] : [$"{result.FailedIDList.Count} failed. {result.Message}".Trim()];
    }

    // Asks first with the real count, and says how many of the ticked rows the search hides.
    private Task Confirm(string title, string message, string acceptText, Func<Task> run)
    {
        string? detail = Library.HiddenSelectedCount > 0 ? $"{Library.HiddenSelectedCount} of them {(Library.HiddenSelectedCount == 1 ? "is" : "are")} hidden by the current search." : null;
        _confirm = new ConfirmRequest(title, message, detail, acceptText, run);

        return Task.CompletedTask;
    }

    private Task CloseConfirm(bool open)
    {
        if (!open) _confirm = null;

        return Task.CompletedTask;
    }

    private async Task SubmitConfirm(bool accepted)
    {
        ConfirmRequest? request = _confirm;
        _confirm = null;
        if (accepted && request is not null) await request.Run();
    }

    private Task ChoosePlaylist()
    {
        _choosingPlaylist = true;

        return Task.CompletedTask;
    }

    private Task AddToPlaylist(Guid playlistID)
    {
        _choosingPlaylist = false;

        return Show(ServiceLibraryAction.AddToPlaylist(playlistID, SelectedIDList));
    }

}
