@inject IJSRuntime JS
@using Noxy.NET.UI.Extensions
@implements IAsyncDisposable

@code {

    [Parameter]
    public EventCallback<bool> OnChanged { get; set; }

    private const string FunctionIsNarrow = "IsNarrow";
    private const string FunctionWatchNarrow = "WatchNarrow";
    private const string FunctionDispose = "dispose";

    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;
    private DotNetObjectReference<NarrowWatcher>? _reference;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender || _disposed) return;

        try
        {
            IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", JS.GetComponentPath(typeof(NarrowWatcher), local: true));
            if (_disposed)
            {
                // Disposed while the module loaded: nobody else will release it.
                await ReleaseAsync(module);
                return;
            }

            _module = module;
            _reference = DotNetObjectReference.Create(this);
            _watch = await _module.InvokeAsync<IJSObjectReference>(FunctionWatchNarrow, _reference, nameof(Changed));
            if (_disposed) return;

            await OnChanged.InvokeAsync(await _module.InvokeAsync<bool>(FunctionIsNarrow));
        }
        catch (JSDisconnectedException)
        {
            // The window is closing.
        }
        catch (ObjectDisposedException)
        {
            // Disposed between two calls.
        }
    }

    [JSInvokable]
    public Task Changed(bool narrow)
    {
        if (_disposed) return Task.CompletedTask;

        return InvokeAsync(() => OnChanged.InvokeAsync(narrow));
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        _disposed = true;

        // The script stops listening first, so nothing calls into the reference once it is released.
        if (_watch is not null)
        {
            await StopAsync(_watch);
            await ReleaseAsync(_watch);
        }

        if (_module is not null) await ReleaseAsync(_module);

        _reference?.Dispose();
    }

    private static async Task StopAsync(IJSObjectReference watch)
    {
        try
        {
            await watch.InvokeVoidAsync(FunctionDispose);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (ObjectDisposedException) { }
        catch (TaskCanceledException) { }
    }

    private static async Task ReleaseAsync(IJSObjectReference reference)
    {
        try
        {
            await reference.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (ObjectDisposedException) { }
        catch (TaskCanceledException) { }
    }

}
