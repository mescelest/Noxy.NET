{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Data Source=..\\..\\Data\\Noxy.NET.MediaPlayer.sqlite"
  },
  "Authentication": {
    "Issuer": "Noxy.NET.MediaPlayer",
    "Audience": "Noxy.NET.MediaPlayer",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Google": {
    "ClientId": ""
  },
  "Storage": {
    "RootPath": "..\\..\\Data\\Media",
    "MaxSizeBytes": 104857600,
    "MaxFilesPerUser": 5000,
    "MaxBytesPerUser": 0,
    "AllowedExtensions": [
      "mp3",
      "flac",
      "m4a",
      "ogg",
      "opus",
      "wav"
    ]
  },
  "Upload": {
    "MaxPendingPerUser": 100,
    "PollSeconds": 30
  },
  "Cleanup": {
    "IntervalHours": 24,
    "RetentionDays": 7
  },
  "RateLimiting": {
    "Upload": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "CORS": {
    "Origins": [
      "http://localhost:5343",
      "https://localhost:7343"
    ]
  }
}
