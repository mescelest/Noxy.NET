{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Data Source=..\\..\\Data\\Noxy.NET.MediaPlayer.sqlite"
  },
  "Authentication": {
    "Issuer": "Noxy.NET.MediaPlayer",
    "Audience": "Noxy.NET.MediaPlayer",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Google": {
    "ClientId": ""
  },
  "Cleanup": {
    "IntervalHours": 24,
    "RetentionDays": 7
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "CORS": {
    "Origins": [
      "http://localhost:5343",
      "https://localhost:7343"
    ]
  }
}
