{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Data Source=..\\..\\Data\\Noxy.NET.MediaPlayer.sqlite"
  },
  "Authentication": {
    "Issuer": "Noxy.NET.MediaPlayer",
    "Audience": "Noxy.NET.MediaPlayer",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Google": {
    "ClientIdList": [
      "183545471248-p7bqsimcu1b8sgmgjt2hd1rncqrgec6g.apps.googleusercontent.com"
    ]
  },
  "Storage": {
    "RootPath": "..\\..\\Data\\Media",
    "LibraryFolderName": "library",
    "StagingFolderName": "staging",
    "TemporaryFolderName": "temporary",
    "AlbumArtFolderName": "albumart",
    "MaxSizeBytes": 104857600,
    "MaxFilesPerUser": 5000,
    "MaxBytesPerUser": 0,
    "AllowedExtensionList": [
      "mp3",
      "flac",
      "m4a",
      "ogg",
      "opus",
      "wav"
    ]
  },
  "Upload": {
    "MaxPendingPerUser": 100,
    "PollSeconds": 30
  },
  "Playlist": {
    "MaxPlaylistsPerUser": 100,
    "MaxEntriesPerPlaylist": 1000
  },
  "Art": {
    "ThumbnailMaxPixels": 300
  },
  "Remote": {
    "ActiveGraceSeconds": 10,
    "TransferTimeoutSeconds": 5,
    "IdleTeardownMinutes": 10,
    "MaxDeviceCount": 10,
    "MaxDeviceNameLength": 50,
    "HistoryLimit": 50,
    "MaxQueueLength": 20000,
    "MaxHubMessageBytes": 4194304
  },
  "Playback": {
    "PlayedWindowSeconds": 10
  },
  "Cleanup": {
    "IntervalHours": 24,
    "RetentionDays": 7
  },
  "RateLimiting": {
    "Upload": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Download": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "CORS": {
    "OriginList": [
      "http://localhost:5343",
      "https://localhost:7343"
    ]
  }
}
